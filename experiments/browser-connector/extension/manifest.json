{
  "manifest_version": 3,
  "name": "Lamp",
  "version": "0.0.4",
  "description": "Show Lamp a task in Chrome, and let the apps Lamp makes read pages you choose.",
  "key": "",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms",
    "activeTab"
  ],
  "action": {
    "default_title": "Lamp",
    "default_popup": "recorder.html",
    "default_icon": {
      "16": "icons/lamp-16.png",
      "32": "icons/lamp-32.png",
      "48": "icons/lamp-48.png",
      "128": "icons/lamp-128.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "16": "icons/lamp-16.png",
    "32": "icons/lamp-32.png",
    "48": "icons/lamp-48.png",
    "128": "icons/lamp-128.png"
  }
}

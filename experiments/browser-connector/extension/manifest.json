{
  "manifest_version": 3,
  "name": "Lamp",
  "version": "0.1.0",
  "description": "Use your Lamp apps beside the page you're on.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "action": {
    "default_title": "Lamp",
    "default_icon": {
      "16": "icons/lamp-16.png",
      "32": "icons/lamp-32.png",
      "48": "icons/lamp-48.png",
      "128": "icons/lamp-128.png"
    }
  },
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "16": "icons/lamp-16.png",
    "32": "icons/lamp-32.png",
    "48": "icons/lamp-48.png",
    "128": "icons/lamp-128.png"
  }
}

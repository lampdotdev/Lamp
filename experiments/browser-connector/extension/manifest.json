{
  "manifest_version": 3,
  "name": "Lamp Page Connector",
  "version": "0.0.3",
  "description": "Throwaway read-only page handoff to Lamp-made apps.",
  "key": "",
  "permissions": [
    "scripting",
    "nativeMessaging",
    "storage",
    "alarms",
    "activeTab"
  ],
  "action": {
    "default_title": "Lamp Page Connector"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}

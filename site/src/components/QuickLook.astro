<!--
  A larger look at any picture marked data-quicklook="<full-size url>", in the manner of the Mac's Quick Look:
  the picture grows out of where it sat, over a dimmed and blurred page, and shrinks back when it's closed
  (a click anywhere, Esc or Space). It starts from the picture already on screen and swaps in the full-size
  one once that has loaded. One of these on the page serves every picture.
-->
<dialog
  data-quicklook-panel
  aria-label="Larger picture"
  class="fixed inset-0 m-0 h-dvh max-h-none w-dvw max-w-none cursor-zoom-out bg-transparent p-0 opacity-100 backdrop:bg-transparent"
>
  <div
    data-veil
    class="absolute inset-0 bg-black/0 transition-[background-color,backdrop-filter] duration-300 data-open:bg-black/55 data-open:backdrop-blur-md"
  ></div>
  <img
    data-picture
    alt=""
    style="transform: translate(-50%, -50%)"
    class="absolute top-1/2 left-1/2 max-h-[98dvh] max-w-[98vw] object-contain will-change-transform"
  />
  <button
    type="button"
    data-close
    aria-label="Close"
    class="absolute top-4 left-4 grid size-9 place-items-center rounded-full bg-white/15 text-white ring-1 ring-white/20 backdrop-blur-md transition hover:bg-white/25 focus-visible:outline-2 focus-visible:outline-white"
  >
    <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5 fill-none stroke-current stroke-2 [stroke-linecap:round]">
      <path d="M4 4l8 8M12 4l-8 8" />
    </svg>
  </button>
</dialog>

<script>
  const panel = document.querySelector<HTMLDialogElement>("[data-quicklook-panel]")!;
  const veil = panel.querySelector<HTMLElement>("[data-veil]")!;
  const picture = panel.querySelector<HTMLImageElement>("[data-picture]")!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const spring = "cubic-bezier(.2,.9,.3,1.04)";
  let source: HTMLImageElement | null = null;
  let closing = false;

  // The transform that puts the large picture exactly over the small one, so it can grow out of it.
  const fromSource = (from: HTMLImageElement) => {
    const a = from.getBoundingClientRect();
    const b = picture.getBoundingClientRect();
    const dx = a.left + a.width / 2 - (b.left + b.width / 2);
    const dy = a.top + a.height / 2 - (b.top + b.height / 2);
    return `translate(-50%, -50%) translate(${dx}px, ${dy}px) scale(${a.width / b.width})`;
  };
  const resting = "translate(-50%, -50%)";

  // Plays a move and waits for it, but never longer than it should take: a page in the background holds its
  // animations, and Quick Look mustn't be left stuck open or half-closed because of that.
  const move = (keyframes: Keyframe[], duration: number, easing: string) =>
    Promise.race([
      picture.animate(keyframes, { duration, easing }).finished.catch(() => {}),
      new Promise((done) => setTimeout(done, duration + 60)),
    ]);

  const open = async (from: HTMLImageElement) => {
    source = from;
    // Lets whatever holds the picture know it's being looked at (the carousel stops moving on), however it
    // was opened: a key press doesn't reach the carousel, and focus leaves it for the dialog.
    from.dispatchEvent(new CustomEvent("quicklook", { bubbles: true }));
    picture.src = from.currentSrc || from.src;
    picture.alt = from.alt;
    panel.showModal();
    from.style.visibility = "hidden";
    veil.getBoundingClientRect();   // lay out the clear veil first, so dimming it fades in
    veil.toggleAttribute("data-open", true);
    await picture.decode().catch(() => {});
    if (!still) {
      await move([{ transform: fromSource(from) }, { transform: resting }], 420, spring);
    }
    // The full-size picture comes in once it's ready, without a flash.
    const full = from.dataset.quicklook;
    if (full && picture.src !== full) {
      const sharper = new Image();
      sharper.src = full;
      sharper.decode().then(() => { if (source === from) picture.src = full; }).catch(() => {});
    }
  };

  const close = async () => {
    if (!source || closing) return;
    closing = true;
    veil.toggleAttribute("data-open", false);
    const visible = source.getBoundingClientRect();
    const onScreen = visible.bottom > 0 && visible.top < innerHeight;
    if (!still && onScreen) {
      await move([{ transform: resting }, { transform: fromSource(source) }], 300, "cubic-bezier(.4,0,.2,1)");
    }
    source.style.visibility = "";
    source.focus({ preventScroll: true });
    source = null;
    panel.close();
    closing = false;
  };

  panel.addEventListener("click", close);
  panel.addEventListener("cancel", (event) => { event.preventDefault(); close(); });
  panel.addEventListener("keydown", (event) => {
    if (event.key === " ") { event.preventDefault(); close(); }
  });

  for (const image of document.querySelectorAll<HTMLImageElement>("img[data-quicklook]")) {
    image.tabIndex = 0;
    image.setAttribute("role", "button");
    image.setAttribute("aria-label", `Show larger: ${image.alt}`);
    image.classList.add("cursor-zoom-in");
    image.addEventListener("click", () => open(image));
    image.addEventListener("keydown", (event) => {
      if (event.key !== " " && event.key !== "Enter") return;
      event.preventDefault();
      event.stopPropagation();
      open(image);
    });
  }
</script>

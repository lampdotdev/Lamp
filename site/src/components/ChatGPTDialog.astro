---
import { together } from "../lib/text";
import { SETUP_PROMPT, CODEX_LINK, CHATGPT_APP_URL } from "../lib/chatgpt";
---

<!--
  "Use with ChatGPT": a button, and the card it opens. ChatGPT's Mac app sets up lamp's command line from a prompt
  and makes apps with it, so the card offers three ways in: Open in ChatGPT (a link the app opens with the prompt
  waiting, never sent), Copy the prompt, for ChatGPT or any agent that runs commands on the Mac, and getting
  ChatGPT's app. A page can't tell whether the app is there to open the link, so the card doesn't guess: it says what
  to do in the app and keeps the other two ways beside it. The prompt is also shown, to select by hand where copying
  is refused. Dressed as the remix card is: a plain card on the paper with a thin ink edge.
-->
<button type="button" data-chatgpt-open class="ink-button h-12 px-6 text-base">Use with ChatGPT</button>

<dialog data-chatgpt aria-labelledby="chatgpt-title" class="chatgpt-dialog">
  <div class="chatgpt-face">
    <button type="button" data-close aria-label="Close" class="chatgpt-close">
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" /></svg>
    </button>
    <h2 id="chatgpt-title" class="chatgpt-title">Use Lamp with ChatGPT</h2>
    <p class="chatgpt-line">{together("ChatGPT sets up Lamp's command line on your Mac, then makes and changes apps with you.")}</p>
    <ol class="chatgpt-steps">
      <li>Open ChatGPT's Mac app.</li>
      <li>Choose Codex.</li>
      <li>{together("Send the message waiting there.")}</li>
    </ol>
    <div class="chatgpt-buttons">
      <a href={CODEX_LINK} data-chatgpt-link class="chatgpt-button chatgpt-button-ink">Open in ChatGPT</a>
      <button type="button" data-copy class="chatgpt-button">Copy the prompt</button>
    </div>
    <p data-status class="chatgpt-status" role="status" aria-live="polite">{together("The prompt works in any agent that can run commands on your Mac.")}</p>
    <label for="chatgpt-prompt" class="chatgpt-label">THE PROMPT</label>
    <textarea id="chatgpt-prompt" data-prompt readonly rows="7" class="chatgpt-prompt">{SETUP_PROMPT}</textarea>
    <a href={CHATGPT_APP_URL} target="_blank" rel="noopener" class="chatgpt-get">Get the ChatGPT app ↗</a>
  </div>
</dialog>

<script>
  const opener = document.querySelector<HTMLButtonElement>("[data-chatgpt-open]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-chatgpt]");
  if (opener && dialog) {
    const status = dialog.querySelector<HTMLElement>("[data-status]")!;
    const prompt = dialog.querySelector<HTMLTextAreaElement>("[data-prompt]")!;
    const usual = status.textContent;
    // The dialog gives focus back to the button when it closes, Escape included.
    opener.addEventListener("click", () => { status.textContent = usual; dialog.showModal(); });
    dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
    dialog.querySelector("[data-copy]")!.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(prompt.value);
        status.textContent = "Copied. Paste it into ChatGPT's Codex, or your agent.";
      } catch {
        // Copying can be refused (no permission, an older browser): the prompt is selected to copy by hand.
        prompt.focus();
        prompt.select();
        status.textContent = "Couldn't copy it. It's selected below: copy it from there.";
      }
    });
  }
</script>

<style>
  .chatgpt-dialog {
    margin: auto; padding: 0; width: min(34rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); overflow: visible;
    background: transparent; border: 0; color: var(--color-tape); font-family: var(--font-sans);
  }
  .chatgpt-dialog::backdrop { background: rgb(27 26 23 / 0.55); }
  .chatgpt-dialog[open]::backdrop { animation: chatgpt-dim 0.3s ease both; }
  .chatgpt-dialog[open] .chatgpt-face { animation: chatgpt-rise 0.35s cubic-bezier(0.2, 0.9, 0.25, 1) both; }
  @keyframes chatgpt-rise { from { translate: 0 16px; opacity: 0; } }
  @keyframes chatgpt-dim { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .chatgpt-dialog[open] .chatgpt-face, .chatgpt-dialog[open]::backdrop { animation: none; }
  }
  .chatgpt-face {
    position: relative; max-height: calc(100dvh - 2rem); overflow-y: auto; padding: 2rem; border-radius: 10px;
    background: var(--color-paper); box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-tape) 30%, transparent), 0 30px 70px -20px rgb(0 0 0 / 0.5);
  }
  .chatgpt-close {
    position: absolute; top: 1rem; right: 1rem; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border-radius: 50%; background: var(--color-paper); color: var(--color-tape); cursor: pointer;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-tape) 25%, transparent);
  }
  .chatgpt-close:focus-visible { outline: 2px solid var(--color-tape); outline-offset: 2px; }
  .chatgpt-close svg { width: 0.875rem; height: 0.875rem; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; }
  .chatgpt-title { margin: 0 2.5rem 0 0; font-size: 1.75rem; line-height: 1.1; font-weight: 900; letter-spacing: -0.03em; }
  .chatgpt-line { margin: 0.75rem 0 0; font-size: 1.0625rem; line-height: 1.45; }
  .chatgpt-steps { margin: 1rem 0 0; padding-left: 1.25rem; list-style: decimal; font-size: 1.0625rem; line-height: 1.6; }
  .chatgpt-buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .chatgpt-button {
    display: inline-flex; align-items: center; min-height: 3rem; padding: 0 1.375rem; border-radius: 6px;
    font-size: 1.0625rem; font-weight: 700; cursor: pointer; background: transparent; color: var(--color-tape);
    box-shadow: inset 0 0 0 1px var(--color-tape);
  }
  .chatgpt-button:hover { opacity: 0.88; }
  .chatgpt-button:focus-visible { outline: 2px solid var(--color-tape); outline-offset: 3px; }
  .chatgpt-button-ink { background: var(--color-tape); color: var(--color-paper); }
  .chatgpt-status { margin: 0.875rem 0 0; font-size: 0.875rem; color: var(--color-muted-ink); }
  .chatgpt-label { display: block; margin-top: 1.25rem; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; color: var(--color-muted-ink); }
  .chatgpt-prompt {
    display: block; width: 100%; margin-top: 0.375rem; padding: 0.75rem; border-radius: 6px; resize: vertical;
    font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.5; color: var(--color-tape); background: transparent;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-tape) 30%, transparent);
  }
  .chatgpt-prompt:focus-visible { outline: 2px solid var(--color-tape); outline-offset: 2px; }
  .chatgpt-get { display: inline-block; margin-top: 1rem; font-family: var(--font-mono); font-size: 0.875rem; text-decoration: underline; text-underline-offset: 4px; }
</style>

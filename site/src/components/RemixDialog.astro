---
import { getImage } from "astro:assets";
import { together } from "../lib/text";
import { DOWNLOAD_URL } from "../lib/download";
import { STARTERS } from "../lib/starters";

// The starters the dialog can show, each with its picture, so a remix of one shows what it starts from.
const pictures = import.meta.glob<ImageMetadata>("../assets/starters/*.png", { eager: true, import: "default" });
const known = Object.fromEntries(await Promise.all(STARTERS.map(async (starter) => {
  const picture = pictures[`../assets/starters/${starter.id}.png`];
  const shot = picture ? (await getImage({ src: picture, width: 720, format: "webp" })).src : "";
  return [starter.id, { name: starter.name, by: starter.by, about: starter.about, page: starter.page, shot }];
})));
---

<!--
  A remix brought by a link from a published page's Remix panel, or from the panel beside an app on a Mac without Lamp
  (`RemixLink` in Lamp): `?ask=` with the request, and, when the page names what it's a copy of, `starter=` or
  `repo=` and `commit=` (lib/wish.js), and `from=` where it was pressed. It shows what the remix starts from (a starter's
  picture, a repository's own picture or else its name) and the
  request in a box to change, then Open in Lamp on a Mac (a link Lamp opens on a fresh copy with the request waiting in
  its chat) and Download for Mac, which copies the request with Lamp's mark, naming the starter or repository, for
  Lamp's first open. A starter's Try it opens the same dialog for trying a starter (`lamp:try`): no request to write, and
  the same two ways to Lamp, whose first open offers the starter. The ideas page keeps its own card (WishDialog.astro); this one is dressed as the homepage is: a plain card on
  the paper with a thin ink edge, the picture on the dark beside the words, rising a little into place when it opens.
-->
<dialog data-remix aria-labelledby="remix-title" aria-describedby="remix-from" class="remix-dialog" data-starters={JSON.stringify(known)}>
  <div class="remix-face">
  <button type="button" data-close aria-label="Close" class="remix-close">
    <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" /></svg>
  </button>
  <div class="remix-body">
    <!-- What it starts from, on the dark: the starter's picture and what it is, or, for a repository or a wish alone,
         a blank label with its name written on it. -->
    <figure data-label class="remix-label">
      <img data-shot alt="" hidden />
      <p data-written class="remix-written" hidden></p>
      <figcaption data-about class="remix-about" hidden></figcaption>
    </figure>
    <div class="remix-words">
      <p data-by class="remix-by"></p>
      <h2 id="remix-title" data-title class="remix-title"></h2>
      <p id="remix-from" data-from class="remix-from"></p>
      <label for="remix-text" data-ask class="remix-ask">YOUR CHANGE (OPTIONAL)</label>
      <textarea id="remix-text" data-text rows="3" placeholder="Say what you'd change"></textarea>
      <div class="remix-buttons">
        <button type="button" data-open hidden class="remix-button remix-button-ink">Open in Lamp</button>
        <a href={DOWNLOAD_URL} data-download-place="remix" data-download class="remix-button remix-button-lit">Download for Mac</a>
      </div>
      <a data-play hidden target="_blank" rel="noopener" class="remix-play">Or play it in your browser ↗</a>
      <p data-status class="remix-status" role="status" aria-live="polite">{together("For Macs with Apple Silicon and macOS 14 Sonoma or later")}</p>
    </div>
  </div>
  </div>
</dialog>

<script>
  import { askFrom, copyWish, remixFrom, remixLink, repoPictures, wishLink } from "../../lib/wish.js";
  import { track } from "../lib/analytics";

  type Known = Record<string, { name: string; by: string; about: string; page?: string; shot: string }>;
  const dialog = document.querySelector<HTMLDialogElement>("[data-remix]")!;
  const starters = JSON.parse(dialog.dataset.starters ?? "{}") as Known;
  const q = <T extends HTMLElement>(selector: string) => dialog.querySelector<T>(selector)!;
  const title = q("[data-title]"), by = q("[data-by]"), from = q("[data-from]"), status = q("[data-status]");
  const shot = q<HTMLImageElement>("[data-shot]"), written = q("[data-written]"), about = q("[data-about]");
  const text = q<HTMLTextAreaElement>("[data-text]"), ask = q("[data-ask]");
  const openLink = q<HTMLButtonElement>("[data-open]"), download = q<HTMLAnchorElement>("[data-download]");
  // The dialog's words as they first are, put back each time it's set up for another remix.
  const first = { status: status.textContent, ask: ask.textContent, download: download.textContent };
  // The query the dialog is set up for, with whether it's to try or to remix, and what undoes that setup's listeners when it's set up for another.
  let shown: string | undefined;
  let setup: AbortController | undefined;

  // Opens the dialog for a link's query (`?ask=`, `starter=`, `repo=`), when it names a request or something to
  // remix: from the page's own address when it arrives, or from the page itself (a starter's Remix it sends
  // `lamp:remix` with the query a link would carry). The same query again reopens it as it was left;
  // another sets it up afresh.
  function present(search: string, trial = false) {
    const key = `${trial ? "try" : "remix"}:${search}`;
    if (setup && key === shown) return dialog.showModal();
    const asked = trial ? null : askFrom(search);
    const named = remixFrom(search);
    // Only a starter this site knows by its id; the request alone otherwise. Lamp checks the link again.
    const starter = named?.starter ? starters[named.starter] : undefined;
    const origin = named?.starter ? (starter ? named : null) : named;
    if (!asked && !origin) return;
    setup?.abort();
    setup = new AbortController();
    const { signal } = setup;
    shown = key;
    const place = trial ? "try" : "remix";
    dialog.toggleAttribute("data-try", trial);
    shot.hidden = written.hidden = about.hidden = true;
    shot.removeAttribute("src");
    delete shot.dataset.fit;
    by.textContent = from.textContent = "";
    ask.textContent = first.ask;
    status.textContent = first.status;
    download.textContent = first.download;
    openLink.textContent = "Open in Lamp";
    dialog.removeAttribute("data-missing");
    dialog.setAttribute("aria-describedby", "remix-from");
    const idea = starter?.name ?? origin?.name ?? "your idea";

    // The app's name and who made it: what it is comes first, whether or not a change goes with it.
    const remixOf = (name: string, maker: string) => {
      const credit = document.createElement("span");
      credit.className = "remix-maker";
      credit.textContent = `by ${maker}`;
      const app = document.createElement("span");
      app.className = "remix-app";
      app.textContent = name;
      title.replaceChildren(app, " ", credit);
    };
    if (starter) {
      remixOf(starter.name, starter.by);
      about.textContent = starter.about;
      about.hidden = false;
      shot.src = starter.shot;
      shot.alt = `${starter.name}, the original`;
      shot.hidden = false;
    } else if (origin?.repo) {
      remixOf(origin.name, origin.owner);
      written.textContent = origin.name;
      written.hidden = false;
      // The repository's own picture when it has one, tried in turn (`repoPictures`); the written label stays until
      // one loads, and for good when none does.
      const pictures = repoPictures(origin);
      const next = () => {
        const picture = pictures.shift();
        if (!picture) return;
        shot.dataset.fit = picture.fit;
        shot.src = picture.src;
      };
      shot.alt = origin.name;
      shot.addEventListener("load", () => { shot.hidden = false; written.hidden = true; }, { signal });
      shot.addEventListener("error", next, { signal });
      next();
    } else {
      title.textContent = "Your idea";
      by.textContent = "From an app made with Lamp";
      from.textContent = "Lamp makes it for you, starting with these words.";
      written.textContent = "your idea here…";
      ask.textContent = "YOUR IDEA";
      written.hidden = false;
    }
    text.value = asked ?? "";
    // A page can't tell whether Lamp is installed, so the Mac that has it gets its own way in, beside Download.
    const onMac = /Mac/.test(navigator.platform) && navigator.maxTouchPoints < 2;
    if (trial && starter) {
      const others = Object.keys(starters).length - 1;
      from.textContent = onMac ? `It opens in Lamp, with ${others} more to try. Nothing to set up.` : "It opens in Lamp, which runs on a Mac.";
      download.hidden = !onMac;
    } else download.hidden = false;
    // It opens as it is: a change, when there is one, waits in Lamp's chat to be sent.
    if (!trial && origin && !from.textContent) from.textContent = "It opens in Lamp as it is. Your change waits in its chat, to send when you're ready.";
    // Where it plays in a browser, playing it needs nothing at all.
    const play = q<HTMLAnchorElement>("[data-play]");
    play.hidden = !starter?.page;
    if (starter?.page) play.href = starter.page;
    // Only a wish alone says where it's from and what Lamp will do with it; a remix's title says it already, and
    // what's left to say when trying one is above.
    by.hidden = !by.textContent;
    from.hidden = !from.textContent;
    if (from.hidden) dialog.removeAttribute("aria-describedby");

    openLink.hidden = !onMac;
    const fit = () => { text.style.height = "auto"; text.style.height = `${text.scrollHeight + 2}px`; };
    text.addEventListener("input", fit, { signal });

    // Closed, the page is the homepage again: a reload doesn't bring the dialog back.
    dialog.addEventListener("close", () => {
      const url = new URL(location.href);
      for (const name of ["ask", "starter", "repo", "commit", "from"]) url.searchParams.delete(name);
      history.replaceState(history.state, "", url);
    }, { signal });
    q("[data-close]").addEventListener("click", () => dialog.close(), { signal });
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); }, { signal });

    // A page can't ask whether Lamp is installed, but it can tell whether Lamp answered: opening it takes the browser's
    // focus away (or hides the page). If nothing has after a moment, Lamp isn't on this Mac, and the dialog turns to
    // getting it, with Download first. Should Lamp open late (a browser asking first, answered slowly), it turns back.
    // On the dev server, `?scheme=` opens another Lamp (a Lamp Dev's, or one that's on no Mac) to try either way.
    const scheme = import.meta.env.DEV ? new URLSearchParams(location.search).get("scheme") : null;
    // Only while an Open is pending, or for a while after it was given up on, does losing focus mean Lamp answered;
    // later, switching away is only switching away.
    let trying: ReturnType<typeof setTimeout> | undefined;
    let late = 0;
    const opened = () => {
      if (!trying && Date.now() > late) return;
      clearTimeout(trying);
      trying = undefined;
      late = 0;
      dialog.removeAttribute("data-missing");
      openLink.textContent = "Open in Lamp";
      status.textContent = trial ? "Opened in Lamp." : "Opened in Lamp. Your change is waiting in its chat.";
    };
    addEventListener("blur", opened, { signal });
    document.addEventListener("visibilitychange", () => { if (document.hidden) opened(); }, { signal });
    addEventListener("pagehide", opened, { signal });
    signal.addEventListener("abort", () => clearTimeout(trying));
    dialog.addEventListener("close", () => { clearTimeout(trying); trying = undefined; late = 0; }, { signal });

    openLink.addEventListener("click", () => {
      let link = origin ? remixLink(origin, text.value) : wishLink(text.value);
      if (!link) return text.focus();
      if (scheme) link = link.replace(/^lamp:/, `${scheme}:`);
      track("idea_sent", { idea, place });
      status.textContent = "Opening Lamp…";
      clearTimeout(trying);
      trying = setTimeout(() => {
        trying = undefined;
        if (!document.hasFocus() || document.hidden) return;
        late = Date.now() + 15000;
        dialog.setAttribute("data-missing", "");
        openLink.textContent = "Try again";
        status.textContent = `Lamp didn't open, so it's probably not on this Mac yet. Download it, and ${trial ? `${idea} will be there` : "your change will be waiting"} when it opens.`;
        track("idea_missing", { idea, place });
      }, 2000);
      location.href = link;
    }, { signal });

    download.addEventListener("click", () => {
      clearTimeout(trying);
      trying = undefined;
      late = 0;
      track("idea_download", { idea, place });
      // The download leaves this page where it is, so the copy finishes and the dialog can say what happens next.
      copyWish(text.value, { origin }).then((copied) => {
        download.textContent = "Downloading…";
        // Nothing to paste when trying: without the mark, the button here still opens it once Lamp's in.
        if (trial) {
          status.textContent = copied === "marked" ? `Open Lamp when it's ready, and ${idea} will be there.` : "When Lamp's ready, come back and click Open in Lamp.";
          return;
        }
        const ready = starter ? `${starter.name} and your change will be there.` : origin ? "Your copy will be there." : "It'll be there.";
        status.textContent = copied === "marked" ? `Open Lamp when it's ready. ${ready}`
          : copied === "plain" ? "Your change is copied. Paste it into Lamp when it's ready."
          : text.value.trim() ? "Copy your change, and paste it into Lamp when it's ready." : "Open Lamp when it's ready.";
      });
    }, { signal });

    dialog.showModal();
    fit();
    requestAnimationFrame(fit);
    addEventListener("load", fit, { once: true, signal });
    // Ready to change, with the cursor at the end, where there's a pointer and a keyboard; on a touch screen the
    // keyboard would cover the dialog before it's been read.
    if (!trial && matchMedia("(hover: hover) and (pointer: fine)").matches) {
      text.focus({ preventScroll: true });
      text.setSelectionRange(text.value.length, text.value.length);
    }
    track("idea_opened", { idea, place });
  }

  present(location.search);
  document.addEventListener("lamp:remix", (event) => present((event as CustomEvent<string>).detail));
  document.addEventListener("lamp:try", (event) => present((event as CustomEvent<string>).detail, true));
</script>

<style>
  /* A plain card on the paper: a thin ink edge, the picture on the dark at its left, the words at its right, and the
     site's ink button and yellow Download. */
  .remix-dialog {
    margin: auto; padding: 0; width: min(56rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); overflow: visible;
    background: transparent; border: 0; color: var(--color-tape); font-family: var(--font-sans);
  }
  .remix-dialog::backdrop { background: rgb(27 26 23 / 0.55); }
  .remix-dialog[open]::backdrop { animation: remix-dim 0.3s ease both; }
  .remix-dialog[open] .remix-face { animation: remix-rise 0.35s cubic-bezier(0.2, 0.9, 0.25, 1) both; }
  @keyframes remix-rise { from { translate: 0 16px; opacity: 0; } }
  @keyframes remix-dim { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .remix-dialog[open] .remix-face, .remix-dialog[open]::backdrop { animation: none; }
  }
  .remix-face {
    position: relative; display: flex; max-height: calc(100dvh - 2rem); overflow-y: auto; border-radius: 10px;
    background: var(--color-paper); box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-tape) 30%, transparent), 0 30px 70px -20px rgb(0 0 0 / 0.5);
  }
  .remix-close {
    position: absolute; top: 1rem; right: 1rem; z-index: 1; display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border-radius: 50%; background: var(--color-paper); color: var(--color-tape); cursor: pointer;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-tape) 25%, transparent);
  }
  .remix-close:focus-visible { outline: 2px solid var(--color-tape); outline-offset: 2px; }
  .remix-close svg { width: 0.875rem; height: 0.875rem; fill: none; stroke: currentColor; stroke-width: 2.25; stroke-linecap: round; }
  .remix-body { flex: 1; min-width: 0; display: grid; grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .remix-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }

  /* The left side, on the dark: the picture with a light edge, and what it is under it. */
  .remix-label { margin: 0; padding: 1.75rem; background: #1b1a17; color: #f2ecda; }
  @media (min-width: 48rem) { .remix-label { padding: 2.25rem; } }
  .remix-label img { display: block; width: 100%; height: auto; border: 1px solid rgb(242 236 218 / 0.4); }
  /* A repository's icon rather than a screenshot: whole and centered on the paper. */
  .remix-label img[data-fit="contain"] { aspect-ratio: 3 / 2; object-fit: contain; padding: 2rem; background: #f6f1e4; box-sizing: border-box; }
  .remix-about { margin-top: 1.25rem; font-size: 1.0625rem; line-height: 1.5; }
  .remix-written {
    display: grid; place-items: center; aspect-ratio: 3 / 2; margin: 0; padding: 1rem; background: #f6f1e4; color: #1b1a17;
    font-size: clamp(1.5rem, 3.5vw, 2.125rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; text-align: center; overflow-wrap: anywhere;
  }

  .remix-words { display: flex; flex-direction: column; min-width: 0; padding: 1.75rem; }
  @media (min-width: 48rem) { .remix-words { padding: 2.25rem; } }
  .remix-by { margin: 0 3rem 0.25rem 0; font-size: 1rem; font-weight: 700; color: var(--color-muted-ink); }
  .remix-title { margin: 0 3rem 0 0; font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 0.95; font-weight: 900; letter-spacing: -0.04em; overflow-wrap: anywhere; }
  /* Two lines: the app's name, and who made it, lighter. */
  .remix-title :global(:is(.remix-app, .remix-maker)) { display: block; }
  .remix-title :global(.remix-maker) { margin-top: 0.2em; font-size: 0.55em; font-weight: 500; letter-spacing: -0.02em; }
  .remix-from { margin: 0.875rem 0 0; font-size: 1.0625rem; line-height: 1.45; color: var(--color-muted-ink); }
  .remix-ask { margin: 1.5rem 0 0.5rem; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; color: var(--color-muted-ink); }
  .remix-words textarea {
    width: 100%; min-height: 5.5rem; resize: none; padding: 0.75rem 0.875rem; border-radius: 6px;
    background: color-mix(in srgb, var(--color-paper) 70%, white); color: var(--color-tape);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-tape) 35%, transparent); font-family: var(--font-sans); font-size: 1.125rem; line-height: 1.45;
  }
  :global(html[data-theme="dark"]) .remix-words textarea { background: color-mix(in srgb, var(--color-paper) 85%, white); }
  /* Nothing to write when trying it. */
  .remix-dialog[data-try] :is(.remix-ask, textarea) { display: none; }
  .remix-words textarea::placeholder { color: var(--color-muted-ink); }
  .remix-words textarea:focus-visible { outline: 2px solid var(--color-tape); outline-offset: 2px; }
  .remix-buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .remix-button {
    display: inline-flex; align-items: center; min-height: 3rem; padding: 0 1.375rem; border-radius: 6px;
    font-size: 1.0625rem; font-weight: 700; cursor: pointer; box-shadow: inset 0 0 0 1px var(--color-tape);
  }
  .remix-button:hover { opacity: 0.88; }
  .remix-button:focus-visible { outline: 2px solid var(--color-tape); outline-offset: 3px; }
  .remix-button[hidden] { display: none; }
  .remix-button-ink { background: var(--color-tape); color: var(--color-paper); }
  .remix-button-lit { background: transparent; color: var(--color-tape); }
  .remix-play { margin-top: 0.875rem; font-family: var(--font-mono); font-size: 0.875rem; text-decoration: underline; text-underline-offset: 4px; }
  .remix-play[hidden] { display: none; }
  .remix-status { margin: 0.875rem 0 0; font-size: 0.875rem; color: var(--color-muted-ink); }
  /* Lamp didn't open: getting it comes first, in ink, trying again second, and the line says why. */
  .remix-dialog[data-missing] [data-download] { order: -1; background: var(--color-tape); color: var(--color-paper); }
  .remix-dialog[data-missing] [data-open] { background: transparent; color: var(--color-tape); }
  .remix-dialog[data-missing] .remix-status { color: var(--color-tape); font-size: 1rem; font-weight: 700; }
</style>

---
// A bento box on ten columns, each tile a strong color of its own with dark or white words, whichever reads on
// it. A tile with a `visual` shows that illustration across its top, running off its edges, with the words
// beneath; with `below`, the words come first and the illustration sits at the bottom, for variety. With
// `center`, an illustration that doesn't run off the tile's edges sits in the middle of the room above the words.
// Anything in the slot comes first, as a tile of its own.
import { sentences, together } from "../lib/text";

export type Point = { title: string; text: string; tile: string; visual?: (props: object) => unknown; below?: boolean; centre?: boolean };

const { points } = Astro.props as { points: Point[] };
---

<div class="grid gap-4 bento:grid-cols-10">
  <slot />
  {
    points.map((point) => (
      <div class:list={["flex min-h-56 flex-col overflow-hidden rounded-[28px]", point.below ? "justify-between" : "justify-end", point.tile]}>
        {point.visual && !point.below && (point.centre ? <div class="flex flex-1 flex-col justify-center"><point.visual /></div> : <point.visual />)}
        <div class:list={["p-8 sm:p-10", point.below && "pb-2 sm:pb-4"]}>
          <h3 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
            {sentences(point.title).map((sentence, index, all) => (
              <>{index > 0 && " "}<span class:list={[all.length > 1 && "whitespace-nowrap"]}>{sentence}</span></>
            ))}
          </h3>
          <p class="mt-3 text-xl leading-[1.4] opacity-85">{point.text.split("\n").map((line, index) => <>{index > 0 && <br />}{together(line)}</>)}</p>
        </div>
        {point.visual && point.below && <point.visual />}
      </div>
    ))
  }
</div>

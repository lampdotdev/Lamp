---
import { together } from "../lib/text";
import { DOWNLOAD_URL } from "../lib/download";

interface Props {
  /** Where on the page this button sits, for the site's analytics. */
  place: string;
}
const { place } = Astro.props;
// Another button may stand beside it (the `beside` slot), with the line about Macs under both.
const beside = Astro.slots.has("beside");
---

<!--
  Shaped like the Mac app's welcome button (BigButton in Onboarding.swift), a capsule with a faint light edge and a
  slight shadow that grows a little under the pointer, in the lamp's bright orange. White words on it are about
  3:1, so a faint shadow under them keeps their edges crisp. No glow, so it doesn't compete with the lamp below it.
-->
<div class="flex flex-col items-center">
  <div class:list={[beside && "flex flex-wrap items-center justify-center gap-3"]}>
  <a
    href={DOWNLOAD_URL}
    data-download-place={place}
    class="inline-flex h-[52px] items-center rounded-full bg-linear-to-b from-[#ff8a24] to-[#e65c00] [text-shadow:0_1px_1px_rgb(140_50_0/0.35)] px-9 text-[17px] font-semibold text-white shadow-[0_1px_3px_rgba(0,0,0,0.18)] ring-1 ring-white/30 ring-inset transition duration-300 ease-[cubic-bezier(.34,1.56,.64,1)] hover:scale-[1.03] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b04e0a] active:scale-[0.98]"
  >
    <!-- On a phone or a tablet it says what it's for, so nobody tries to put Lamp on an iPhone. -->
    <span class="max-sm:hidden pointer-coarse:hidden">Download free</span><span class="hidden max-sm:inline pointer-coarse:inline">Download for Mac</span>
  </a>
  <slot name="beside" />
  </div>
  <p class="mt-3 text-sm text-muted">{together("For Macs with Apple Silicon and macOS 14 Sonoma or later")}</p>
</div>

---
import { together } from "../lib/text";
import { DOWNLOAD_URL } from "../lib/download";

interface Props {
  /** Where on the page this button sits, for the site's analytics. */
  place: string;
}
const { place } = Astro.props;
// Another button may stand beside it (the `beside` slot), with the line about Macs under both.
const beside = Astro.slots.has("beside");
---

<!-- The site's one kind of button (global.css's .ink-button): ink with paper-colored words. -->
<div class="flex flex-col items-center">
  <div class:list={[beside && "flex flex-wrap items-center justify-center gap-3"]}>
  <a
    href={DOWNLOAD_URL}
    data-download-place={place}
    class="ink-button h-[52px] px-8 text-[17px]"
  >
    <!-- On a phone or a tablet it says what it's for, so nobody tries to put Lamp on an iPhone. -->
    <span class="max-sm:hidden pointer-coarse:hidden">Download free</span><span class="hidden max-sm:inline pointer-coarse:inline">Download for Mac</span>
  </a>
  <slot name="beside" />
  </div>
  <p class="mt-3 text-sm text-muted">{together("For Macs with Apple Silicon and macOS 14 Sonoma or later")}</p>
</div>

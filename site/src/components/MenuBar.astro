---
import { DOWNLOAD_URL } from "../lib/download";
import { REPO_URL } from "../lib/releases";
import LampLockup from "./LampLockup.astro";

// The page we're on, so its link can say so.
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [{ href: "/changelog", label: "Changelog" }];
---

<!--
  A plain bar across the top of every page, on the paper, with a thin rule under it: Lamp's icon and name on the
  left; GitHub (its mark alone), the changelog and Download on the right (the ideas page is left out of it for now), in the mono the rest of the site's labels use.
  What it covers is --menu-height (global.css): pages start below it, and the ideas page's filters stay under it.
-->
<header class="fixed inset-x-0 top-0 z-40 border-b border-tape/20 bg-paper/95 backdrop-blur-md">
  <nav aria-label="Lamp" class="mx-auto flex h-16 max-w-[var(--frame)] items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="shrink-0 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tape">
      <LampLockup size={28} />
    </a>
    <div class="flex items-center gap-1 font-mono text-sm sm:gap-2">
      <a
        href={REPO_URL}
        aria-label="Lamp on GitHub"
        title="Lamp on GitHub"
        class="flex h-10 w-10 items-center justify-center rounded-sm text-tape hover:opacity-70 focus-visible:outline-2 focus-visible:outline-tape"
      >
        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-5 w-5 fill-current"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
      </a>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={here === link.href ? "page" : undefined}
            class="hidden h-10 items-center rounded-sm px-2 text-tape underline-offset-[6px] hover:underline focus-visible:outline-2 focus-visible:outline-tape aria-[current=page]:underline sm:flex sm:px-3"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={DOWNLOAD_URL}
        data-download-place="menu"
        class="ink-button ml-1 h-10 px-4 text-sm sm:ml-2"
      >
        Download
      </a>
    </div>
  </nav>
</header>

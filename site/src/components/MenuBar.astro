---
import { Image } from "astro:assets";
import icon from "../assets/AppIcon.png";
import { DOWNLOAD_URL } from "../lib/download";

// The page we're on, so its link can say so.
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
// On a phone Home is left out: the name beside it goes home too. Features, Pricing and AI go to the homepage's
// sections of those names, in the page's order, and only where there's room for them beside the rest.
const links = [
  { href: "/", label: "Home", wide: true },
  { href: "/#features", label: "Features", wider: true },
  { href: "/#pricing", label: "Pricing", wider: true },
  { href: "/#ai", label: "AI", wider: true },
  { href: "/ideas", label: "Ideas" },
];
---

<!--
  A floating menu bar on every page: a pill as wide as the page's content, of frosted glass, held a little below
  the top of the window over whatever is there, as the page scrolls under it. On the homepage it starts inside the
  hero card, which runs to the top of the window, inset from the card's edges as far on top as on the sides.
  The name on the left; a few links and a small Download on the right, inset from the pill's edge as far as it
  is from top and bottom, so the curves nest. What it covers (the pill and the space above it) is --menu-height
  (global.css): pages start below it, and the ideas page's filters stay under it.
-->
<header class="pointer-events-none fixed inset-x-0 top-0 z-40 px-4 pt-4 sm:px-6 sm:pt-6">
  <nav
    aria-label="Lamp"
    class="pointer-events-auto mx-auto flex h-14 max-w-[69rem] items-center justify-between rounded-full bg-white/78 pr-2 pl-3 shadow-[0_12px_36px_-14px_rgba(0,0,0,0.22),0_2px_6px_-2px_rgba(0,0,0,0.06)] backdrop-blur-2xl backdrop-saturate-[1.8]"
  >
    <a href="/" class="flex h-10 items-center gap-2.5 rounded-full pr-3.5 pl-1.5 transition hover:bg-black/[0.04] focus-visible:outline-2 focus-visible:outline-graphite">
      <Image src={icon} alt="" width={26} height={26} densities={[1, 2]} class="size-6.5" />
      <!-- On the narrowest phones the name gives its room to Download for Mac; the icon still says Lamp. -->
      <span class="text-[16px] font-semibold tracking-tight max-[359px]:sr-only">Lamp</span>
    </a>
    <div class="flex items-center gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link
            aria-current={here === link.href ? "page" : undefined}
            class:list={[
              "group flex h-10 items-center rounded-full px-3 text-[14px] text-ink/70 transition hover:bg-black/[0.04] hover:text-ink focus-visible:outline-2 focus-visible:outline-graphite aria-[current=page]:text-ink sm:px-4",
              link.wide && "hidden sm:flex",
              link.wider && "hidden md:flex",
            ]}
          >
            <!-- The page we're on is in bold. The bold word is always there, unseen, so the link keeps its width. -->
            <span class="grid">
              <span class="col-start-1 row-start-1 group-aria-[current=page]:font-semibold">{link.label}</span>
              <span aria-hidden="true" class="invisible col-start-1 row-start-1 font-semibold">{link.label}</span>
            </span>
          </a>
        ))
      }
      <a
        href={DOWNLOAD_URL}
        data-download-place="menu"
        class="ml-1 inline-flex h-10 items-center rounded-full bg-linear-to-b from-[#ff8a24] to-[#e65c00] [text-shadow:0_1px_1px_rgb(140_50_0/0.35)] px-4 whitespace-nowrap sm:ml-2 sm:px-5 text-[14px] font-semibold text-white shadow-[0_1px_2px_rgba(0,0,0,0.15)] ring-1 ring-white/30 ring-inset transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#b04e0a] active:scale-[0.97]"
      >
        <!-- On a phone or a tablet it says what it's for, so nobody tries to put Lamp on an iPhone. -->
        <span class="max-sm:hidden pointer-coarse:hidden">Download free</span><span class="hidden max-sm:inline pointer-coarse:inline">Download for Mac</span>
      </a>
    </div>
  </nav>
</header>

<script>
  // On the homepage, the link to the section being read is the one marked, as the page scrolls; Home is marked
  // everywhere else on it. A section is being read while it's under a line a third of the way down the window.
  if (location.pathname === "/") {
    const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]")].filter((link) => link.getAttribute("href") !== "/ideas");
    const home = links.find((link) => link.getAttribute("href") === "/");
    const sections = links
      .map((link) => ({ link, section: document.getElementById(link.getAttribute("href")!.replace("/#", "")) }))
      .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => !!entry.section && entry.link !== home);
    const mark = () => {
      const line = innerHeight / 3;
      const reading = sections.find(({ section }) => {
        const box = section.getBoundingClientRect();
        return box.top <= line && box.bottom > line;
      });
      const current = reading?.link ?? home;
      for (const link of links) {
        if (link === current) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
    };
    addEventListener("scroll", mark, { passive: true });
    addEventListener("resize", mark);
    mark();
  }
</script>

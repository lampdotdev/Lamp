---
import { DOWNLOAD_URL } from "../lib/download";

// The page we're on, so its link can say so.
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
// Remixes and Your devices go to the homepage's sections of those names; on a phone only Ideas fits beside the
// name and Download, and on the narrowest ones not even that.
const links = [
  { href: "/#remix", label: "Remixes", wide: true },
  { href: "/#devices", label: "Your devices", wide: true },
  { href: "/ideas", label: "Ideas" },
];
---

<!--
  A bar across the top of every page, on the homepage's paper, over whatever scrolls under it, with a rule under
  it like the edge of a label. The name on the left, sitting in the corner of a short, thick L in the sleeve's
  stripes; a few links and Download on the right. What it covers is --menu-height (global.css): pages start below it, and the
  ideas page's filters stay under it.
-->
<header class="fixed inset-x-0 top-0 z-40 border-b-2 border-tape bg-paper/92 backdrop-blur-md">
  <nav aria-label="Lamp" class="mx-auto flex h-16 max-w-[80rem] items-center justify-between gap-4 px-4 sm:h-[4.5rem] sm:px-6">
    <!-- On the narrowest phones the L is a little smaller and Ideas is left out, so Download for Mac always fits. -->
    <a href="/" class="relative block h-[38px] w-[96px] shrink-0 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tape min-[400px]:h-[46px] min-[400px]:w-[118px]">
      <span class="lamp-l absolute inset-0" aria-hidden="true"></span>
      <span class="absolute bottom-[17px] left-[25px] text-[25px] leading-[0.74] font-black tracking-[-0.05em] min-[400px]:text-[31px]">lamp</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-nav-link
            aria-current={here === link.href ? "page" : undefined}
            class:list={[
              "flex h-10 items-center rounded-sm px-2.5 text-[15px] font-bold text-tape underline-offset-[6px] hover:underline focus-visible:outline-2 focus-visible:outline-tape aria-[current=page]:underline sm:px-3",
              link.wide ? "hidden md:flex" : "max-[399px]:hidden",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={DOWNLOAD_URL}
        data-download-place="menu"
        class="ml-1 inline-flex h-11 items-center rounded-[6px] bg-tape px-4 text-[15px] font-extrabold whitespace-nowrap text-paper transition hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-tape sm:ml-2 sm:px-5"
      >
        Download for Mac
      </a>
    </div>
  </nav>
</header>

<style>
  /* The L: an upright as thick as its foot is tall, and a foot that runs under the whole name. */
  .lamp-l {
    clip-path: polygon(0 0, 19px 0, 19px calc(100% - 14px), 100% calc(100% - 14px), 100% 100%, 0 100%);
    background: linear-gradient(150deg, #f6b81c 0 14%, #f08a1c 0 28%, #e2402a 0 42%, #d23778 0 56%, #5a2d8c 0 70%, #2c3592 0 84%, #1f6fc4 0);
  }
</style>

<script>
  // On the homepage, the link to the section being read is the one underlined, as the page scrolls. A section is
  // being read while it's under a line a third of the way down the window.
  if (location.pathname === "/") {
    const sections = [...document.querySelectorAll<HTMLAnchorElement>("a[data-nav-link]")]
      .filter((link) => link.getAttribute("href")!.startsWith("/#"))
      .map((link) => ({ link, section: document.getElementById(link.getAttribute("href")!.slice(2)) }))
      .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => !!entry.section);
    const mark = () => {
      const line = innerHeight / 3;
      for (const { link, section } of sections) {
        const box = section.getBoundingClientRect();
        if (box.top <= line && box.bottom > line) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      }
    };
    addEventListener("scroll", mark, { passive: true });
    addEventListener("resize", mark);
    mark();
  }
</script>

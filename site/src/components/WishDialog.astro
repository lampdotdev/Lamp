---
import DownloadButton from "./DownloadButton.astro";

interface Props {
  /** Which page it's on, for the site's analytics. */
  place: string;
}
const { place } = Astro.props;
---

<!--
  A wish, opened to change and take to Lamp, as at the end of the homepage's first-idea section: Download copies it
  with Lamp's mark for Lamp to find when it first opens, and on a Mac a link opens Lamp with it straight away. It
  opens for any button marked data-idea, whose value is the wish as JSON: its name, a line about it, its words, its
  platform when the words don't say, and its picture and icon (either may be empty).
-->
<dialog
  data-wish
  data-place={place}
  aria-labelledby="wish-name"
  class="m-auto max-h-[calc(100dvh-2rem)] w-[min(36rem,calc(100vw-2rem))] overflow-y-auto rounded-[28px] bg-page p-0 text-ink shadow-[0_30px_80px_-20px_rgba(0,0,0,0.45)] backdrop:bg-black/40 backdrop:backdrop-blur-sm lg:w-[min(70rem,calc(100vw-4rem))] lg:grid-cols-[1.3fr_1fr] lg:overflow-hidden lg:open:grid"
>
  <!-- The picture: across the top on narrower screens; from lg, the left of two columns, shown whole on a soft,
       blurred copy of itself however tall the wish beside it is. -->
  <div data-stage class="relative overflow-hidden lg:flex lg:items-center">
    <img data-backdrop alt="" class="absolute inset-0 hidden size-full scale-125 object-cover opacity-80 blur-2xl lg:block" />
    <img data-picture alt="" class="relative aspect-[3/2] w-full object-cover lg:shadow-[0_20px_50px_-20px_rgba(0,0,0,0.35)]" />
  </div>
  <div class="relative p-6 sm:p-8 lg:max-h-[calc(100dvh-2rem)] lg:overflow-y-auto lg:p-10">
    <button
      type="button"
      data-close
      aria-label="Close"
      class="absolute top-4 right-4 grid size-8 cursor-pointer place-items-center rounded-full bg-panel/90 text-muted backdrop-blur transition hover:text-ink focus-visible:outline-2 focus-visible:outline-graphite"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5 fill-none stroke-current stroke-2 [stroke-linecap:round]"><path d="M4 4l8 8M12 4l-8 8" /></svg>
    </button>
    <div class="flex items-start gap-4">
      <img data-icon alt="" width="64" height="64" class="size-16 shrink-0 drop-shadow-[0_6px_12px_rgba(0,0,0,0.18)]" hidden />
      <div class="pt-1">
        <h2 id="wish-name" data-name class="pr-10 font-display text-3xl leading-tight font-bold tracking-tight"></h2>
        <p data-about class="mt-1.5 text-[15px] leading-snug text-muted"></p>
      </div>
    </div>
    <label for="wish-text" class="mt-6 mb-2.5 block text-[15px] font-semibold">Make it yours, then give it to Lamp:</label>
    <textarea
      id="wish-text"
      data-text
      rows="5"
      class="w-full resize-none rounded-xl bg-page p-3.5 text-[17px] leading-relaxed ring-1 ring-[#d2d2d7] transition focus:ring-2 focus:ring-[#cf620c]/40 focus:outline-none"
    ></textarea>
    <!-- A wish carries only its words to Lamp, which starts a Mac app unless told otherwise, so an iPhone or
         iPad idea says which to choose. -->
    <p data-device hidden class="mt-3 text-[14px] text-muted"></p>
    <div data-finish class="mt-6 flex flex-col items-center lg:items-start lg:[&>div]:items-start">
      <DownloadButton place={place} />
      <button
        type="button"
        data-open
        hidden
        class="mt-3.5 cursor-pointer text-[15px] font-medium text-[#b04e0a] underline decoration-[#b04e0a]/40 underline-offset-4 transition hover:decoration-[#b04e0a]"
      >
        Already have Lamp? Open it with this wish
      </button>
    </div>
  </div>
</dialog>

<script>
  import { copyWish, wishLink } from "../../lib/wish.js";
  import { track } from "../lib/analytics";

  const dialog = document.querySelector<HTMLDialogElement>("[data-wish]")!;
  const place = dialog.dataset.place ?? "";
  const name = dialog.querySelector<HTMLElement>("[data-name]")!;
  const about = dialog.querySelector<HTMLElement>("[data-about]")!;
  const text = dialog.querySelector<HTMLTextAreaElement>("[data-text]")!;
  const go = dialog.querySelector<HTMLAnchorElement>("[data-finish] a")!;
  const requirement = dialog.querySelector<HTMLElement>("[data-finish] p");
  const openLink = dialog.querySelector<HTMLButtonElement>("[data-open]")!;
  // The line under the button says which Macs Lamp runs on everywhere else on the site; here it only says what
  // happens next, once Download has been pressed.
  go.textContent = "Download Lamp";
  // A page can't tell whether Lamp is installed, so the Mac that has it gets its own way in, beside Download.
  openLink.hidden = !(/Mac/.test(navigator.platform) && navigator.maxTouchPoints < 2);

  const fit = () => { text.style.height = "auto"; text.style.height = `${text.scrollHeight + 2}px`; };
  text.addEventListener("input", fit);

  // A wish whose words name its device (the TV, a watch) needs no platform: Lamp goes by the words.
  type Idea = { name: string; about: string; wish: string; platform?: string; picture: string; icon: string };
  const device = dialog.querySelector<HTMLElement>("[data-device]")!;
  const stage = dialog.querySelector<HTMLElement>("[data-stage]")!;
  const picture = dialog.querySelector<HTMLImageElement>("[data-picture]")!;
  const backdrop = dialog.querySelector<HTMLImageElement>("[data-backdrop]")!;
  const icon = dialog.querySelector<HTMLImageElement>("[data-icon]")!;
  let current: Idea | null = null;
  // Where the wish came from, for the site's analytics: this page's ideas, or a wish someone shared as a link.
  let from = place;
  const open = (idea: Idea, shown: string, opened: string) => {
    current = idea;
    from = opened;
    // The card's own picture straight away, already loaded, so the last wish's never lingers; the larger one
    // takes its place once it has arrived.
    stage.hidden = !current.picture;
    picture.src = backdrop.src = shown || current.picture;
    if (current.picture && current.picture !== shown) {
      const wanted = current.picture, sharper = new Image();
      sharper.onload = () => { if (current?.picture === wanted) picture.src = wanted; };
      sharper.src = wanted;
    }
    icon.hidden = !current.icon;
    if (current.icon) icon.src = current.icon;
    name.textContent = current.name;
    about.textContent = current.about;
    device.hidden = !current.platform || current.platform === "Mac";
    device.textContent = `In Lamp, choose ${current.platform} before you send this wish.`;
    text.value = current.wish;
    go.textContent = "Download Lamp";
    if (requirement) requirement.hidden = true;
    dialog.showModal();
    fit();
    // Ready to change straight away, with the cursor at the end, where there's a pointer and a keyboard; on a
    // touch screen the keyboard would cover the wish before it's been read.
    if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
      text.focus({ preventScroll: true });
      text.setSelectionRange(text.value.length, text.value.length);
    }
    track("idea_opened", { idea: current.name, place: from });
  };
  document.querySelectorAll<HTMLButtonElement>("[data-idea]").forEach((card) =>
    card.addEventListener("click", () => open(JSON.parse(card.dataset.idea!) as Idea, card.querySelector("img")?.currentSrc ?? "", place)),
  );

  // A wish shared as a link (lamp.dev/w/<id>) is this page with that wish's card open on it: the server puts it in
  // the page as #shared-wish (lib/shared-wish-page.js). On a Mac, Lamp is tried with it once as it opens, since a
  // page can't tell whether Lamp is there; the link under Download tries again.
  const shared = document.getElementById("shared-wish")?.textContent;
  if (shared) {
    const wish = JSON.parse(shared) as Idea & { id: string };
    open(wish, "", "shared");
    // Opened while the page is still loading, the box is sized again once it has its width.
    requestAnimationFrame(fit);
    addEventListener("load", fit, { once: true });
    const tried = `lamp-shared-${wish.id}`;
    let first = true;
    try { first = !sessionStorage.getItem(tried); sessionStorage.setItem(tried, "1"); } catch {}
    const link = wishLink(wish.wish);
    if (first && !openLink.hidden && link) location.href = link;
  }

  dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
  // A click on the dimmed page around the card closes it too.
  dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });

  go.addEventListener("click", () => {
    if (current) track("idea_download", { idea: current.name, place: from });
    // The download leaves this page where it is, so the copy finishes and the card can say what happens next.
    copyWish(text.value).then((copied) => {
      go.textContent = "Downloading…";
      if (requirement) requirement.hidden = false;
      if (requirement) requirement.textContent = copied === "marked" ? "Open Lamp when it's ready. Your wish will be there."
        : copied === "plain" ? "Your wish is copied. Paste it into Lamp when it's ready."
        : "Copy your wish, and paste it into Lamp when it's ready.";
    });
  });

  openLink.addEventListener("click", () => {
    const link = wishLink(text.value);
    if (!link) return;
    if (current) track("idea_sent", { idea: current.name, place: from });
    location.href = link;
  });
</script>

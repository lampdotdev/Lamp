---
import { Image } from "astro:assets";
import paletteStudio from "../../assets/icons/palette-studio.png";

// For "Made to share", above the words: you and a friend as contact-style avatars, an app arcing from one to the
// other along a dotted path, and the friend wearing its icon as a badge: their own copy. Drawn on a 656×320
// canvas, the whole of the six-column tile on a laptop, so it fills the tile's width.
const you = { x: 150, y: 200 };
const friend = { x: 506, y: 200 };
const peak = { x: 328, y: 82 };
---

<div aria-hidden="true" class="relative h-[168px] overflow-hidden select-none sm:h-[320px]">
  <!-- On a phone the scene is drawn at the desktop size and shrunk, keeping the same arrangement. -->
  <div class="absolute top-0 left-1/2 h-[320px] w-[656px] origin-top -translate-x-1/2 scale-[0.52] sm:scale-100">
    <svg viewBox="0 0 656 320" class="absolute inset-0 h-[320px] w-[656px]">
      <path
        d={`M${you.x + 44} ${you.y - 66} Q${peak.x} ${peak.y - 96} ${friend.x - 44} ${friend.y - 66}`}
        fill="none"
        stroke="currentColor"
        stroke-opacity="0.5"
        stroke-width="2.5"
        stroke-dasharray="2 9"
        stroke-linecap="round"
      />
    </svg>

    {
      [
        { ...you, name: "You" },
        { ...friend, name: "A friend", badge: true },
      ].map((person) => (
        <div class="absolute flex -translate-x-1/2 -translate-y-1/2 flex-col items-center" style={`left: ${person.x}px; top: ${person.y}px`}>
          <div class="relative grid size-32 place-items-center rounded-full bg-linear-to-b from-[#d1d1d6] to-[#8e8e93] shadow-[0_14px_30px_rgba(40,0,90,0.3)] ring-4 ring-white/25">
            <svg viewBox="0 0 24 24" class="size-20 fill-white">
              <circle cx="12" cy="8.6" r="4.2" />
              <path d="M3.8 21c.9-4.4 4.2-6.6 8.2-6.6s7.3 2.2 8.2 6.6z" />
            </svg>
            {person.badge && (
              <Image src={paletteStudio} alt="" width={56} height={56} densities={[1, 2]} class="absolute -right-3 -bottom-3 size-14 drop-shadow-[0_6px_10px_rgba(0,0,0,0.25)]" />
            )}
          </div>
          <span class="mt-3 text-[17px] font-semibold">{person.name}</span>
        </div>
      ))
    }

    <!-- The app on its way -->
    <Image
      src={paletteStudio}
      alt=""
      width={112}
      height={112}
      densities={[1, 2]}
      class="absolute size-28 -translate-x-1/2 -translate-y-1/2 drop-shadow-[0_18px_28px_rgba(40,0,90,0.35)]"
      style={`left: ${peak.x}px; top: ${peak.y}px`}
    />
  </div>
</div>

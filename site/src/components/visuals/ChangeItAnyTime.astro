---
// For "Change your mind. No regrets.", as an idea rather than a screen: four versions of one app stacked down a
// timeline, oldest at the top, each a step further along (an empty window, then a list, then a heat map, then a
// chart), and an arrow curving up from the newest back to the second, which is ringed: the one you'd go back to.
// The windows are white and grey, and the arrow and ring take the tile's text colour. Positions are on a
// 432×300 canvas, the tile's size on a laptop (four columns of ten), starting 40px in to line up with the words,
// and set 20px low so it sits midway between the tile's top and its heading (the words have 40px above them).
const versions = ["empty", "list", "map", "chart"].map((kind, index) => ({ kind, y: 46 + index * 66 }));
const left = 80;
const width = 210;
const height = 50;
const rail = 52;
const middle = (index: number) => versions[index].y + height / 2;
const right = left + width + 10;
const arrow = `M${right} ${middle(3)} C ${right + 74} ${middle(3)}, ${right + 74} ${middle(1)}, ${right + 6} ${middle(1)}`;
const shades = [0.08, 0.26, 0.15, 0.32, 0.11, 0.21, 0.18, 0.09, 0.28, 0.14, 0.23, 0.12];
---

<div aria-hidden="true" class="relative h-[237px] overflow-hidden select-none sm:h-[300px]">
  <!-- On a phone the scene is drawn at the desktop tile's size and shrunk, keeping the same arrangement. -->
  <div class="absolute inset-0 h-[127%] w-[127%] origin-top-left scale-[0.79] sm:h-full sm:w-full sm:scale-100">
    <svg viewBox="0 0 432 300" class="absolute inset-0 h-[300px] w-[432px] overflow-visible">
      <!-- The timeline, with a dot beside each version; the newest is the larger one. -->
      <line x1={rail} y1={middle(0)} x2={rail} y2={middle(3)} stroke="currentColor" stroke-opacity="0.25" stroke-width="2" />
      {
        versions.map((_, index) => (
          <circle cx={rail} cy={middle(index)} r={index === 3 ? 6.5 : 4.5} fill="currentColor" fill-opacity={index === 3 || index === 1 ? 1 : 0.35} />
        ))
      }
      <!-- Going back -->
      <path d={arrow} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
      <path d={`M${right + 15} ${middle(1) - 7} L${right + 4} ${middle(1)} L${right + 15} ${middle(1) + 7}`} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>

    {
      versions.map((version, index) => (
        <div
          class:list={[
            "absolute overflow-hidden rounded-lg bg-white shadow-[0_8px_20px_rgba(0,0,0,0.12)]",
            index === 1 ? "ring-2 ring-current" : "ring-1 ring-black/5",
          ]}
          style={`left: ${left}px; top: ${version.y}px; width: ${width}px; height: ${height}px`}
        >
          <div class="flex gap-0.5 px-2 pt-1.5">
            {[0, 1, 2].map(() => <span class="size-1 rounded-full bg-black/15" />)}
          </div>
          <div class="absolute inset-x-2 top-4 bottom-2 flex gap-1.5">
            <div class="w-8 rounded-sm bg-black/5" />
            <div class="flex flex-1 flex-col justify-center gap-1">
              {version.kind === "list" && [0.9, 0.7, 0.8].map((w) => <div class="h-1 rounded-full bg-black/12" style={`width: ${w * 100}%`} />)}
              {
                (version.kind === "map" || version.kind === "chart") && (
                  <div class="grid grid-cols-12 gap-px">
                    {Array.from({ length: version.kind === "map" ? 24 : 12 }, (_, i) => (
                      <span class="aspect-square rounded-[1px]" style={`background: rgba(0,0,0,${shades[i % 12]})`} />
                    ))}
                  </div>
                )
              }
              {
                version.kind === "chart" && (
                  <div class="flex h-3 items-end gap-px">
                    {[0.5, 0.8, 0.6, 1, 0.7, 0.9, 0.55, 0.85, 0.65, 0.95].map((h, i) => (
                      <span class="flex-1 rounded-t-[1px]" style={`height: ${h * 100}%; background: rgba(0,0,0,${[0.18, 0.3, 0.24][i % 3]})`} />
                    ))}
                  </div>
                )
              }
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

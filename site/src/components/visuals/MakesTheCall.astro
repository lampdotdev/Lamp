---
// For "Makes the call.": an app that watches what's running and judges each thing, not just by its size: the
// heavy one gets the setting that fixes it, the idle one gets quit, and the busy one is left alone because it's
// busy for a reason. A white window on a 656×280 canvas, the tile's size on a laptop (six columns of ten),
// starting 40px in to line up with the words and running off the right edge.
const rows = [
  { name: "Chrome", use: "4.2 GB", bar: 0.92, verdict: "31 tabs are awake in the background. Turn on Memory Saver in Chrome's Performance settings.", action: "Show Me", strong: true },
  { name: "Zoom", use: "1.1 GB", bar: 0.3, verdict: "Idle since this morning's call.", action: "Quit" },
  { name: "Photos", use: "0.9 GB", bar: 0.24, verdict: "Busy for a reason: it's finding faces. Leave it.", action: "" },
];
---

<div aria-hidden="true" class="relative h-[200px] overflow-hidden select-none sm:h-[280px]">
  <!-- On a phone the scene is drawn at the desktop tile's size and shrunk, keeping the same arrangement. -->
  <div class="absolute inset-0 h-[140%] w-[140%] origin-top-left scale-[0.714] sm:h-full sm:w-full sm:scale-100">
    <div class="absolute top-10 left-10 w-[640px] rounded-xl bg-white p-4 text-ink shadow-[0_14px_34px_rgba(0,0,0,0.22)]">
      <div class="flex gap-1.5">{[0, 1, 2].map(() => <span class="size-2.5 rounded-full bg-black/12" />)}</div>
      <div class="mt-3 flex flex-col gap-2.5">
        {
          rows.map((row) => (
            <div class:list={["rounded-lg px-3 py-2.5", row.strong ? "bg-indigo-50" : "bg-black/[0.03]"]}>
              <div class="flex items-center gap-3 text-[13px] font-semibold">
                <span class="w-16">{row.name}</span>
                <span class="h-1.5 w-40 overflow-hidden rounded-full bg-black/8">
                  <span class="block h-full rounded-full bg-indigo-500" style={`width: ${row.bar * 100}%`} />
                </span>
                <span class="w-14 text-muted">{row.use}</span>
              </div>
              <div class="mt-1.5 flex items-center gap-3 text-[13px] leading-snug">
                <span class="w-[400px] text-ink/80">{row.verdict}</span>
                {row.action && (
                  <span class:list={["rounded-md px-2.5 py-1 text-[12px] font-semibold", row.strong ? "bg-indigo-600 text-white" : "bg-black/8"]}>{row.action}</span>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

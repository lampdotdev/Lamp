---
import { Image } from "astro:assets";
import habitStreaks from "../../assets/icons/habit-streaks.png";

// For "Works with what's on your Mac", shown under the words: an app Lamp made rising from the tile's bottom
// edge, with what it can reach fanned out above it and joined to it by faint lines. The marks are simple
// drawings of our own in each kind's usual colour, not Apple's app icons. Positions are on a 600×300 canvas,
// spaced along an arc around the app.
const centre = { x: 300, y: 250 };
const services = [
  { name: "Calendar", colour: "#ff3b30", glyph: "calendar" },
  { name: "Reminders", colour: "#ff9500", glyph: "reminders" },
  { name: "Contacts", colour: "#a2845e", glyph: "contacts" },
  { name: "Mail", colour: "#0a84ff", glyph: "mail" },
  { name: "Notes", colour: "#e6b400", glyph: "notes" },
  { name: "Messages", colour: "#34c759", glyph: "messages" },
].map((service, index) => {
  const angle = ((165 - index * 30) * Math.PI) / 180;
  return { ...service, x: Math.round(centre.x + 225 * Math.cos(angle)), y: Math.round(centre.y - 185 * Math.sin(angle)) };
});
---

<div aria-hidden="true" class="relative h-[172px] overflow-hidden select-none sm:h-[300px]">
  <!-- Drawn at 600×300 and centred; on a phone it's shrunk whole, keeping the same arrangement. -->
  <div class="absolute top-0 left-1/2 h-[300px] w-[600px] origin-top -translate-x-1/2 scale-[0.57] sm:scale-100">
    <svg viewBox="0 0 600 300" class="absolute inset-0 size-full overflow-visible">
      {
        services.map((service) => (
          <line x1={centre.x} y1={centre.y} x2={service.x} y2={service.y} stroke="rgba(0,0,0,0.1)" stroke-width="1.5" stroke-dasharray="3 5" />
        ))
      }
    </svg>

    {
      services.map((service) => (
        <div class="absolute flex w-20 -translate-x-1/2 -translate-y-7 flex-col items-center" style={`left: ${service.x}px; top: ${service.y}px`}>
          <div class="grid size-14 place-items-center rounded-2xl bg-white shadow-[0_6px_16px_rgba(0,0,0,0.1)] ring-1 ring-black/5" style={`color: ${service.colour}`}>
            <svg viewBox="0 0 24 24" class="size-7 fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]">
              {service.glyph === "calendar" && (
                <>
                  <rect x="3.5" y="5" width="17" height="15" rx="3" />
                  <path d="M3.5 9.5h17M8 3v4M16 3v4" />
                  <path d="M8 13.5h.01M12 13.5h.01M16 13.5h.01M8 17h.01M12 17h.01" stroke-width="2.4" />
                </>
              )}
              {service.glyph === "reminders" && (
                <>
                  <circle cx="5.5" cy="6.5" r="1.6" />
                  <circle cx="5.5" cy="12" r="1.6" />
                  <circle cx="5.5" cy="17.5" r="1.6" />
                  <path d="M10 6.5h10M10 12h10M10 17.5h7" />
                </>
              )}
              {service.glyph === "contacts" && (
                <>
                  <circle cx="12" cy="8.5" r="3.6" />
                  <path d="M4.5 20c.8-4 3.8-6 7.5-6s6.7 2 7.5 6" />
                </>
              )}
              {service.glyph === "mail" && (
                <>
                  <rect x="3" y="5.5" width="18" height="13" rx="2.5" />
                  <path d="M3.8 7l8.2 6 8.2-6" />
                </>
              )}
              {service.glyph === "notes" && (
                <>
                  <rect x="4.5" y="3.5" width="15" height="17" rx="2.5" />
                  <path d="M8 8.5h8M8 12h8M8 15.5h5" />
                </>
              )}
              {service.glyph === "messages" && (
                <path d="M12 4.5c4.7 0 8.5 3 8.5 6.8s-3.8 6.8-8.5 6.8c-1 0-2-.1-2.9-.4L5 19.5l1.1-3.6C4.5 14.6 3.5 13 3.5 11.3c0-3.8 3.8-6.8 8.5-6.8z" />
              )}
            </svg>
          </div>
          <span class="mt-1.5 text-[12px] font-medium text-muted">{service.name}</span>
        </div>
      ))
    }

    <!-- The app, rising from the bottom edge -->
    <Image
      src={habitStreaks}
      alt=""
      width={128}
      height={128}
      densities={[1, 2]}
      class="absolute size-32 -translate-x-1/2 -translate-y-1/2 drop-shadow-[0_14px_24px_rgba(0,0,0,0.18)]"
      style={`left: ${centre.x}px; top: ${centre.y}px`}
    />
  </div>
</div>

---
// For "Plugged into your day", shown under the words: an app rising from the tile's bottom edge (a figure on an
// exercise bike, like the figure.indoor.cycle symbol), with what it can reach fanned out above it and joined to it by faint
// lines. Each is a white tile with its mark in the tile's own blue, like an app icon, so the picture stays one
// colour with the tile; the marks are simple drawings of our own, not Apple's app icons. Positions are on a 600×300 canvas, spaced along an arc around the
// app narrow enough (about 400 wide with the labels) for the tile's four columns of ten.
const centre = { x: 300, y: 250 };
// Spaced on an ellipse taller than it is wide, so each label clears the tile below it.
const services = ["Calendar", "Reminders", "Contacts", "Mail", "Notes", "Messages"].map((name, index) => {
  const angle = ((165 - index * 30) * Math.PI) / 180;
  return { name, glyph: name.toLowerCase(), x: Math.round(centre.x + 165 * Math.cos(angle)), y: Math.round(centre.y - 212 * Math.sin(angle)) };
});
---

<div aria-hidden="true" class="relative h-[172px] overflow-hidden select-none sm:h-[300px]">
  <!-- Drawn at 600×300 and centred; on a phone it's shrunk whole, keeping the same arrangement. -->
  <div class="absolute top-0 left-1/2 h-[300px] w-[600px] origin-top -translate-x-1/2 scale-[0.57] sm:scale-100">
    <svg viewBox="0 0 600 300" class="absolute inset-0 size-full overflow-visible">
      {
        services.map((service) => (
          <line x1={centre.x} y1={centre.y} x2={service.x} y2={service.y} stroke="white" stroke-opacity="0.28" stroke-width="2" stroke-linecap="round" />
        ))
      }
    </svg>

    {
      services.map((service) => (
        <div class="absolute flex w-20 -translate-x-1/2 -translate-y-8 flex-col items-center" style={`left: ${service.x}px; top: ${service.y}px`}>
          <div class="grid size-16 place-items-center rounded-[18px] bg-white text-[#0b5ccc] shadow-[0_8px_18px_rgba(0,30,90,0.3)]">
            <svg viewBox="0 0 24 24" class="size-8 fill-none stroke-current stroke-[2.2] [stroke-linecap:round] [stroke-linejoin:round]">
              {service.glyph === "calendar" && (
                <>
                  <rect x="3.5" y="5" width="17" height="15" rx="3" />
                  <path d="M3.5 9.5h17M8 3v4M16 3v4" />
                  <path d="M8 13.5h.01M12 13.5h.01M16 13.5h.01M8 17h.01M12 17h.01" stroke-width="2.8" />
                </>
              )}
              {service.glyph === "reminders" && (
                <>
                  <circle cx="5.5" cy="6.5" r="1.4" fill="currentColor" />
                  <circle cx="5.5" cy="12" r="1.4" fill="currentColor" />
                  <circle cx="5.5" cy="17.5" r="1.4" fill="currentColor" />
                  <path d="M10 6.5h10M10 12h10M10 17.5h7" />
                </>
              )}
              {service.glyph === "contacts" && (
                <>
                  <circle cx="12" cy="8.5" r="3.6" fill="currentColor" />
                  <path d="M4.5 20c.8-4 3.8-6 7.5-6s6.7 2 7.5 6z" fill="currentColor" />
                </>
              )}
              {service.glyph === "mail" && (
                <>
                  <rect x="3" y="5.5" width="18" height="13" rx="2.5" />
                  <path d="M3.8 7l8.2 6 8.2-6" />
                </>
              )}
              {service.glyph === "notes" && (
                <>
                  <rect x="4.5" y="3.5" width="15" height="17" rx="2.5" />
                  <path d="M8 8.5h8M8 12h8M8 15.5h5" />
                </>
              )}
              {service.glyph === "messages" && (
                <path d="M12 4.5c4.7 0 8.5 3 8.5 6.8s-3.8 6.8-8.5 6.8c-1 0-2-.1-2.9-.4L5 19.5l1.1-3.6C4.5 14.6 3.5 13 3.5 11.3c0-3.8 3.8-6.8 8.5-6.8z" fill="currentColor" />
              )}
            </svg>
          </div>
          <span class="mt-1.5 text-[12px] font-semibold">{service.name}</span>
        </div>
      ))
    }

    <!-- The app, rising from the bottom edge: a figure on an exercise bike, white on the tile's blue, so it stands
         apart from the white tiles of what it reaches -->
    <div
      class="absolute grid size-32 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-[30px] bg-linear-to-b from-[#5fa8ff] to-[#0b5ccc] text-white shadow-[0_16px_30px_rgba(0,30,90,0.4),inset_0_1px_0_rgba(255,255,255,0.45)] ring-1 ring-white/25"
      style={`left: ${centre.x}px; top: ${centre.y}px`}
    >
      <svg viewBox="0 0 24 24" class="size-16 fill-none stroke-current stroke-[1.8] [stroke-linecap:round] [stroke-linejoin:round]">
        <!-- Rider: head, back leaning to the bars, arm to the bars, leg down to the pedal -->
        <circle cx="10.2" cy="3.6" r="1.9" fill="currentColor" stroke="none" />
        <path d="M9.6 6.4l-1.8 6h4.6l1.4 4.4" stroke-width="2.2" />
        <path d="M9.4 7.6l3.6 2.4 3.3-.9" />
        <!-- Bike: seat post, frame to the bars, flywheel and stand -->
        <path d="M6.5 12.4h3M8 12.4l1.6 7.1M16.3 9.1l1.2 6.2" />
        <circle cx="17.5" cy="16.6" r="2.6" />
        <path d="M5 21.2h14.5M9.6 19.5l-1.2 1.7M17.5 19.2l1 2" />
      </svg>
    </div>
  </div>
</div>

---
import { Image } from "astro:assets";
import readingQueue from "../../assets/icons/reading-queue.png";
---

<!--
  For "Apps that use your Mac": a browser window running off the tile's top right, a cursor on the button an
  app wants to press, and Lamp's real approval alert in front (the same wording and buttons as Store.confirm).
  Drawn in HTML so it stays sharp; the cursor glides to the button once, when the tile scrolls into view.
-->
<div data-uses-mac aria-hidden="true" class="relative h-56 overflow-hidden select-none sm:h-80">
  <!-- On a phone the whole scene is drawn at desktop size and shrunk, so it keeps the same arrangement. -->
  <div class="absolute inset-0 h-[143%] w-[143%] origin-top-left scale-[0.7] sm:h-full sm:w-full sm:scale-100">
  <!-- The browser -->
  <div class="absolute top-8 left-8 w-[40rem] overflow-hidden rounded-xl bg-white text-ink shadow-[0_30px_60px_rgba(0,0,0,0.35)] ring-1 ring-white/10 sm:left-24">
    <div class="flex h-10 items-center gap-2 border-b border-black/5 bg-[#f6f6f7] px-4">
      <span class="size-3 rounded-full bg-[#ff5f57]"></span>
      <span class="size-3 rounded-full bg-[#febc2e]"></span>
      <span class="size-3 rounded-full bg-[#28c840]"></span>
      <span class="mx-auto h-6 w-72 rounded-md bg-black/5 text-center text-[11px] leading-6 text-black/45">fieldnotes.design/quiet-onboarding</span>
    </div>
    <div class="px-10 pt-7 pb-10">
      <p class="text-[10px] font-semibold tracking-wider text-black/40 uppercase">Field Notes on Design</p>
      <p class="mt-2 font-serif text-[22px] leading-tight font-semibold">The Quiet Onboarding:<br />Teaching Without Tutorials</p>
      <div class="mt-4 space-y-2">
        <div class="h-2 w-[26rem] rounded bg-black/8"></div>
        <div class="h-2 w-[24rem] rounded bg-black/8"></div>
        <div class="h-2 w-[20rem] rounded bg-black/8"></div>
      </div>
      <span
        data-target
        class="relative mt-6 inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-1.5 text-[12px] font-medium text-white ring-4 ring-sky-400/0 transition-[box-shadow] duration-500"
      >
        Download PDF
        <!-- The pointer rests on the button (its tip at the top-left of the box), and travels there. -->
        <svg
          data-pointer
          viewBox="0 0 24 24"
          class="absolute top-1/2 left-[84%] size-6 -translate-x-[5px] -translate-y-[3px] drop-shadow-[0_2px_3px_rgba(0,0,0,0.4)] transition-transform duration-[1200ms] ease-[cubic-bezier(.3,.7,.2,1)]"
        >
          <path d="M5 3l14 8.5-6.2 1.3 3.6 6.9-2.6 1.3-3.6-6.9L5 18.6z" fill="#000" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </div>

  <!-- Lamp's approval, as a Mac alert -->
  <div
    data-alert
    class="absolute top-12 right-6 w-64 rounded-2xl bg-[#ececee]/95 p-4 text-center text-ink shadow-[0_24px_50px_rgba(0,0,0,0.45)] ring-1 ring-black/10 backdrop-blur-xl sm:right-10"
  >
    <Image src={readingQueue} alt="" width={52} height={52} densities={[1, 2]} class="mx-auto size-13" />
    <p class="mt-2 text-[14px] leading-snug font-bold">Reading Queue wants to use Safari</p>
    <p class="mt-1 text-[12px] leading-snug text-black/60">Click “Download PDF”, to add this article to your queue.</p>
    <div class="mt-3 space-y-1.5 text-[13px] font-medium">
      <div class="rounded-md bg-[#0a84ff] py-1 text-white">Allow</div>
      <div class="rounded-md bg-white py-1 shadow-[0_0.5px_1.5px_rgba(0,0,0,0.25)]">Allow All for This Task</div>
      <div class="rounded-md bg-white py-1 shadow-[0_0.5px_1.5px_rgba(0,0,0,0.25)]">Don't Allow</div>
    </div>
  </div>
  </div>
</div>

<script>
  // The pointer starts lower down and glides onto the button the first time the tile comes into view, which
  // then lights up as if hovered. Without motion (or JavaScript), it simply rests on the button.
  for (const scene of document.querySelectorAll<HTMLElement>("[data-uses-mac]")) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
    const pointer = scene.querySelector<SVGElement>("[data-pointer]")!;
    const target = scene.querySelector<HTMLElement>("[data-target]")!;
    pointer.style.transitionDuration = "0s";
    pointer.style.transform = "translate(150px, 24px)";
    pointer.getBoundingClientRect();   // settle the starting place before transitions come back
    pointer.style.transitionDuration = "";
    new IntersectionObserver((entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      setTimeout(() => {
        pointer.style.transform = "";
        setTimeout(() => target.classList.replace("ring-sky-400/0", "ring-sky-400/40"), 1100);
      }, 300);
    }, { threshold: 0.6 }).observe(scene);
  }
</script>

<!--
  For "Apps that use your Mac": a browser window running off the tile's right edge, and a pointer that glides
  to the page's Download PDF button and clicks it, the first time the tile scrolls into view. Drawn in HTML so
  it stays sharp. Without motion (or JavaScript) the pointer simply rests on the button.
-->
<div data-uses-mac aria-hidden="true" class="relative h-[196px] overflow-hidden select-none sm:h-[280px]">
  <!-- On a phone the whole scene is drawn at desktop size and shrunk, so it keeps the same arrangement. -->
  <div class="absolute inset-0 h-[143%] w-[143%] origin-top-left scale-[0.7] sm:h-full sm:w-full sm:scale-100">
    <!-- Lined up with the words below: their 40px inset (32px on a phone, where the scene is shrunk to 70%). -->
    <div class="absolute top-4 left-[46px] w-[40rem] overflow-hidden rounded-xl bg-white text-ink shadow-[0_30px_60px_rgba(0,0,0,0.35)] ring-1 ring-white/10 sm:left-10">
      <div class="flex h-10 items-center gap-2 border-b border-black/5 bg-[#f6f6f7] px-4">
        <span class="size-3 rounded-full bg-[#ff5f57]"></span>
        <span class="size-3 rounded-full bg-[#febc2e]"></span>
        <span class="size-3 rounded-full bg-[#28c840]"></span>
        <span class="mx-auto h-6 w-72 rounded-md bg-black/5 text-center text-[11px] leading-6 text-black/45">fieldnotes.design/quiet-onboarding</span>
      </div>
      <div class="px-10 pt-5 pb-10">
        <p class="text-[10px] font-semibold tracking-wider text-black/40 uppercase">Field Notes on Design</p>
        <p class="mt-2 font-serif text-[22px] leading-tight font-semibold">The Quiet Onboarding:<br />Teaching Without Tutorials</p>
        <div class="mt-4 space-y-2">
          <div class="h-2 w-[26rem] rounded bg-black/8"></div>
          <div class="h-2 w-[24rem] rounded bg-black/8"></div>
          <div class="h-2 w-[20rem] rounded bg-black/8"></div>
        </div>
        <span
          data-target
          class="relative mt-5 inline-flex items-center gap-1.5 rounded-full bg-ink px-4 py-1.5 text-[12px] font-medium text-white ring-4 ring-sky-400/0 transition-[box-shadow] duration-500"
        >
          Download PDF
          <!-- Where the pointer's tip lands (84% across, halfway down): the click's ripple starts here. -->
          <span data-ripple class="absolute top-1/2 left-[84%] size-8 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-sky-400 opacity-0"></span>
          <svg
            data-pointer
            viewBox="0 0 24 24"
            class="absolute top-1/2 left-[84%] size-6 -translate-x-[5px] -translate-y-[3px] drop-shadow-[0_2px_3px_rgba(0,0,0,0.4)] transition-transform duration-[1200ms] ease-[cubic-bezier(.3,.7,.2,1)]"
          >
            <path d="M5 3l14 8.5-6.2 1.3 3.6 6.9-2.6 1.3-3.6-6.9L5 18.6z" fill="#000" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  // Once the tile is in view: the pointer glides in from lower right, then clicks, with the button pressing in,
  // a ripple spreading from the pointer's tip, and the button keeping a highlight after.
  for (const scene of document.querySelectorAll<HTMLElement>("[data-uses-mac]")) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) continue;
    const pointer = scene.querySelector<SVGElement>("[data-pointer]")!;
    const target = scene.querySelector<HTMLElement>("[data-target]")!;
    const ripple = scene.querySelector<HTMLElement>("[data-ripple]")!;
    pointer.style.transitionDuration = "0s";
    pointer.style.transform = "translate(150px, 24px)";
    pointer.getBoundingClientRect();   // settle the starting place before transitions come back
    pointer.style.transitionDuration = "";

    const click = () => {
      target.animate([{ scale: "1" }, { scale: "0.94" }, { scale: "1" }], { duration: 280, easing: "ease-out" });
      pointer.animate([{ scale: "1" }, { scale: "0.88" }, { scale: "1" }], { duration: 280, easing: "ease-out" });
      ripple.animate(
        [{ opacity: 0.9, scale: "0.3" }, { opacity: 0, scale: "1.8" }],
        { duration: 600, easing: "cubic-bezier(.2,.7,.3,1)" },
      );
      target.classList.replace("ring-sky-400/0", "ring-sky-400/40");
    };

    new IntersectionObserver((entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      setTimeout(() => {
        pointer.style.transform = "";
        setTimeout(click, 1250);
      }, 300);
    }, { threshold: 0.6 }).observe(scene);
  }
</script>

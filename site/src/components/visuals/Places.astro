---
// For the homepage's places section: four wishes, each on the device it lives on, named by where that is in a
// home rather than by what runs it. The Mac comes first, where wishes are made; then a phone, a watch and the TV.
// The pictures are drawn as the ideas page's are (scripts/idea-art), in src/assets/places/, and the cards are the
// "but" cards' above, so the section reads as more of the same.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { together } from "../../lib/text";

const pictures = import.meta.glob<ImageMetadata>("../../assets/places/*.jpg", { eager: true, import: "default" });
const places = [
  { picture: "desk", where: "On your desk", what: "What's in the fridge, by when it goes off." },
  { picture: "pocket", where: "In your pocket", what: "Two big buttons, so Biscuit gets one dinner." },
  { picture: "wrist", where: "On your wrist", what: "A week-long step race with your brother." },
  { picture: "living", where: "In the living room", what: "A family quiz, with everyone's phone as a buzzer." },
].map((place) => ({ ...place, image: pictures[`../../assets/places/${place.picture}.jpg`] }));
---

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {
    places.map((place) => (
      <li class="overflow-hidden rounded-[22px] bg-panel">
        {place.image && (
          <Image
            src={place.image}
            alt=""
            widths={[400, 720]}
            sizes="(min-width: 1024px) 270px, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            class="aspect-[3/2] w-full object-cover"
          />
        )}
        <div class="px-6 pt-4 pb-6">
          <p class="text-lg leading-snug font-semibold">{place.where}</p>
          <p class="mt-1 text-[15px] leading-snug text-muted">{together(place.what)}</p>
        </div>
      </li>
    ))
  }
</ul>

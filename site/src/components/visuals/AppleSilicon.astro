---
// For "Smart, and private": a system on a chip as the M-series ones look from above, though not Apple's
// artwork: a dark substrate with gold pads along its edges, a glossy silicon die whose blocks show through
// (big and small cores, a graphics grid, and the neural engine glowing warm like the lamp), the two memory
// chips beside it, and gold traces running off to the tile's edge. Drawn in SVG on a 544×280 canvas, the
// tile's size on a laptop (five columns of ten), the chip 40px in to line up with the words.
const pkg = { x: 40, y: 40, size: 200 };
const die = { x: 58, y: 58, w: 110, h: 164 };
const memory = [
  { x: 180, y: 58, w: 48, h: 76 },
  { x: 180, y: 146, w: 48, h: 76 },
];
const performance = [0, 1, 2, 3].map((i) => ({ x: 68 + (i % 2) * 46, y: 68 + Math.floor(i / 2) * 34, w: 42, h: 30 }));
const efficiency = [0, 1, 2, 3].map((i) => ({ x: 68 + i * 23, y: 138, w: 19, h: 16 }));
const graphics = Array.from({ length: 8 }, (_, i) => ({ x: 68 + (i % 4) * 23, y: 160 + Math.floor(i / 4) * 14, w: 19, h: 11 }));
const neural = Array.from({ length: 8 }, (_, i) => ({ x: 70 + i * 11.2, y: 194, w: 8, h: 18 }));
// Pads along all four edges of the substrate, and traces off its right side.
const pads = Array.from({ length: 18 }, (_, i) => pkg.x + 12 + i * ((pkg.size - 24) / 17));
const traces = Array.from({ length: 9 }, (_, i) => pkg.y + 24 + i * 19);
---

<div aria-hidden="true" class="relative h-[176px] overflow-hidden select-none sm:h-[280px]">
  <!-- On a phone the scene is drawn at the desktop tile's size and shrunk, keeping the same arrangement. -->
  <div class="absolute inset-0 h-[159%] w-[159%] origin-top-left scale-[0.63] sm:h-full sm:w-full sm:scale-100">
    <svg viewBox="0 0 544 280" class="h-[280px] w-[544px]">
      <defs>
        <linearGradient id="soc-substrate" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#2b302d" />
          <stop offset="1" stop-color="#161917" />
        </linearGradient>
        <linearGradient id="soc-die" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#3a3436" />
          <stop offset="0.55" stop-color="#1d1a1c" />
          <stop offset="1" stop-color="#2a2527" />
        </linearGradient>
        <linearGradient id="soc-sheen" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity="0.22" />
          <stop offset="0.4" stop-color="#fff" stop-opacity="0.04" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="soc-memory" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2a2a2c" />
          <stop offset="1" stop-color="#121213" />
        </linearGradient>
        <linearGradient id="soc-gold" x1="0" x2="1">
          <stop offset="0" stop-color="#e7b35a" stop-opacity="0.85" />
          <stop offset="1" stop-color="#e7b35a" stop-opacity="0" />
        </linearGradient>
        <filter id="soc-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" /></filter>
      </defs>

      <!-- Set 20px low, so the chip sits midway between the tile's top and its heading (40px of padding above the
           words). -->
      <g transform="translate(0 20)">
      <!-- Traces off the right edge, with a jog each -->
      {
        traces.map((y, i) => (
          <path
            d={`M${pkg.x + pkg.size} ${y} H${pkg.x + pkg.size + 30 + (i % 3) * 16} l18 ${(i - 4) * 4} H544`}
            fill="none"
            stroke="url(#soc-gold)"
            stroke-width="1.6"
          />
        ))
      }

      <!-- Substrate, with gold pads on its edges -->
      <rect x={pkg.x} y={pkg.y} width={pkg.size} height={pkg.size} rx="14" fill="url(#soc-substrate)" stroke="rgba(255,255,255,0.12)" />
      {
        pads.map((p) => (
          <>
            <rect x={p - 2} y={pkg.y + 4} width="4" height="5" rx="1" fill="#d9a24a" opacity="0.9" />
            <rect x={p - 2} y={pkg.y + pkg.size - 9} width="4" height="5" rx="1" fill="#d9a24a" opacity="0.9" />
            <rect x={pkg.x + 4} y={p - 2} width="5" height="4" rx="1" fill="#d9a24a" opacity="0.9" />
            <rect x={pkg.x + pkg.size - 9} y={p - 2} width="5" height="4" rx="1" fill="#d9a24a" opacity="0.9" />
          </>
        ))
      }

      <!-- The die: glossy silicon with its blocks showing through -->
      <rect x={die.x} y={die.y} width={die.w} height={die.h} rx="4" fill="url(#soc-die)" stroke="rgba(255,255,255,0.18)" />
      {
        [...performance, ...efficiency, ...graphics].map((b) => (
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="2" fill="rgba(255,255,255,0.055)" stroke="rgba(255,255,255,0.1)" stroke-width="0.8" />
        ))
      }
      <rect x="68" y="190" width="90" height="26" rx="3" fill="rgba(242,157,31,0.12)" stroke="rgba(242,157,31,0.5)" stroke-width="0.8" />
      {neural.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="1.5" fill="#ffb84d" filter="url(#soc-blur)" opacity="0.8" />)}
      {neural.map((b) => <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="1.5" fill="#ffc46b" />)}
      <rect x={die.x} y={die.y} width={die.w} height={die.h} rx="4" fill="url(#soc-sheen)" />

      <!-- Two memory chips, matte, with a faint mark printed on each -->
      {
        memory.map((m) => (
          <>
            <rect x={m.x} y={m.y} width={m.w} height={m.h} rx="3" fill="url(#soc-memory)" stroke="rgba(255,255,255,0.1)" />
            <circle cx={m.x + 7} cy={m.y + 7} r="1.6" fill="rgba(255,255,255,0.35)" />
            <rect x={m.x + 10} y={m.y + m.h / 2 - 6} width={m.w - 20} height="2.5" rx="1" fill="rgba(255,255,255,0.18)" />
            <rect x={m.x + 14} y={m.y + m.h / 2 + 1} width={m.w - 28} height="2.5" rx="1" fill="rgba(255,255,255,0.12)" />
          </>
        ))
      }
      </g>
    </svg>
  </div>
</div>

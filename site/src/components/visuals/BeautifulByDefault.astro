---
import { Image } from "astro:assets";
import habitStreaks from "../../assets/apps/habit-streaks.png";
---

<!--
  For "Beautiful by default": the real Habit Streaks window at actual size, running off the tile's right and
  bottom edges. In the screenshot the window's top-left corner sits 76px across and 38px down at actual size,
  which the picture's offsets account for, leaving the window 36px in from the tile's edges. As tall as the
  illustration beside it, so the pair lines up.
-->
<div aria-hidden="true" class="relative h-[300px] overflow-hidden select-none">
  <!-- On a phone the scene is drawn at the desktop tile's size and shrunk, keeping the same arrangement. -->
  <div class="absolute inset-0 h-[127%] w-[127%] origin-top-left scale-[0.79] sm:h-full sm:w-full sm:scale-100">
    <Image
      src={habitStreaks}
      alt=""
      width={1152}
      densities={[1, 2]}
      class="absolute top-[-2px] left-[-40px] w-[1152px] max-w-none"
    />
  </div>
</div>

---
import { REPO_URL, RELEASES_URL } from "../lib/releases";

// Where the project lives, as an open source project's README ends: the source, its releases and how to take part.
const links = [
  { href: REPO_URL, label: "Source" },
  { href: RELEASES_URL, label: "Releases" },
  { href: "/changelog", label: "Changelog" },
  { href: `${REPO_URL}/blob/main/CONTRIBUTING.md`, label: "Contributing" },
  { href: `${REPO_URL}/blob/main/SECURITY.md`, label: "Security" },
  { href: `${REPO_URL}/issues`, label: "Issues" },
];

interface Props {
  /** One quiet line, for under the homepage's windows. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<!-- The bottom of every page: a thin rule, then plain lines in mono; or, compact, the same in one line. -->
{compact ? (
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-muted-ink">
    {links.map((link) => <a href={link.href} class="underline underline-offset-4 hover:text-tape">{link.label}</a>)}
    <span>MIT license</span>
  </div>
) : (
<footer class="border-t border-tape/20 bg-paper text-tape">
  <div class="mx-auto flex max-w-[var(--frame)] flex-col gap-3 px-4 pt-8 pb-14 font-mono text-sm sm:px-6">
    <ul class="flex flex-wrap gap-x-5 gap-y-1">
      {links.map((link) => <li><a href={link.href} class="underline underline-offset-4 hover:no-underline">{link.label}</a></li>)}
    </ul>
    <p class="text-muted-ink">Lamp is free and open source, under the <a href={`${REPO_URL}/blob/main/LICENSE`} class="underline underline-offset-4">MIT license</a>.</p>
  </div>
</footer>
)}

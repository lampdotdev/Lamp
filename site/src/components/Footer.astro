<!--
  The bottom of every page, on the ink of the homepage's last section, so it reads as that section's end: the lamp's
  beam there (index.astro's .beam, a box 46% wide at the right whose stripes are cut to a cone) reaches the bottom
  across the last 80% of its box, and its stripes carry on straight down through here, the same box cut the same
  way. The words keep to the left of them.
-->
<footer class="relative -mt-px overflow-hidden bg-tape text-white">
  <span class="footer-beam absolute inset-y-0 right-0 w-[46%] [clip-path:inset(0_0_0_20%)]" aria-hidden="true"></span>
  <div class="relative mx-auto flex max-w-[80rem] flex-col items-start gap-2 px-4 pt-6 pb-16 text-sm sm:px-6">
    <p class="text-[1.375rem] font-black tracking-[-0.04em]">lamp</p>
    <p>Made by <a href="https://roocode.com" class="font-bold underline underline-offset-4">Roo Code</a></p>
    <p class="text-[#cfc8b2]">© {new Date().getFullYear()}</p>
  </div>
</footer>

<style>
  .footer-beam {
    background: linear-gradient(90deg, #1f6fc4 0 16.6%, #1f8a4a 0 33.3%, #f6b81c 0 50%, #f08a1c 0 66.6%, #e2402a 0 83.3%, #d23778 0);
  }
</style>

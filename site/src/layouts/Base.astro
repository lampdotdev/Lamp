---
import "../styles/global.css";
import MenuBar from "../components/MenuBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** The 1200×630 card shown where the page is shared, from public/. */
  image?: string;
}

const { title, description, image } = Astro.props;
const imageURL = image && new URL(image, Astro.site).href;
// This page's own address on the site, whichever page it is.
const pageURL = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f2ecda" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,800&family=JetBrains+Mono:wght@500;700&family=Permanent+Marker&display=swap" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    {imageURL && <meta property="og:image:width" content="1200" />}
    {imageURL && <meta property="og:image:height" content="630" />}
    {imageURL && <meta property="og:image:alt" content="A magic lamp on a desert dune under a glowing moon and a starry sky." />}
    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
  </head>
  <body class="font-sans">
    <MenuBar />
    <slot />
    <Footer />
    <script>
      import { startAnalytics, track } from "../lib/analytics";
      startAnalytics();
      // Every Download button says where it sits, including ones added to the page later.
      document.addEventListener("click", (event) => {
        const link = (event.target as Element | null)?.closest?.("a[data-download-place]");
        if (link) track("download_clicked", { place: link.getAttribute("data-download-place") ?? "" });
      });
    </script>
  </body>
</html>

---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** The 1200×630 card shown where the page is shared, from public/. */
  image?: string;
}

const { title, description, image } = Astro.props;
const imageURL = image && new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    {imageURL && <meta property="og:image:width" content="1200" />}
    {imageURL && <meta property="og:image:height" content="630" />}
    {imageURL && <meta property="og:image:alt" content="A magic lamp on a desert dune under a glowing moon and a starry sky." />}
    <meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
  </head>
  <body class="font-sans">
    <slot />
    <script>
      import { startAnalytics, track } from "../lib/analytics";
      startAnalytics();
      // Every Download button says where it sits, including ones added to the page later.
      document.addEventListener("click", (event) => {
        const link = (event.target as Element | null)?.closest?.("a[data-download-place]");
        if (link) track("download_clicked", { place: link.getAttribute("data-download-place") ?? "" });
      });
    </script>
  </body>
</html>

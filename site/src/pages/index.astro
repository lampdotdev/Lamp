---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Carousel from "../components/Carousel.astro";
import DownloadButton from "../components/DownloadButton.astro";
import QuickLook from "../components/QuickLook.astro";
import FirstIdea from "../components/FirstIdea.astro";
import Bento, { type Point } from "../components/Bento.astro";
import { together } from "../lib/text";
import MakesTheCall from "../components/visuals/MakesTheCall.astro";
import DrawsOnDemand from "../components/visuals/DrawsOnDemand.astro";
import MakesSense from "../components/visuals/MakesSense.astro";
import FindsTheWords from "../components/visuals/FindsTheWords.astro";
import UsesYourMac from "../components/visuals/UsesYourMac.astro";
import BeautifulByDefault from "../components/visuals/BeautifulByDefault.astro";
import WorksWithYourMac from "../components/visuals/WorksWithYourMac.astro";
import ChangeItAnyTime from "../components/visuals/ChangeItAnyTime.astro";
import AppleSilicon from "../components/visuals/AppleSilicon.astro";
import ShareWithAnyone from "../components/visuals/ShareWithAnyone.astro";
import icon from "../assets/AppIcon.png";
// The welcome's porcelain lamp, rendered for the hero card in Blender (see RELEASING.md).
import heroLamp from "../assets/hero-lamp-reflection.png";
import anthropic from "../assets/logos/anthropic.png";
import openai from "../assets/logos/openai.png";
import openrouter from "../assets/logos/openrouter.png";
import ollama from "../assets/logos/ollama.png";
import lmstudio from "../assets/logos/lmstudio.png";

// Lamp's window just after building an app, and windows of apps it built, all taken from Lamp Dev with
// made-up data (see RELEASING.md). The iPhone and iPad apps are the simulator's screens in a drawn frame.
import lampWindow from "../assets/lamp.png";
import readingQueue from "../assets/apps/reading-queue.png";
import neonBricks from "../assets/apps/neon-bricks.png";
import habitStreaks from "../assets/apps/habit-streaks.png";
import paletteStudio from "../assets/apps/palette-studio.png";
import trailLog from "../assets/apps/trail-log.png";
import tripTab from "../assets/apps/trip-tab.png";
import mealPlanner from "../assets/apps/meal-planner.png";

const lampWindowLarge = await getImage({ src: lampWindow, width: lampWindow.width, format: "webp" });

const apps = [
  {
    image: readingQueue,
    name: "Reading Queue",
    request: "I'm building an icon system and running design reviews, and my reading pile is out of control. I drop in PDFs and links, and it ranks them by what matters for that work, with one line on each and why it's worth my time.",
    alt: "Reading Queue: articles ranked against what you're working on, with why each one matters",
  },
  {
    image: trailLog,
    name: "Trail Log",
    request: "Trail Log: every Lake District hike I do this year, with the route on a map, the distance, the climb, how long it took and my notes from the day, and this year's totals at the top, for bragging.",
    alt: "Trail Log on two iPhones: this year's hikes with their totals, and Helvellyn's route on a map with its distance, climb and notes",
  },
  {
    image: neonBricks,
    name: "Neon Bricks",
    request: "The brick breaker I played as a kid, but glowing neon, the way I always pictured it: a paddle on the mouse or arrow keys, a few levels, power-ups and my own high score table.",
    alt: "Neon Bricks: a glowing brick breaker game mid-play",
  },
  {
    image: mealPlanner,
    name: "Meal Planner",
    request: "Meal Planner for the four of us: the week side by side, breakfast, lunch and dinner cards I can drag between days, and a shopping list built from the week's meals, by aisle, to tick off at the shop.",
    alt: "Meal Planner on an iPad: a week of family meals and the shopping list for it",
  },
  {
    image: habitStreaks,
    name: "Habit Streaks",
    request: "The five habits I keep promising myself (a morning walk, 20 pages, meditating, water, no phone after 10pm), with streaks, the last three months as a heat map and a chart of each week.",
    alt: "Habit Streaks: daily habits with streaks, a three-month heat map and a weekly chart",
  },
  {
    image: tripTab,
    name: "Trip Tab",
    request: "Trip Tab: our Lisbon weekend, four of us. I add who paid for what and who it was for, and it shows everyone's balance and the fewest payments to settle up, so nobody has to do the maths.",
    alt: "Trip Tab on two iPhones: four friends' balances after a weekend in Lisbon, and the three payments that settle up",
  },
  {
    image: paletteStudio,
    name: "Palette Studio",
    request: "I design for fun and keep losing my colour ideas. I describe a mood or drop in a photo from a trip, and it makes a five-colour palette with names, hex codes and a contrast check for text.",
    alt: "Palette Studio: a five-colour palette called Lisbon Afternoon with names, hex codes and contrast scores",
  },
];

// Icons Lamp made for apps it built, in one row under "Real apps. Really yours.", all the same size. The row is centred
// on the tile and wider than it, so it runs off both edges; at the tile's full width (1104px) the 136px icons
// and 24px gaps put each edge through the middle of an icon. The order mixes the colours, as several are
// purple. A name missing from src/assets/icons/ is skipped.
const icons = import.meta.glob<ImageMetadata>("../assets/icons/*.png", { eager: true, import: "default" });
const shelf = [
  "mine-1", "mine-6", "trip-tab", "mine-3", "mine-8", "habit-streaks", "mine-2", "palette-studio", "trail-log",
  "mine-4", "neon-bricks", "mine-10", "meal-planner", "mine-9", "mine-5", "reading-queue",
].flatMap((name) => icons[`../assets/icons/${name}.png`] ?? []);

// AI as part of what an app does, not only how Lamp builds it: four things it can do inside an app, in two rows
// split 6/4 and 4/6. Judgment leads, as it's the one people don't expect; drawing beside it for the games and
// the stories. No providers, models or technical words here: which AI answers is the section further down.
const smarts: Point[] = [
  {
    title: "Makes the call.",
    text: "Quick judgments, all day long. Which app is slowing your Mac down, and the setting that fixes it.",
    tile: "bento:col-span-6 bg-linear-to-b from-indigo-from to-indigo-to text-white",
    visual: MakesTheCall,
  },
  {
    title: "Draws on demand.",
    text: "Pictures for a bedtime story, characters for a game, art for anything.",
    tile: "bento:col-span-4 bg-linear-to-b from-coral-from to-coral-to text-white",
    visual: DrawsOnDemand,
  },
  {
    title: "Makes sense of anything.",
    text: "Sums up the long thread, explains the small print, finds what matters in a pile of PDFs.",
    tile: "bento:col-span-4 bg-linear-to-b from-teal-from to-teal-to text-white",
    visual: MakesSense,
  },
  {
    title: "Finds the words.",
    text: "Drafts the reply, names the thing, makes it friendlier.",
    tile: "bento:col-span-6 bg-linear-to-br from-butter-from to-butter-to",
    visual: FindsTheWords,
  },
];

// The rest of the features as a bento box, rows split 6/4, 5/5, 4/6, telling a story: what you get (row one),
// what it can do (row two, the two dark tiles), and living with it (row three). Each tile has a strong colour of
// its own, close to the app icons'.
const points: Point[] = [
  {
    title: "Gorgeous by default.",
    text: "Native controls, proper menus and shortcuts, and an icon of its own. Feels made-in-Cupertino, never made-by-AI.",
    tile: "bento:col-span-6 bg-linear-to-br from-amber-from to-amber-to",
    visual: BeautifulByDefault,
  },
  {
    title: "Plugged into your day.",
    text: "Your calendar, reminders, contacts and notifications, on your Mac and your iPhone. On the Mac, Mail, Notes and Messages too.",
    tile: "bento:col-span-4 bg-linear-to-b from-sky-from to-sky-to text-white",
    visual: WorksWithYourMac,
    below: true,
  },
  {
    title: "Apps that do the clicking.",
    text: "An app can use your other apps to get things done, your browser included, signed in as you.",
    tile: "bento:col-span-5 bg-night bg-[radial-gradient(120%_90%_at_80%_0%,#5b4be0_0%,transparent_65%)] text-white",
    visual: UsesYourMac,
  },
  {
    title: "Smart, and private.",
    text: "Apps read text in pictures, understand speech and translate, right on your Mac. Lamp can even run the AI on your Mac's own chip.",
    tile: "bento:col-span-5 bg-graphite-deep bg-[radial-gradient(90%_75%_at_50%_25%,#8f4c0c_0%,transparent_72%)] text-white",
    visual: AppleSilicon,
    centre: true,
  },
  {
    title: "Selfish, not stingy.",
    // A line break in the text starts a new line on the tile.
    text: "Made for you, but happy to share.\nSend a Mac app by AirDrop, message, email, even Slack. Your friend gets their own copy, and Lamp shows them what it does.",
    tile: "bento:col-span-6 bg-linear-to-b from-lilac-from to-lilac-to text-white",
    visual: ShareWithAnyone,
  },
  {
    title: "Change your mind. No regrets.",
    text: "Ask for a change whenever you like. Lamp saves a version each time, so you can try anything and go back.",
    tile: "bento:col-span-4 bg-linear-to-b from-mint-from to-mint-to",
    visual: ChangeItAnyTime,
    centre: true,
  },
];

// Signed-in subscriptions first, then a key, then the models that run on the Mac itself, in the app's own
// order. Lamp's built-in models (Native Mac AI) run on Metal; they get a chip, like the app's Providers tab,
// since Apple's logo isn't ours to use.
const providers = [
  { logo: anthropic, name: "Claude" },
  { logo: openai, name: "ChatGPT" },
  { logo: openrouter, name: "OpenRouter" },
  { name: "Apple Metal" },
  { logo: ollama, name: "Ollama" },
  { logo: lmstudio, name: "LM Studio" },
];

// On the page the last sentence gets a line of its own; elsewhere (search results, link previews) it's one run.
// The list stays on one line.
const pitch = "Made by you, for nobody else. Tools,\u00a0apps,\u00a0games.";
const noCode = "For Mac and iOS, no coding needed.";
const description = `${pitch} ${noCode}`;
---

<Base title="Lamp: turn your wishes into selfish software" description={description} image="/og.jpg">
  <!--
    Full-width bands that alternate white and light grey, in the manner of Apple's product pages, each with the
    content in the same centred column. Tiles take the other shade from the band they sit on.
  -->
  <main>
    <!-- The hero sits in a card of its own across the window, like the tiles below, to set it apart from what
         follows. -->
    <div class="px-2 pt-2 sm:px-3 sm:pt-3">
    <!--
      Opens like Apple's product pages: the card starts as tall as the window with the icon large in its middle,
      then the card shrinks to its own height as the icon settles and the words come up under it, the button
      appears, and the porcelain lamp (the welcome's, rendered for this card) slides up from the bottom edge. Once, on load, and not at all for people who've asked for less
      motion (global.css).
    -->
    <section class="hero-card hero-sky relative flex flex-col items-center overflow-hidden rounded-[28px] px-6 pt-14 text-center sm:pt-16">
      <div class="hero-icon">
        <Image
          src={icon}
          alt=""
          width={88}
          height={88}
          densities={[1, 2]}
          loading="eager"
          class="size-18 drop-shadow-[0_10px_22px_rgba(217,122,6,0.28)] sm:size-22"
        />
      </div>
      <!-- The name small under the icon, as Apple labels a product, and the promise as the page's heading. -->
      <div class="hero-words flex flex-col items-center">
        <p class="mt-3 text-[15px] font-semibold tracking-tight">Lamp</p>
        <!-- Full size from xl. It breaks after "wishes", so "selfish software" keeps a line of its own: each half
             is a block from sm. On a phone, too narrow for either half, it wraps as it likes. -->
        <h1 class="mt-5 font-display text-5xl leading-[1.05] font-bold tracking-tight sm:text-6xl xl:text-7xl">
          <span class="sm:inline-block">Lamp turns your wishes</span> <span class="sm:inline-block">into selfish&nbsp;software.</span>
        </h1>
        <p class="mt-5 max-w-[50rem] text-xl leading-[1.4] font-semibold text-muted">{together(pitch)}<br />{together(noCode)}</p>
      </div>
      <div class="hero-button relative z-10 mt-9"><DownloadButton place="hero" /></div>
      <!-- As wide as the card allows, but no taller than leaves the whole card in the window: the words above
           take about 530px with the space under them, and the render is 2.98 times as wide as it is tall. -->
      <Image
        src={heroLamp}
        alt=""
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        class="hero-lamp pointer-events-none mt-6 h-auto max-w-none select-none sm:mt-4"
        style="width: min(100%, calc((100svh - 530px) * 2.98))"
      />
    </section>

    </div>

    <FirstIdea />

    <section>
      <div class="mx-auto max-w-6xl px-4 pt-20 sm:px-6 sm:pt-24">
        <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">For work. For play. For&nbsp;you.</h2>
        <p class="mx-auto mt-4 max-w-[50rem] text-center text-xl leading-[1.4] font-semibold text-muted">
          {together("Something for the task that bugs you, or a game for when you're done.")}<br />{together("Each of these started as a single wish:")}
        </p>
        <Carousel slides={apps} />
      </div>
    </section>

    <section class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">Feels like a genie, not&nbsp;like&nbsp;work.</h2>
      <p class="mx-auto mt-4 max-w-[50rem] text-center text-xl leading-[1.4] font-semibold text-muted">
        {together("Download it. Make a wish. No account, minimal setup.")}<br />{together("Then just chat to make it perfectly yours.")}
      </p>
      <Image
        src={lampWindow}
        alt="Lamp having just built a Reading Queue app: the request, the plan and a picture of the finished app"
        widths={[640, 1024, 1600, 2048]}
        sizes="(min-width: 1152px) 1104px, 100vw"
        loading="lazy"
        data-quicklook={lampWindowLarge.src}
        class="mx-auto mt-10 h-auto w-full"
      />
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">Made with AI&nbsp;inside.</h2>
      <p class="mx-auto mt-4 max-w-[50rem] text-center text-xl leading-[1.4] font-semibold text-muted">
        {together("AI doesn't just make your software.")}<br />{together("It can be part of what it does.")}
      </p>
      <div class="mt-10"><Bento points={smarts} /></div>
    </section>

    <section class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <Bento points={points}>
          <div class="overflow-hidden rounded-[28px] bg-page pt-12 text-center bento:col-span-10 sm:pt-16">
            <h3 class="px-8 font-display text-3xl font-bold tracking-tight sm:text-5xl">Real apps. Really&nbsp;yours.</h3>
            <p class="mx-auto mt-4 max-w-[50rem] px-8 text-xl leading-[1.4] text-muted">
              {together("In your Applications folder, your menu bar, your Dock and on your Home Screen.")}<br />{together("No browser tab, no subscription, no chat to come back to.")}
            </p>
            <div aria-hidden="true" class="mt-8 pb-10 sm:mt-10 sm:pb-12">
              <div class="relative left-1/2 flex w-max -translate-x-1/2 gap-4 sm:gap-6">
                {
                  shelf.map((icon) => (
                    <Image
                      src={icon}
                      alt=""
                      width={136}
                      height={136}
                      densities={[1, 2]}
                      class="size-24 drop-shadow-[0_12px_18px_rgba(0,0,0,0.14)] sm:size-34"
                    />
                  ))
                }
              </div>
            </div>
          </div>
      </Bento>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Use the AI you already&nbsp;have.</h2>
      <p class="mx-auto mt-4 max-w-[50rem] text-xl leading-[1.4] font-semibold text-muted">
        {together("Lamp is free. It builds with your Claude or ChatGPT subscription, a key from more than a dozen AI providers, or a model that runs right on your Mac.")}
      </p>
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        {
          providers.map((provider) => (
            <li class="flex items-center gap-2.5 text-muted">
              {
                provider.logo ? (
                  <Image src={provider.logo} alt="" width={24} height={24} densities={[1, 2]} class="size-6 opacity-70" />
                ) : (
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current stroke-[1.6] opacity-90">
                    <rect x="6" y="6" width="12" height="12" rx="2.5" />
                    <rect x="9.5" y="9.5" width="5" height="5" rx="1" />
                    <path d="M9 2.5v3.5M12 2.5v3.5M15 2.5v3.5M9 18v3.5M12 18v3.5M15 18v3.5M2.5 9H6M2.5 12H6M2.5 15H6M18 9h3.5M18 12h3.5M18 15h3.5" stroke-linecap="round" />
                  </svg>
                )
              }
              <span class="font-medium">{provider.name}</span>
            </li>
          ))
        }
      </ul>
      </div>
    </section>

    <section class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 py-24 text-center sm:px-6 sm:py-28">
      <Image src={icon} alt="" width={96} height={96} densities={[1, 2]} class="mx-auto size-24 drop-shadow-[0_12px_24px_rgba(217,122,6,0.25)]" />
      <h2 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">Go on, be&nbsp;selfish.</h2>
      <div class="mt-9"><DownloadButton place="footer" /></div>
      </div>
    </section>
  </main>

  <QuickLook />

  <footer class="bg-panel py-10 text-center text-sm text-muted">
    <p>Made by <a href="https://roocode.com" class="text-ink hover:underline">Roo Code</a> · © {new Date().getFullYear()}</p>
  </footer>
</Base>

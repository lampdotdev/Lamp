---
import { Image, getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import { together } from "../lib/text";
import { DOWNLOAD_URL } from "../lib/download";
import type { Sleeve, Tape } from "../lib/tapes";
import newYork from "../assets/starters/newyork.png";
import homeHQ from "../assets/starters/homehq.png";
import remote from "../assets/starters/universalremote.png";
import phone from "@phosphor-icons/core/assets/duotone/device-mobile-duotone.svg?raw";
import laptop from "@phosphor-icons/core/assets/duotone/laptop-duotone.svg?raw";
import tv from "@phosphor-icons/core/assets/duotone/television-simple-duotone.svg?raw";
import oldTV from "@phosphor-icons/core/assets/duotone/television-duotone.svg?raw";
import streamer from "@phosphor-icons/core/assets/duotone/monitor-play-duotone.svg?raw";
import cast from "@phosphor-icons/core/assets/duotone/screencast-duotone.svg?raw";
import tablet from "@phosphor-icons/core/assets/duotone/device-tablet-duotone.svg?raw";
import controller from "@phosphor-icons/core/assets/duotone/game-controller-duotone.svg?raw";
import speaker from "@phosphor-icons/core/assets/duotone/speaker-hifi-duotone.svg?raw";
import picture from "@phosphor-icons/core/assets/duotone/image-duotone.svg?raw";

// The page sells remixing: start from something someone made, change it while it runs, and put it on what's in
// the house. It's dressed as home video: tape labels, the stripes on their sleeves, cream paper. Apps and games get
// the same weight, so it never reads as a site for games only. Every example is a real starter
// (Resources/Starters), with its own pictures and the changes it suggests.
const pitch = "Start from an app or a game someone made. Say what to change and watch it change while it runs. Then put it on your TV.";
const description = `Remixable software. ${pitch} No code.`;

// The screenshots the 3D tapes print on their labels (lib/tapes.ts).
const shot = async (src: ImageMetadata) => (await getImage({ src, width: 1200, format: "webp" })).src;
const [newYorkShot, homeHQShot] = await Promise.all([shot(newYork), shot(homeHQ)]);

// New York's sleeve in the hero, with the changes its starter suggests on the back.
const sleeve: Sleeve = {
  title: "New York", by: "Made by Mr.doob", kind: "Game · 3D", line: "Walk, drive, bike or fly", shot: newYorkShot,
  tweaks: ["make it a snowy winter night", "make it a lot more fun", "move the city to the Moon"],
};

// The stack beside "Change it live": each original, a remix of it, and a blank tape.
const tapes: Tape[] = [
  { look: "original", stripes: "warm", title: "Home HQ", caption: "THE ORIGINAL · AN APP FOR THE FAMILY", shot: homeHQShot },
  { look: "marker", title: "On the kitchen frame", caption: "REMIXED BY YOU", side: "B1", ink: "#b8264f", shot: homeHQShot, treat: "frame" },
  { look: "original", stripes: "cool", title: "New York", caption: "THE ORIGINAL · A GAME BY MR.DOOB", side: "A1", shot: newYorkShot },
  { look: "marker", title: "Snowy winter night", caption: "REMIXED BY YOUR FRIEND", side: "B2", ink: "#2a6fb0", shot: newYorkShot, treat: "snow" },
  { look: "blank", title: "your idea here…", caption: "" },
];

// What Lamp can put something on today, as people name their things, from what a visitor most likely has to what
// they least likely have. Only what a kind of app or a shipped device integration really reaches
// (Sources/Lamp/Places, Resources/Devices); a device Lamp only reaches in a simulator isn't listed. Each icon's
// fill is one of the sleeve's colors, as if printed in two colors.
const devices = [
  { name: "iPhone & iPad", icon: phone },
  { name: "Your Mac", icon: laptop },
  { name: "Samsung TVs", icon: tv },
  { name: "Roku", icon: streamer },
  { name: "LG TVs", icon: oldTV },
  { name: "Fire TV & Google TV", icon: cast },
  { name: "Android phones & tablets", icon: tablet },
  { name: "Sonos", icon: speaker },
  { name: "Xbox", icon: controller },
  { name: "Photo frames", icon: picture },
];

// The shelf's stripes, in a box 100 wide and 100 tall that's stretched over the space beside the gallery and out to
// the window's left edge: each runs straight down to the bend, then sweeps out to the left, the last one on the right
// staying put and the rest fanning out off the page.
const floor = ["#f6b81c", "#f08a1c", "#e2402a", "#d23778", "#5a2d8c", "#2c3592", "#1f6fc4", "#1f8a4a"].map((color, i, all) => {
  const [width, start, bend] = [7, 30, 50];
  const anchor = start + width * all.length;
  const flare = (x: number) => anchor + (x - anchor) * 3.5;
  const [left, right] = [start + width * i, start + width * (i + 1)];
  const d = `M${left} 0 L${left} ${bend} C${left} ${bend + 26} ${flare(left)} ${bend + 30} ${flare(left)} 100`
    + ` L${flare(right)} 100 C${flare(right)} ${bend + 30} ${right} ${bend + 26} ${right} ${bend} L${right} 0 Z`;
  return { color, d };
});

// The shelf: three starters, one of each kind, each with the change its starter suggests first.
const shelf = [
  { image: homeHQ, by: "by Lamp", name: "Home HQ", tweak: "put it on the photo frame", stripe: "stripe-cool", ink: "text-[#8fc2ff]" },
  { image: newYork, by: "by Mr.doob", name: "New York", tweak: "move it to the Moon", stripe: "stripe-warm", ink: "text-[#ff8fb8]" },
  { image: remote, by: "by Lamp", name: "Universal Remote", tweak: "add a bedtime button", stripe: "stripe-warm", ink: "text-[#ff8fb8]", tall: true },
];
---

<Base title="Lamp: remixable software" description={description} image="/og.jpg">
  <main class="tape-page overflow-x-clip bg-paper text-tape">
    <!-- Hero: plain white type on the sleeve's stripes, run diagonally across the whole window like a film
         maker's box. The pale bands are kept to the corners, so the words only ever sit on ones they read on. -->
    <section id="top" class="technicolor overflow-hidden">
    <div class="mx-auto flex max-w-[80rem] flex-wrap items-center gap-10 px-4 pt-28 pb-12 text-white sm:px-6 sm:pt-28 sm:pb-12">
      <div class="flex min-w-0 flex-[1_1_32rem] flex-col items-start gap-7">
        <h1 class="mb-2 text-[clamp(3.25rem,8.4vw,8rem)] leading-[0.9] font-black tracking-[-0.05em]">Remixable software.</h1>
        <p class="max-w-[30ch] text-2xl leading-[1.4] font-semibold">{together(pitch)}</p>
        <div class="flex flex-wrap gap-3.5">
          <a href={DOWNLOAD_URL} data-download-place="hero" class="tape-button tape-button-paper">Download for Mac</a>
          <a href="#shelf" class="tape-button tape-button-outline-white">See what's on the shelf</a>
        </div>
      </div>

      <!-- New York's sleeve, in 3D once lib/tapes.ts has drawn it: it leans toward the pointer and turns over when
           clicked. Until then, and without WebGL, the same sleeve flat. -->
      <div class="tape-host h-[36rem] min-w-0 flex-[1_1_30rem] sm:h-[44rem]" data-tape-sleeve data-sleeve={JSON.stringify(sleeve)}>
        <div class="tape-fallback flex h-full items-center justify-center">
          <figure class="flex w-full max-w-[26rem] -rotate-2 flex-col overflow-hidden border-2 border-tape bg-[#f7f2e3] text-tape shadow-[10px_10px_0_var(--color-tape)]">
            <figcaption class="flex flex-col gap-1 px-7 pt-6 pb-4">
              <span class="text-[1.375rem] font-extrabold italic">Made by Mr.doob</span>
              <span class="text-[clamp(2.75rem,6vw,4rem)] leading-[0.9] font-black tracking-[-0.04em]">New York</span>
            </figcaption>
            <Image src={newYork} alt="New York: a yellow taxi on a Manhattan avenue at golden hour" widths={[420, 840]} sizes="420px" loading="eager" class="block h-auto w-full border-y-2 border-tape" />
            <div class="stripe-warm h-20" aria-hidden="true"></div>
            <p class="px-7 pt-4 pb-5 text-xl font-extrabold italic">Walk, drive, bike or fly</p>
          </figure>
        </div>
        <button type="button" class="tape-control" data-turn>Turn New York's sleeve over</button>
      </div>
    </div>
    </section>

    <!-- Change it live: the stack of tapes, in 3D once lib/tapes.ts has drawn it. A tape that's clicked flies out and shows
         the screenshot on its label. The originals have printed spines; the remixes are written on in marker, and
         the last is blank. -->
    <section id="remix" class="mx-auto flex max-w-[80rem] flex-wrap items-center gap-14 px-4 py-24 sm:px-6">
      <div class="tape-host order-last h-[26rem] min-w-0 flex-[1_1_37.5rem] sm:h-[34rem] lg:order-none" data-tape-stack data-tapes={JSON.stringify(tapes)}>
        <div class="tape-fallback flex h-full flex-col justify-center gap-2">
          <div class="flex min-h-21 items-stretch border-2 border-l-0 border-tape bg-[#f7f2e3]">
            <span class="stripe-warm-across w-[calc(var(--edge)+30%)] min-w-24" aria-hidden="true"></span>
            <span class="flex flex-1 flex-col justify-center px-5 py-3">
              <span class="text-[2.125rem] leading-none font-black tracking-[-0.03em]">Home HQ</span>
              <span class="text-[13px] font-bold tracking-[0.15em]">THE ORIGINAL · AN APP FOR THE FAMILY</span>
            </span>
          </div>
          <div class="spine">
            <span class="spine-label">
              <span class="font-marker text-[1.375rem] leading-tight text-[#b8264f] sm:text-[1.875rem]">On the kitchen frame</span>
              <span class="text-[13px] font-bold tracking-wider">REMIXED BY YOU</span>
            </span>
          </div>
          <div class="spine gap-5 text-paper">
            <span class="stripe-cool h-12 w-[6.875rem] shrink-0" aria-hidden="true"></span>
            <span class="flex flex-1 flex-col">
              <span class="text-[1.75rem] leading-none font-black tracking-[0.02em] uppercase">New York</span>
              <span class="text-xs font-bold tracking-[0.15em] text-[#cfc8b2]">THE ORIGINAL · A GAME BY MR.DOOB</span>
            </span>
          </div>
          <div class="spine">
            <span class="spine-label">
              <span class="font-marker text-[1.375rem] leading-tight text-[#2a6fb0] sm:text-[1.875rem]">Snowy winter night</span>
              <span class="text-[13px] font-bold tracking-wider">REMIXED BY YOUR FRIEND</span>
            </span>
          </div>
          <div class="spine">
            <span class="spine-label spine-lined">
              <span class="font-marker text-[1.375rem] leading-tight text-[#6f6857] sm:text-[1.875rem]">your idea here…</span>
            </span>
          </div>
        </div>
        {tapes.map((tape, i) => tape.shot && <button type="button" class="tape-control" data-tape={i}>Show what's on {tape.title}</button>)}
      </div>
      <div class="flex min-w-0 flex-[1_1_22.5rem] flex-col gap-5">
        <h2 class="chip-heading text-[clamp(3rem,6vw,5.5rem)] leading-[0.92] font-black tracking-[-0.04em]">Change it live.</h2>
        <p class="max-w-[36ch] text-xl leading-normal">{together("Everything opens running. Ask for a change in the chat beside it, and it changes in front of you. The first version stays on the shelf.")}</p>
      </div>
    </section>

    <!-- From the shelf: real starters, each with the change it suggests, on the dark of a tape's box. -->
    <section id="shelf" class="bg-tape text-paper">
      <div class="mx-auto flex max-w-[80rem] flex-wrap gap-x-16 gap-y-12 px-4 py-28 sm:px-6">
        <div class="flex min-w-0 flex-[1_1_22rem] flex-col gap-6">
          <h2 class="text-[clamp(3.5rem,7vw,6.5rem)] leading-[0.9] font-black tracking-[-0.045em] text-white">From the shelf</h2>
          <p class="max-w-[30ch] text-xl leading-normal text-[#e6dfca]">{together("Start from one of these, or from anything someone shares with you.")}</p>
          <!-- The space under the words, beside the gallery, holds the sleeve's stripes: straight down, then sweeping
               out toward the viewer as they run off the bottom of the section and the window's left edge. -->
          <svg class="-mb-28 mt-6 min-h-64 w-[calc(100%+var(--edge))] flex-1 [margin-left:calc(-1*var(--edge))] max-lg:hidden" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {floor.map((stripe) => <path d={stripe.d} fill={stripe.color} />)}
          </svg>
        </div>
        <ul class="flex min-w-0 flex-[1_1_34rem] flex-col gap-10">
          {
            shelf.map((item) => (
              <li class="grid grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] items-center gap-6 max-sm:grid-cols-1">
                {item.tall ? (
                  <div class="flex aspect-[16/10] justify-center overflow-hidden bg-[#2e2b26]">
                    <Image src={item.image} alt="" widths={[300, 600]} sizes="300px" class="mt-3.5 h-[130%] w-auto" />
                  </div>
                ) : (
                  <Image src={item.image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 400px, 100vw" class="aspect-[16/10] w-full object-cover" />
                )}
                <div class="flex flex-col gap-1.5">
                  <span class:list={[item.stripe, "mb-2 h-2.5 w-16"]} aria-hidden="true"></span>
                  <h3 class="text-3xl leading-none font-black tracking-[-0.03em]">{item.name}</h3>
                  <span class="text-base font-bold text-[#cfc8b2] italic">{item.by}</span>
                  <span class:list={["font-marker text-xl", item.ink]}>{item.tweak}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- What it runs on, like the back of a box. -->
    <section id="devices" class="mx-auto flex max-w-[80rem] flex-col gap-10 px-4 py-24 sm:px-6">
      <h2 class="chip-heading max-w-[16ch] text-[clamp(3rem,6vw,5.5rem)] leading-[0.92] font-black tracking-[-0.04em]">Runs on what's already yours.</h2>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(15rem,1fr))] gap-x-8 gap-y-7">
        {
          devices.map((device, i) => (
            <li class="flex items-center gap-4 text-[1.375rem] leading-tight font-extrabold">
              <span class="device-icon size-14 shrink-0" style={`--tone: var(--stripe-${i % 8})`} aria-hidden="true" set:html={device.icon} />
              {device.name}
            </li>
          ))
        }
      </ul>
      <p class="max-w-[52ch] text-xl leading-normal">{together("Developer mode on the TV, the maker's sign-in and certificates, finding the box on your Wi‑Fi: Lamp walks you through the part where people usually give up.")}</p>
    </section>

    <!-- The lamp's light falls across the last section, in the sleeve's stripes, and on through the footer. -->
    <section id="download" class="relative overflow-hidden bg-tape text-paper">
      <span class="beam absolute top-0 right-0 h-full w-[46%] [clip-path:polygon(62%_0,82%_0,100%_100%,20%_100%)]" aria-hidden="true"></span>
      <div class="relative mx-auto flex max-w-[80rem] flex-col items-start gap-6 px-4 py-28 sm:px-6">
        <h2 class="max-w-[11ch] text-[clamp(3rem,6vw,5.5rem)] leading-[0.92] font-black tracking-[-0.04em]">Lamp runs on your Mac.</h2>
        <p class="max-w-[30ch] text-[1.375rem] text-[#e6dfca]">What you make runs on everything else. Free.</p>
        <a href={DOWNLOAD_URL} data-download-place="footer" class="tape-button tape-button-lit">Download for Mac</a>
        <p class="text-sm text-[#cfc8b2]">{together("For Macs with Apple Silicon and macOS 14 Sonoma or later")}</p>
      </div>
    </section>
  </main>
</Base>

<script>
  import { mountSleeve, mountStack } from "../lib/tapes";
  const sleeve = document.querySelector<HTMLElement>("[data-tape-sleeve]");
  const stack = document.querySelector<HTMLElement>("[data-tape-stack]");
  if (sleeve) mountSleeve(sleeve);
  if (stack) mountStack(stack);
</script>

<style>
  /* The sleeve's colors, warm to cool, and the bands they're printed in. */
  .tape-page {
    --stripe-0: #f6b81c; --stripe-1: #f08a1c; --stripe-2: #e2402a; --stripe-3: #d23778; --stripe-4: #5a2d8c;
    --stripe-5: #2c3592; --stripe-6: #1f6fc4; --stripe-7: #1f8a4a;
    /* How far it is from the content's edge to the window's, so the tapes can run off the page. */
    --edge: calc(max(0px, (100vw - 80rem) / 2) + 1rem);
    background-image: radial-gradient(rgb(60 40 10 / 0.07) 1px, transparent 1.4px), radial-gradient(rgb(60 40 10 / 0.05) 1px, transparent 1.4px);
    background-size: 5px 5px, 9px 9px;
    background-position: 0 0, 3px 4px;
  }
  @media (width >= 40rem) {
    .tape-page { --edge: calc(max(0px, (100vw - 80rem) / 2) + 1.5rem); }
  }
  .stripe-warm { background: linear-gradient(180deg, var(--stripe-0) 0 20%, var(--stripe-1) 0 40%, var(--stripe-2) 0 60%, var(--stripe-3) 0 80%, var(--stripe-4) 0); }
  .stripe-warm-across { background: linear-gradient(90deg, var(--stripe-0) 0 20%, var(--stripe-1) 0 40%, var(--stripe-2) 0 60%, var(--stripe-3) 0 80%, var(--stripe-4) 0); }
  .stripe-cool { background: linear-gradient(180deg, var(--stripe-7) 0 33.3%, var(--stripe-6) 0 66.6%, var(--stripe-2) 0); }
  .beam { background: linear-gradient(90deg, var(--stripe-6) 0 16.6%, var(--stripe-7) 0 33.3%, var(--stripe-0) 0 50%, var(--stripe-1) 0 66.6%, var(--stripe-2) 0 83.3%, var(--stripe-3) 0); }

  /* The hero's field: the stripes on the slant, from the yellow corner at the top left to the lime at the bottom
     right. Yellow, orange and lime fail white words, so they stay in the corners (a phone's hero is tall, so its
     slant reaches the words sooner and the corners are smaller); every band in between holds them at 3:1 or more,
     the words over them all being large. */
  .technicolor {
    --corner: 5%; --corner-edge: 11%;
    background: linear-gradient(150deg,
      var(--stripe-0) 0 var(--corner), var(--stripe-1) 0 var(--corner-edge), var(--stripe-2) 0 24%, var(--stripe-3) 0 35%,
      var(--stripe-4) 0 47%, var(--stripe-5) 0 59%, var(--stripe-6) 0 70%, #1e8fd6 0 80%, var(--stripe-7) 0 91%, #7cbf3a 0);
  }
  @media (width < 40rem) {
    .technicolor { --corner: 2%; --corner-edge: 5%; }
  }

  /* Headings keep plain ink; the stripes sit above them, as a tab cut from the sleeve. */
  .chip-heading::before {
    content: ""; display: block; width: 5.5rem; height: 1.25rem; margin-bottom: 1.5rem;
    background: linear-gradient(150deg, var(--stripe-0) 0 12%, var(--stripe-1) 0 24%, var(--stripe-2) 0 36%, var(--stripe-3) 0 48%,
      var(--stripe-4) 0 60%, var(--stripe-5) 0 72%, var(--stripe-6) 0 84%, var(--stripe-7) 0);
  }

  /* The 3D tapes run past their host's box, letting the pointer through (lib/tapes.ts). Once they're drawn, the flat version stays only for screen readers,
     and the buttons that turn the tapes over (otherwise unseen) show when a keyboard reaches them. */
  .tape-host { position: relative; }
  /* The stack keeps to its column, so a tape held up in front of it has room on both sides. */
  [data-tape-stack] { --edge: 0px; }
  .tape-host :global(.tape-canvas) { position: absolute; pointer-events: none; }
  .tape-host.is-3d > .tape-fallback, .tape-control {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }
  .tape-host:not(.is-3d) > .tape-control { display: none; }
  .tape-control:focus-visible {
    width: auto; height: auto; clip-path: none; left: 1rem; bottom: 1rem; z-index: 1; padding: 0.5rem 0.875rem;
    background: var(--color-paper); color: var(--color-tape); font-weight: 800; border-radius: 6px;
    outline: 3px solid var(--stripe-6); outline-offset: 2px;
  }

  /* An icon's outline in ink, and its fill printed in a color of the sleeve's. */
  .device-icon :global(svg) { width: 100%; height: 100%; color: var(--color-tape); }
  .device-icon :global(path[opacity]) { fill: var(--tone); opacity: 1; }

  .tape-button {
    display: inline-flex; align-items: center; min-height: 3.25rem; padding: 0 1.625rem; border-radius: 6px;
    background: var(--color-tape); color: var(--color-paper); font-size: 1.125rem; font-weight: 800;
    transition: translate 0.2s ease;
  }
  .tape-button:hover { translate: 0 -2px; }
  .tape-button:focus-visible { outline: 3px solid var(--stripe-6); outline-offset: 3px; }
  .tape-button-paper { background: var(--color-paper); color: var(--color-tape); }
  .tape-button-outline-white { background: transparent; color: #fff; box-shadow: inset 0 0 0 2px #fff; }
  /* On the dark last section, in the yellow of the lamp's light. */
  .tape-button-lit { background: var(--stripe-0); color: var(--color-tape); }

  .spine {
    display: flex; align-items: center; gap: 1rem; min-height: 5.25rem;
    padding: 0.5rem 1.125rem 0.5rem calc(var(--edge) + 1.125rem); background: #26241f;
  }
  .spine-label {
    flex: 1; display: flex; flex-direction: column; align-items: center; padding: 0.5rem 1.125rem;
    background: #f7f2e3; color: var(--color-tape); border-radius: 2px; text-align: center;
  }
  .spine-lined { background-image: repeating-linear-gradient(180deg, transparent 0 22px, rgb(42 111 176 / 0.35) 22px 23px); }
</style>

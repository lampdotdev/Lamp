---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import RemixDialog from "../components/RemixDialog.astro";
import Footer from "../components/Footer.astro";
import { together } from "../lib/text";
import { DOWNLOAD_URL } from "../lib/download";
import { STARTERS } from "../lib/starters";
import { REPO_URL, releases } from "../lib/releases";
import infoIcon from "@phosphor-icons/core/assets/bold/info-bold.svg?raw";
import startersIcon from "@phosphor-icons/core/assets/bold/squares-four-bold.svg?raw";
import devicesIcon from "@phosphor-icons/core/assets/bold/devices-bold.svg?raw";
import getIcon from "@phosphor-icons/core/assets/bold/download-simple-bold.svg?raw";
import faqIcon from "@phosphor-icons/core/assets/bold/question-bold.svg?raw";
import newIcon from "@phosphor-icons/core/assets/bold/sparkle-bold.svg?raw";
import darkIcon from "@phosphor-icons/core/assets/bold/moon-bold.svg?raw";
import sendIcon from "@phosphor-icons/core/assets/bold/arrow-up-bold.svg?raw";
import gameIcon from "@phosphor-icons/core/assets/bold/game-controller-bold.svg?raw";
import harderIcon from "@phosphor-icons/core/assets/bold/lightning-bold.svg?raw";
import nightIcon from "@phosphor-icons/core/assets/bold/cloud-rain-bold.svg?raw";
import biggerIcon from "@phosphor-icons/core/assets/bold/arrow-fat-lines-up-bold.svg?raw";
import undoIcon from "@phosphor-icons/core/assets/bold/arrow-u-up-left-bold.svg?raw";

// The homepage is a plain page that starts as a headline and a line under it, with a chat beside it, as Lamp's is
// beside an app: picking one of its requests adds that part to the page while you watch, the way Lamp changes an app
// while it runs. Nothing here asks a model; each request is written in advance with the part it adds. Without the
// script (and for search engines) every part is simply on the page, in order.
const headline = "Apps exactly the way you want them.";
// The line under it, one idea to a line.
const pitch = [
  "Start from scratch or an app someone made.",
  "Say what you’d change and watch it update in real time.",
  "Keep it for yourself or share with others.",
  "No code. Free and open source.",
];
const description = `${headline} ${pitch.join(" ")}`;

const pictures = import.meta.glob<ImageMetadata>("../assets/starters/*.png", { eager: true, import: "default" });
// A few starters, each with one of its changes under it to ask for. Every one is a real starter
// (Resources/Starters) with the picture and changes it ships with.
const SHOWN = ["newyork", "homehq", "thelittlehouse", "fireside", "localcrossings", "chores"];
const starters = SHOWN.map((id) => STARTERS.find((starter) => starter.id === id)!);

// What Lamp can put something on today, from what a visitor most likely has to what they least likely have. Only
// what a kind of app or a shipped device integration really reaches (Sources/Lamp/Places, Resources/Devices).
const devices: { name: string; brands?: string }[] = [
  { name: "iPhone and iPad" },
  { name: "Your Mac" },
  { name: "TVs", brands: "Samsung, LG, Roku, Fire TV, Google TV" },
  { name: "Android phones and tablets" },
  { name: "Sonos" },
  { name: "Xbox" },
  { name: "Photo frames" },
];

const latest = releases()[0];

const faq = [
  { q: "Do I need to know how to code?", a: "No. You say what you want in plain words, and Lamp writes the code, runs it and changes it as you ask." },
  { q: "Is it free?", a: "Lamp is free. Building uses an AI: your Claude or ChatGPT subscription, an OpenRouter key (you pay OpenRouter for what you use), or a model running on your Mac." },
  { q: "What do I need?", a: "A Mac with Apple Silicon and macOS 14 Sonoma or later." },
  { q: "Where does my stuff go?", a: "The apps you make and what's in them stay on your Mac. What you ask for goes to the AI you picked, and Lamp asks you before it reaches files outside an app's own folder." },
  { q: "Is it open source?", a: `Yes, under the MIT license. The source, issues and releases are on GitHub, with a guide for anyone who'd like to help.` },
];

// The sidebar's requests, each with what Lamp says once it's done and the part of the page it adds (`data-part`).
// "dark" changes the page's look instead of adding to it.
const asks = [
  { part: "what", ask: "Explain more what Lamp is", done: "Added what Lamp is.", icon: infoIcon, hue: 0.08 },
  { part: "starters", ask: "Show some apps people can start from", done: "Added six apps to start from, each with a change to try.", icon: startersIcon, hue: 0.36 },
  { part: "devices", ask: "Tell people which devices are supported", done: "Added the devices your apps can run on.", icon: devicesIcon, hue: 0.58 },
  { part: "get", ask: "Tell people how to get it", done: "Added the download, and how to build it yourself.", icon: getIcon, hue: 0.47 },
  { part: "faq", ask: "Add answers to common questions", done: "Added a few answers.", icon: faqIcon, hue: 0.93 },
  ...(latest ? [{ part: "new", ask: "Show what's new", done: `Added what's new in ${latest.version}.`, icon: newIcon, hue: 0.13 }] : []),
  { part: "dark", ask: "Make it dark", done: "Done: it's dark now.", icon: darkIcon, hue: 0.7 },
  { part: "game", ask: "I'm bored", done: "Added a little game. Click it to play, then ask me to change it while you run.", icon: gameIcon, hue: 0.83 },
  // Changes to the game while it plays, offered once it's there.
  { part: "change:double", ask: "Give me a double jump", done: "Done: jump again in the air. Your run goes on.", icon: biggerIcon, hue: 0.47, later: true },
  { part: "change:rain", ask: "Make it rain", done: "Done: it's raining on the rooftops.", icon: nightIcon, hue: 0.6, later: true },
  { part: "change:faster", ask: "Make it faster", done: "Done: faster. Hold on.", icon: harderIcon, hue: 0.02, later: true },
  { part: "change:lit", ask: "Light the whole street", done: "Done: every lamp on the street is on.", icon: newIcon, hue: 0.13, later: true },
];

/** A color given as Lamp's SwiftUI code gives one (hue, saturation, brightness), as CSS. */
function hsb(h: number, sat: number, bri: number) {
  const l = bri * (1 - sat / 2);
  const s = l === 0 || l === 1 ? 0 : (bri - l) / Math.min(l, 1 - l);
  return `hsl(${Math.round(h * 360)} ${Math.round(s * 100)}% ${Math.round(l * 100)}%)`;
}
/** An idea's icon lit, as Lamp lights one (IdeaIcon): its hue from pale at the top to deep at the bottom. */
const lit = (hue: number) => `linear-gradient(${hsb(hue, 0.45, 1)}, ${hsb(hue, 0.75, 0.88)})`;
---
---

<Base title="Lamp: apps exactly the way you want them" description={description} image="/og.jpg">
  <div class="home mx-auto max-w-[var(--frame)] min-h-[calc(100dvh-8rem)] px-4 pt-[calc(var(--menu-height)+3rem)] pb-16 sm:px-6 lg:pr-[calc(var(--sidebar)+3rem)] lg:pl-12">
    <!-- Where there's room, the page is an app's window, as Lamp's chat is beside one on the Mac: a title bar with the
         window's lights and the app's name, and the page scrolling inside it. On a phone it's simply the page. -->
    <div class="app-window">
    <div class="app-window-bar" aria-hidden="true"><span class="app-window-lights"><i></i><i></i><i></i></span><span class="app-window-title">Lamp Overview</span></div>
    <div data-scroller class="app-window-body">
    <main data-page class="mx-auto min-w-0 max-w-[46rem]">
      <section class="pb-10">
        <h1 class="max-w-[16ch] text-[clamp(2.5rem,6vw,4rem)] leading-[1] font-black tracking-[-0.04em] text-balance">{headline}</h1>
        <p class="mt-5 flex max-w-[46ch] flex-col gap-1 text-xl leading-normal">{pitch.map((line) => <span>{together(line)}</span>)}</p>
      </section>

      <!-- Lamp's chat, drawn as Lamp draws the chat beside an app. It
           comes right after the headline, so on a phone what it adds arrives under it; where there's room it stands
           apart, down the window's edge, and where it is in the page doesn't matter (LampSidebarKit): a title bar with Lamp's mark, what's
           asked in ink bubbles on the right and what Lamp says in paper ones on the left, the ideas to start from as
           tiles with gray icons that light up, and the round message box with its ink send button. Picking an idea
           sends it; a request of your own is something only Lamp can do. -->
      <aside data-chat aria-label="Change this page" class="chat" hidden>
        <div class="chat-panel">
          <div class="chat-head">
            <!-- The window's red light, as Lamp's chat has one: it puts the chat away. -->
            <button type="button" data-close class="close-light" aria-label="Close the chat" title="Close the chat"></button>
            <span class="lamp-mark" aria-hidden="true"><span class="lamp-glass"></span><span class="lamp-square"></span></span>
            <span class="min-w-0 flex-1 truncate">Editing Lamp Overview</span>
            <!-- Back one change, as Lamp's toolbar's Undo takes an app back to the version before. -->
            <button type="button" data-undo class="tool-button" aria-label="Undo" title="Undo the last change" disabled set:html={undoIcon} />
          </div>
          <div data-log class="chat-log" aria-live="polite"></div>
          <div data-asks class="chat-ideas">
              {asks.map((item, i) => (
              <button type="button" data-ask={item.part} data-done={item.done} hidden={"later" in item} class="chat-idea" style={`--lit: ${lit(item.hue)}; --i: ${i}`}>
                <span class="idea-icon" aria-hidden="true" set:html={item.icon} />
                <span data-ask-text>{item.ask}</span>
              </button>
            ))}
          </div>
          <form data-own class="chat-bar ph-no-capture">
            <label for="own" class="sr-only">Describe a change</label>
            <input id="own" data-own-text type="text" placeholder="Describe a change…" autocomplete="off" />
            <button type="submit" data-send aria-label="Send" disabled set:html={sendIcon} />
          </form>
        </div>
      </aside>
      <!-- The chat put away: Lamp's mark at the window's corner, to open it again. -->
      <button type="button" data-reopen class="chat-reopen" aria-label="Open the chat" title="Open the chat" hidden>
        <span class="lamp-mark" aria-hidden="true"><span class="lamp-glass"></span><span class="lamp-square"></span></span>
        Lamp
      </button>

      <section data-part="what" class="part">
        <h2 class="part-heading">What is Lamp?</h2>
        <p class="mt-3 text-lg leading-relaxed">{together("Lamp is a Mac app that makes apps and games for you. Say what you want, and it builds it; ask for more, and it changes it while it runs. No code.")}</p>
        <ul class="star-list mt-5">
          <li><strong>Start anywhere</strong> from scratch, from an app someone made, or from a friend's link</li>
          <li><strong>Change it live</strong> it changes in front of you, without a restart</li>
          <li><strong>Runs on your things</strong> your Mac, your phone, your TV, your Xbox</li>
          <li><strong>Uses the AI you have</strong> Claude, ChatGPT, OpenRouter or a model on your Mac</li>
          <li><strong>Free and open source</strong> MIT license, <a href={REPO_URL} class="underline underline-offset-4">on GitHub</a></li>
        </ul>
      </section>

      <section data-part="starters" class="part">
        <h2 class="part-heading">Apps to start from</h2>
        <p class="mt-3 text-lg leading-relaxed">{together("Every one of these comes with Lamp. Open one as it is, or say what you'd change.")}</p>
        <ul class="mt-6 flex flex-col">
          {starters.map((starter) => (
            <li class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 border-t border-tape/15 py-5 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-5">
              <Image src={pictures[`../assets/starters/${starter.id}.png`]} alt="" widths={[224, 320]} sizes="(min-width: 640px) 160px, 112px" class="aspect-[3/2] w-full border border-tape/30 object-cover" />
              <div class="min-w-0">
                <h3 class="text-lg font-extrabold">{starter.name} <span class="font-mono text-sm font-normal text-muted-ink">by {starter.by} · {starter.kind}</span></h3>
                <p class="mt-1">{starter.about}</p>
                <p class="mt-2 flex flex-wrap gap-x-4 font-mono text-sm">
                  {starter.page
                    ? <a href={starter.page} target="_blank" rel="noopener" class="underline underline-offset-4">Play it ↗</a>
                    : <a href={`/?starter=${starter.id}`} data-try-link class="underline underline-offset-4">Try it</a>}
                  <a href={`/?starter=${starter.id}`} data-remix-link class="underline underline-offset-4">Change it</a>
                  <span class="text-muted-ink">runs on {starter.places.join(", ")}</span>
                </p>
                <p class="mt-1 font-mono text-sm text-muted-ink">└ or ask: <a href={`/?starter=${starter.id}&ask=${encodeURIComponent(starter.remix)}`} data-remix-link class="text-tape underline underline-offset-4">{starter.remix}</a></p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section data-part="devices" class="part">
        <h2 class="part-heading">Put your apps on your TV, phone and more</h2>
        <ul class="star-list mt-5">
          {devices.map((device) => <li><strong>{device.name}</strong>{device.brands && <span class="text-muted-ink">{device.brands}</span>}</li>)}
        </ul>
      </section>

      <section data-part="get" class="part">
        <h2 class="part-heading">Get Lamp</h2>
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href={DOWNLOAD_URL} data-download-place="home" class="ink-button h-12 px-6 text-base">Download for Mac</a>
          <p class="font-mono text-sm text-muted-ink">{latest ? `Lamp ${latest.version} · ` : ""}free · macOS 14+ on Apple Silicon</p>
        </div>
        <p class="mt-6 text-lg">Or build it yourself:</p>
        <pre class="code mt-3"><code>xcode-select --install
git clone {REPO_URL}.git
cd Lamp && ./build.sh
open "build/Lamp Dev.app"</code></pre>
        <p class="mt-3 text-sm text-muted-ink">{together("A build from source is Lamp Dev, a separate app that sits beside the Lamp you download.")}</p>
      </section>

      <section data-part="faq" class="part">
        <h2 class="part-heading">Questions</h2>
        <div class="mt-4 flex flex-col">
          {faq.map((item) => (
            <details class="faq border-t border-tape/15 py-3">
              <summary class="cursor-pointer font-mono font-bold">{item.q}</summary>
              <p class="mt-2 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section data-part="game" class="part game-part">
        <!-- The game names itself and says how to play on its own board, so there's no heading over it. -->
        <div data-game tabindex="0" class="game-board" role="application" aria-label="Lamplighter, a game: press Space or tap to jump, and hold to jump higher"></div>
        <p data-game-status class="mt-2 font-mono text-sm text-muted-ink" aria-live="polite">Space or tap to jump · hold for higher</p>
      </section>

      {latest && (
        <section data-part="new" class="part">
          <h2 class="part-heading">New in {latest.version}</h2>
          <ul class="star-list mt-5">
            {latest.notes.slice(0, 4).map((note) => <li set:html={note} />)}
          </ul>
          <p class="mt-4 font-mono text-sm"><a href="/changelog" class="underline underline-offset-4">Every release →</a></p>
        </section>
      )}
    </main>
    </div>
    </div>
    <!-- Where the page is a window, the project's links are one line under it and the chat, not part of the app. -->
    <div class="window-footer"><Footer compact /></div>

  </div>
  <RemixDialog />
</Base>

<script>
  import { DOWNLOAD_URL } from "../lib/download";
  import { track } from "../lib/analytics";
  import type { Change } from "../lib/light-game";

  const chat = document.querySelector<HTMLElement>("[data-chat]")!;
  const page = document.querySelector<HTMLElement>("[data-page]")!;
  const log = chat.querySelector<HTMLElement>("[data-log]")!;
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // Too narrow for the chat beside the page: it's pinned to the foot of the window instead.
  const narrow = () => !matchMedia("(min-width: 64rem)").matches;
  // With the script, the page starts as only its headline; each part waits for its request.
  document.documentElement.toggleAttribute("data-asking", true);
  chat.hidden = false;

  const say = (who: "you" | "lamp", text: string) => {
    const line = document.createElement("p");
    line.className = who === "you" ? "chat-you" : "chat-lamp";
    line.textContent = text;
    log.append(line);
    log.scrollTop = log.scrollHeight;
    return line;
  };

  const ideas = chat.querySelector<HTMLElement>("[data-asks]")!;
  const undo = chat.querySelector<HTMLButtonElement>("[data-undo]")!;
  // The ideas in their first order, so one put back by Undo goes back where it was.
  const order = [...ideas.querySelectorAll<HTMLButtonElement>("[data-ask]")];
  // Every change made so far, newest last, for Undo.
  const done: { button: HTMLButtonElement; asked: string }[] = [];
  let toldAll = false;
  let busy = false;

  const askText = (button: HTMLButtonElement) => button.querySelector("[data-ask-text]")!;
  // The game, made the first time its part comes in; the changes to it are offered only while it's on the page.
  let game: Awaited<ReturnType<typeof import("../lib/light-game").createGame>> | undefined;
  const later = order.filter((button) => button.dataset.ask!.startsWith("change:"));
  const offerChanges = (on: boolean) => later.forEach((button) => { button.hidden = !on; });
  const toggleDark = (button: HTMLButtonElement) => {
    // Only the page's content goes dark, as an app would: not the site around it, and not Lamp's chat beside it.
    const content = document.querySelector<HTMLElement>(".home")!;
    const on = content.dataset.theme !== "dark";
    content.dataset.theme = on ? "dark" : "light";
    askText(button).textContent = on ? "Make it light again" : "Make it dark";
    return on;
  };
  // Once every part has been added, a word that the rest is Lamp's.
  // Whether anything has been added, so the headline can stand in the middle of an otherwise empty window.
  const marked = () => document.documentElement.toggleAttribute("data-has-part", !!page.querySelector(".part.is-shown"));
  const settle = () => {
    marked();
    const left = !!ideas.querySelector("[data-ask]:not([data-ask=dark])");
    if (!left && !toldAll) {
      toldAll = true;
      say("lamp", "That's everything on this page. In Lamp, you can ask for anything.");
    }
    undo.disabled = busy || !done.length;
  };

  order.forEach((button) => {
    button.addEventListener("click", () => {
      if (busy) return;
      busy = true;
      undo.disabled = true;
      const part = button.dataset.ask!;
      const dark = part === "dark";
      const change = part.startsWith("change:") ? (part.slice(7) as Change) : undefined;
      const asked = askText(button).textContent!.trim();
      track("home_change_asked", { part });
      chat.dataset.asked = "";
      say("you", asked);
      const working = say("lamp", "Working on it…");
      working.classList.add("chat-working");
      if (!dark) button.remove();
      // A change to the game goes in at once, while it plays: no rebuild, no restart, the score kept.
      if (change) {
        game?.set(change, true);
        working.classList.remove("chat-working");
        working.textContent = button.dataset.done!;
        done.push({ button, asked });
        busy = false;
        settle();
        return;
      }
      setTimeout(() => {
        working.classList.remove("chat-working");
        if (dark) {
          working.textContent = toggleDark(button) ? button.dataset.done! : "Done: it's light again.";
        } else {
          const section = page.querySelector<HTMLElement>(`[data-part="${part}"]`)!;
          // Each part goes in at the end of what's been asked for so far, in the order it was asked.
          page.append(section);
          section.classList.add("is-shown");
          if (part === "game") {
            // Phaser comes only now, the first time the game is asked for.
            // Its changes are offered once it's ready, so none is asked for before there's a game to take it.
            if (game) offerChanges(true);
            else import("../lib/light-game").then(({ createGame }) => createGame(section.querySelector("[data-game]")!, section.querySelector("[data-game-status]")!)).then((made) => {
              game = made;
              if (section.classList.contains("is-shown")) offerChanges(true);
            }).catch(() => {
              section.querySelector("[data-game-status]")!.textContent = "The game didn't load. Reload the page to try again.";
            });
          }
          if (!calm) section.classList.add("is-arriving");
          // The page goes all the way down to what came in, once it's laid out: its end just above whatever covers the
          // window's foot (the chat, on a phone).
          requestAnimationFrame(() => {
            // The room under the content first, for the chat as it now is, so the page can go that far.
            room();
            const box = section.getBoundingClientRect();
            if (!narrow()) {
              // Inside the window, which scrolls on its own: to the new part's end, just above the window's foot.
              const body = document.querySelector<HTMLElement>("[data-scroller]")!;
              const foot = body.getBoundingClientRect().bottom - 24;
              body.scrollTo({ top: body.scrollTop + box.bottom - foot, behavior: calm ? "auto" : "smooth" });
            } else {
              const under = innerHeight - covered() - 16;
              scrollTo({ top: scrollY + box.bottom - under, behavior: calm ? "auto" : "smooth" });
            }
          });
          working.textContent = button.dataset.done!;
        }
        done.push({ button, asked });
        busy = false;
        settle();
      }, calm ? 0 : 900);
    });
  });

  // Undo takes back the newest change: the part it added leaves the page and its idea goes back among the others, or
  // the page's look goes back to what it was. The chat keeps what was said and notes what was undone.
  undo.addEventListener("click", () => {
    const last = done.pop();
    if (!last || busy) return;
    track("home_change_undone", { part: last.button.dataset.ask! });
    const part = last.button.dataset.ask!;
    if (part === "dark") toggleDark(last.button);
    else if (part.startsWith("change:")) {
      game?.set(part.slice(7) as Change, false);
      const after = order.slice(order.indexOf(last.button) + 1).find((other) => other.isConnected);
      ideas.insertBefore(last.button, after ?? null);
    } else {
      if (part === "game") offerChanges(false);
      page.querySelector<HTMLElement>(`[data-part="${part}"]`)!.classList.remove("is-shown", "is-arriving");
      const after = order.slice(order.indexOf(last.button) + 1).find((other) => other.isConnected);
      ideas.insertBefore(last.button, after ?? null);
      toldAll = false;
    }
    const note = document.createElement("p");
    note.className = "chat-note";
    note.textContent = `Undid “${last.asked}”`;
    log.append(note);
    log.scrollTop = log.scrollHeight;
    settle();
  });

  // The red light puts the chat away and the page takes the window; Lamp's mark at the corner brings it back. On a
  // phone the chat shrinks into the mark as it goes and grows out of it as it comes back.
  const reopen = document.querySelector<HTMLButtonElement>("[data-reopen]")!;
  let tucking: ReturnType<typeof setTimeout> | undefined;
  const show = (open: boolean, focus = true) => {
    clearTimeout(tucking);
    const animate = narrow() && !calm;
    document.documentElement.toggleAttribute("data-chat-closed", !open);
    if (open) {
      reopen.hidden = true;
      chat.hidden = false;
      if (animate) {
        chat.classList.add("is-tucked");
        chat.getBoundingClientRect();
        chat.classList.remove("is-tucked");
      }
      if (focus) undo.focus({ preventScroll: true });
    } else {
      const finish = () => { chat.hidden = true; chat.classList.remove("is-tucked"); reopen.hidden = false; if (focus) reopen.focus({ preventScroll: true }); };
      if (!animate) return finish();
      chat.classList.add("is-tucked");
      tucking = setTimeout(finish, 300);
    }
  };
  chat.querySelector("[data-close]")!.addEventListener("click", () => show(false));
  reopen.addEventListener("click", () => show(true));

  // On a phone the page keeps room under its footer as tall as what covers the window's foot (the chat, or Lamp's mark
  // once it's put away), so everything, the footer included, can be scrolled clear of it.
  const covered = () => !narrow() ? 0 : chat.hidden ? reopen.getBoundingClientRect().height + 12 : chat.getBoundingClientRect().height + 10;
  const room = () => { document.body.style.paddingBottom = narrow() ? `${Math.ceil(covered() + 16)}px` : ""; };
  new ResizeObserver(room).observe(chat);
  addEventListener("resize", room);
  new MutationObserver(room).observe(reopen, { attributes: true, attributeFilter: ["hidden"] });
  room();


  // Where the page is a window, only the window scrolls: scrolling anywhere outside it and the chat (the background,
  // the menu bar) scrolls the window, so it reads as one long page.
  const scroller = document.querySelector<HTMLElement>("[data-scroller]")!;
  addEventListener("wheel", (event) => {
    if (narrow() || (event.target as Element).closest?.("[data-scroller], [data-chat], dialog")) return;
    scroller.scrollBy({ top: event.deltaY });
  }, { passive: true });

  // A request of its own: this page can only do what's above, so it says where it can be done.
  const own = chat.querySelector<HTMLFormElement>("[data-own]")!;
  const ownText = own.querySelector<HTMLInputElement>("[data-own-text]")!;
  const send = own.querySelector<HTMLButtonElement>("[data-send]")!;
  ownText.addEventListener("input", () => { send.disabled = !ownText.value.trim(); });
  own.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!ownText.value.trim()) return;
    // Only that someone asked for their own change, never what they wrote.
    track("home_own_change_asked", {});
    say("you", ownText.value.trim());
    ownText.value = "";
    send.disabled = true;
    const reply = say("lamp", "Good idea! On this page I only know a few tricks. In Lamp, that's exactly the kind of thing you'd ask for. ");
    const link = document.createElement("a");
    link.href = DOWNLOAD_URL;
    link.dataset.downloadPlace = "chat";
    link.textContent = "Get it for Mac";
    reply.append(link, ".");
  });

  // A starter's Try it and Change it open the dialog for getting it in place (RemixDialog.astro).
  document.querySelectorAll<HTMLAnchorElement>("[data-remix-link], [data-try-link]").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const name = link.hasAttribute("data-try-link") ? "lamp:try" : "lamp:remix";
      document.dispatchEvent(new CustomEvent(name, { detail: new URL(link.href).search }));
    });
  });
</script>


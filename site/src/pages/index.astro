---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import QuickLook from "../components/QuickLook.astro";
import FirstIdea from "../components/FirstIdea.astro";
import Bento, { type Point } from "../components/Bento.astro";
import { together } from "../lib/text";
import MakesTheCall from "../components/visuals/MakesTheCall.astro";
import DrawsOnDemand from "../components/visuals/DrawsOnDemand.astro";
import MakesSense from "../components/visuals/MakesSense.astro";
import FindsTheWords from "../components/visuals/FindsTheWords.astro";
import UsesYourMac from "../components/visuals/UsesYourMac.astro";
import BeautifulByDefault from "../components/visuals/BeautifulByDefault.astro";
import WorksWithYourMac from "../components/visuals/WorksWithYourMac.astro";
import ChangeItAnyTime from "../components/visuals/ChangeItAnyTime.astro";
import SignupsWidget from "../components/visuals/SignupsWidget.astro";
import Places from "../components/visuals/Places.astro";
import AppleSilicon from "../components/visuals/AppleSilicon.astro";
import ShareWithAnyone from "../components/visuals/ShareWithAnyone.astro";
import icon from "../assets/AppIcon.png";
import anthropic from "../assets/logos/anthropic.png";
import openai from "../assets/logos/openai.png";
import openrouter from "../assets/logos/openrouter.png";

// A window of an app Lamp built, taken from Lamp Dev with made-up data (see RELEASING.md), beside the chat that
// changes it.
import habitStreaks from "../assets/apps/habit-streaks.png";

// Icons Lamp made for apps it built, in one row under "No localhost shenanigans.", all the same size. The row is centred
// on the tile and wider than it, so it runs off both edges; at the tile's full width (1104px) the 136px icons
// and 24px gaps put each edge through the middle of an icon. The order mixes the colours, as several are
// purple. A name missing from src/assets/icons/ is skipped.
const icons = import.meta.glob<ImageMetadata>("../assets/icons/*.png", { eager: true, import: "default" });
const shelf = [
  "mine-1", "mine-6", "trip-tab", "mine-3", "mine-8", "habit-streaks", "mine-2", "palette-studio", "trail-log",
  "mine-4", "neon-bricks", "mine-10", "meal-planner", "mine-9", "mine-5", "reading-queue",
].flatMap((name) => icons[`../assets/icons/${name}.png`] ?? []);

// AI as part of what an app does, not only how Lamp builds it: four things it can do inside an app, in two rows
// split 4/6 and 6/4, each with AI as its subject. Making sense of things leads, as the most everyday; judgment, the
// one people don't expect, closes. No providers, models or technical words here: which AI answers is the section
// further down.
const smarts: Point[] = [
  {
    title: "AI makes sense of anything.",
    text: "It sums up the long thread, explains the small print, finds what matters in a pile of PDFs.",
    tile: "bento:col-span-4 bg-linear-to-b from-teal-from to-teal-to text-white",
    visual: MakesSense,
  },
  {
    title: "AI draws on demand.",
    text: "It makes pictures for a bedtime story, characters for a game, art for anything.",
    tile: "bento:col-span-6 bg-linear-to-b from-coral-from to-coral-to text-white",
    visual: DrawsOnDemand,
  },
  {
    title: "AI finds the words.",
    text: "It drafts the reply, names the thing, makes it friendlier.",
    tile: "bento:col-span-6 bg-linear-to-br from-butter-from to-butter-to",
    visual: FindsTheWords,
  },
  {
    title: "AI makes the call.",
    text: "It makes quick judgments all day long: which app is slowing your Mac down, and the setting that fixes it.",
    tile: "bento:col-span-4 bg-linear-to-b from-indigo-from to-indigo-to text-white",
    visual: MakesTheCall,
  },
];

// The rest of the features as a bento box, rows split 6/4, 5/5, 4/6, telling a story: what you get (row one),
// what it can do (row two, the two dark tiles), and living with it (row three). Each tile has a strong colour of
// its own, close to the app icons'.
const points: Point[] = [
  {
    title: "Gorgeous by default.",
    text: "Native controls, proper menus and shortcuts, and an icon of its own. Feels like it came with the device, never like AI made it.",
    tile: "bento:col-span-6 bg-linear-to-br from-amber-from to-amber-to",
    visual: BeautifulByDefault,
  },
  {
    title: "Plugged into your day.",
    text: "Your calendar, reminders, contacts and notifications, on your Mac and your iPhone. On the Mac, Mail, Notes and Messages too.",
    tile: "bento:col-span-4 bg-linear-to-b from-sky-from to-sky-to text-white",
    visual: WorksWithYourMac,
    below: true,
  },
  {
    title: "Apps that do the clicking.",
    text: "An app can use your other apps to get things done, your browser included, signed in as you.",
    tile: "bento:col-span-5 bg-night bg-[radial-gradient(120%_90%_at_80%_0%,#5b4be0_0%,transparent_65%)] text-white",
    visual: UsesYourMac,
  },
  {
    title: "Smart, and private.",
    text: "Apps read text in pictures, understand speech and translate, right on your Mac. Lamp can even run the AI on your Mac's own chip.",
    tile: "bento:col-span-5 bg-graphite-deep bg-[radial-gradient(90%_75%_at_50%_25%,#8f4c0c_0%,transparent_72%)] text-white",
    visual: AppleSilicon,
    centre: true,
  },
  {
    title: "Selfish, not stingy.",
    // A line break in the text starts a new line on the tile.
    text: "Made for you, but happy to share.\nSend a Mac app by AirDrop, message, email, even Slack. Your friend gets their own copy, and Lamp shows them what it does.",
    tile: "bento:col-span-6 bg-linear-to-b from-lilac-from to-lilac-to text-white",
    visual: ShareWithAnyone,
  },
  {
    title: "Try anything. Go back any time.",
    text: "Lamp saves a version with every change, so nothing you try is a mistake.",
    tile: "bento:col-span-4 bg-linear-to-b from-mint-from to-mint-to",
    visual: ChangeItAnyTime,
    centre: true,
  },
];

// Signed-in subscriptions first, then a key, then the models that run on the Mac itself, in the app's own
// order. Lamp's built-in models (Native Mac AI) run on Metal; they get a chip, like the app's Providers tab,
// since Apple's logo isn't ours to use.
const providers = [
  { logo: anthropic, name: "Claude" },
  { logo: openai, name: "ChatGPT" },
  { logo: openrouter, name: "OpenRouter" },
  { name: "Apple Metal" },
];

// The hero's line under the heading, and with "Little things made just for you." the page's description for search
// results and link previews.
const pitch = "Something for your work, one for your hikes, even a language tutor just for a single\u00a0speech.";
// Where wishes go, as places rather than platforms: "your phone" is an iPhone or an Android one alike.
const noCode = "For your Mac, your phone, even your TV. No coding needed, with AI you already have.";
const description = `Little things made just for you. ${pitch} ${noCode}`;

// Things people know with the one part only their owner would want: a reader knows what a dashboard is, and the
// part after "but" is what no company would ship. They go from the everyday to the wildly particular, so the reader
// is with them by the time they get strange, and each lives somewhere different (a widget, something that just
// runs, the iPad, a game), since what Lamp makes isn't only windows; the pictures say where without a word. They're
// the ideas page's for now, and the widget's is drawn, until each has one of its own.
const thumbs = import.meta.glob<ImageMetadata>("../assets/ideas/thumbs/*.jpg", { eager: true, import: "default" });
const buts = [
  { visual: SignupsWidget, known: "Your analytics dashboard,", but: "but only today's sign-ups against last week's, on your desktop." },
  { picture: "school-dates", known: "A family calendar,", but: "but it fills itself with every date buried in the school's emails." },
  { picture: "presenting", known: "Do Not Disturb,", but: "but it also hides your desktop and personal tabs when you share your screen." },
  { picture: "inbox-invaders", known: "Space Invaders,", but: "but the aliens are the emails you haven't answered." },
  { picture: "grandma-s-cards", known: "A recipe app,", but: "but it's Grandma's handwritten cards, her notes and all." },
  { picture: "whose-turn", known: "A chore chart,", but: "but fair over the month, on the old iPad in the kitchen." },
  { picture: "tooth-fairy-ledger", known: "A budget,", but: "but for the tooth fairy, so the twins never compare notes." },
  { picture: "has-biscuit-eaten", known: "A pet app,", but: "but just two big buttons by the bowl, so Biscuit stops getting two dinners." },
  { picture: "bedtime-stories", known: "A storybook,", but: "but a new one every night, starring your daughter Maya and her giraffe Kevin." },
  { picture: "our-street-the-board-game", known: "Monopoly,", but: "but it's your town, with Auntie Jo's house as Mayfair." },
  { picture: "campaign-notes", known: "Your D&D campaign notes,", but: "but they know which secrets the party hasn't found yet, and open each session with a dramatic recap." },
  { picture: "frank-the-snake", known: "Snake,", but: "but the snake is your dachshund, eating the socks he really steals." },
].map((item) => ({ ...item, image: item.picture ? thumbs[`../assets/ideas/thumbs/${item.picture}.jpg`] : undefined }));
---

<Base title="Lamp: turn your wishes into selfish software" description={description} image="/og.jpg">
  <!--
    Full-width bands that alternate white and light grey, in the manner of Apple's product pages, each with the
    content in the same centred column. Tiles take the other shade from the band they sit on.
  -->
  <main>
    <!-- The hero sits in a card of its own across the window, like the tiles below, to set it apart from what
         follows. -->
    <div class="px-2 pt-2 sm:px-3 sm:pt-3">
    <!--
      Opens like Apple's product pages: the card starts as tall as the window with the icon large in its middle,
      then the card shrinks to its own height as the icon settles and the words come up under it, and the button
      appears. Once, on load, and not at all for people who've asked for less motion (global.css). The card stops
      short of the window's bottom, so the next heading shows under it and it's plain there's more.
    -->
    <!-- Opened at a section (the menu bar's AI or Features from another page), the hero is already in place: while
         the card shrinks, everything under it moves up, and the section the browser went to would slide away. -->
    <script is:inline>if (location.hash) document.documentElement.classList.add("no-intro");</script>
    <section class="hero-card hero-sky relative flex flex-col items-center overflow-hidden rounded-[28px] px-6 pt-26 pb-14 text-center sm:pt-28 sm:pb-16">
      <div class="hero-icon">
        <Image
          src={icon}
          alt=""
          width={88}
          height={88}
          densities={[1, 2]}
          loading="eager"
          class="size-18 drop-shadow-[0_10px_22px_rgba(217,122,6,0.28)] sm:size-22"
        />
      </div>
      <!-- The name small under the icon, as Apple labels a product, and the promise as the page's heading. -->
      <div class="hero-words flex flex-col items-center">
        <p class="mt-3 text-[15px] font-semibold tracking-tight">Lamp</p>
        <!-- Full size from xl. From md it's always two lines, broken after "software", even where the window is wide
             enough for one; narrower, the browser balances the lines it needs. -->
        <h1 class="mt-5 font-display text-5xl leading-[1.05] font-bold tracking-tight text-balance sm:text-6xl xl:text-7xl">
          Lamp makes software<br class="hidden md:inline" /> crafted just for&nbsp;you.
        </h1>
        <p class="mt-5 max-w-[50rem] text-xl leading-[1.4] font-semibold text-muted">{together(pitch)} {together(noCode)}</p>
      </div>
      <div class="hero-button relative z-10 mt-9">
        <DownloadButton place="hero">
          <a
            slot="beside"
            href="/ideas"
            class="inline-flex h-[52px] items-center rounded-full bg-white/70 px-8 text-[17px] font-semibold text-ink shadow-[0_1px_3px_rgba(0,0,0,0.08)] ring-1 ring-black/10 backdrop-blur-sm transition duration-300 ease-[cubic-bezier(.34,1.56,.64,1)] hover:scale-[1.03] hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-graphite active:scale-[0.98]"
          >
            Explore ideas
          </a>
        </DownloadButton>
      </div>
    </section>

    </div>

    <!--
      The page goes from the familiar to the new: things people know with something only they'd want, getting
      stranger as they go, then that they change as they're used, then their own (the first-idea section).
    -->
    <section>
      <div class="mx-auto max-w-6xl px-4 pt-16 pb-14 sm:px-6">
        <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">Real apps. Uniquely&nbsp;yours.</h2>
        <p class="mx-auto mt-4 max-w-[50rem] text-center text-xl leading-[1.4] font-semibold text-muted">
          {together("Lots of little things, each doing things exactly your way.")}
        </p>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            buts.map((item) => (
              <li class="overflow-hidden rounded-[22px] bg-panel">
                {item.image ? (
                  <Image
                    src={item.image}
                    alt=""
                    widths={[400, 720]}
                    sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                    loading="lazy"
                    class="aspect-[3/2] w-full object-cover"
                  />
                ) : item.visual && <item.visual />}
                <div class="px-6 pt-4 pb-6">
                  <p class="text-lg leading-snug font-semibold">
                    <span class="text-muted">{item.known}</span> {together(item.but)}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">Change it while you're using&nbsp;it.</h2>
      <p class="mx-auto mt-4 max-w-[50rem] text-center text-xl leading-[1.4] font-semibold text-muted">
        {together("Lamp apps are like documents.")}<br />{together("Change them in real time, try things out right on the spot.")}
      </p>
      <!--
        A stand-in until there's a real picture from Lamp: an app's window with the chat that opens beside it, a
        change already made and the next one under way. Beside the window from sm, against its edge: the picture
        has room for the window's shadow around it, so the window runs from 4% to 79% of its height and ends at 81%
        of its width. Under the window on a phone.
      -->
      <div aria-hidden="true" class="relative mx-auto mt-10 max-w-5xl sm:ml-[3%] sm:w-[80%]">
        <Image
          src={habitStreaks}
          alt=""
          widths={[640, 1024, 1600]}
          sizes="(min-width: 1024px) 780px, 100vw"
          loading="lazy"
          class="h-auto w-full"
        />
        <div class="mx-4 -mt-4 flex flex-col gap-3 rounded-[22px] bg-white/70 p-4 text-left text-[15px] leading-snug shadow-[0_20px_50px_-12px_rgba(0,0,0,0.25)] ring-1 ring-black/10 backdrop-blur-xl sm:absolute sm:top-[4%] sm:bottom-[21%] sm:left-[82%] sm:mx-0 sm:mt-0 sm:w-[30%] sm:justify-end">
          <p class="ml-8 self-end rounded-2xl bg-[#cf620c] px-3.5 py-2 text-white">Make no phone after 10pm count double on weekends.</p>
          <p class="mr-6 text-ink">Weekends now count double.</p>
          <p class="ml-8 self-end rounded-2xl bg-[#cf620c] px-3.5 py-2 text-white">And put today's streak in the menu bar.</p>
          <p class="flex items-center gap-2 text-muted"><span class="size-2 animate-pulse rounded-full bg-[#cf620c]"></span>Changing it…</p>
          <div class="mt-2 rounded-full bg-white px-4 py-2.5 text-muted ring-1 ring-black/10">Ask for a change</div>
        </div>
      </div>
      </div>
    </section>

    <!-- Where wishes go once they're made: places in a home, not platforms, so the page widens without turning into
         a list of systems. The Mac stays where Lamp lives and wishes are made. -->
    <section>
      <div class="mx-auto max-w-6xl px-4 pt-20 pb-6 sm:px-6 sm:pt-24">
      <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">Made on your Mac.<br /> At home everywhere&nbsp;else.</h2>
      <p class="mx-auto mt-4 max-w-[50rem] text-center text-xl leading-[1.4] font-semibold text-muted">
        {together("Your phone, your watch, the TV in the living room.")}<br />{together("Each wish lives where it's most useful, and looks like it belongs there.")}
      </p>
      <div class="mt-12"><Places /></div>
      </div>
    </section>

    <FirstIdea heading="So what's yours?" lead="Not sure yet? Answer a couple of questions." class="px-2 pt-16 sm:px-3 sm:pt-20" />

    <section id="features">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <Bento points={points}>
          <div class="overflow-hidden rounded-[28px] bg-panel pt-12 text-center bento:col-span-10 sm:pt-16">
            <h3 class="px-8 font-display text-3xl font-bold tracking-tight sm:text-5xl"><span class="sm:inline-block">No localhost shenanigans.</span> <span class="sm:inline-block">No subscription. Just&nbsp;there.</span></h3>
            <p class="mx-auto mt-4 max-w-[50rem] px-8 text-xl leading-[1.4] text-muted">
              {together("Real, native apps, in the platforms you use.")}
            </p>
            <div aria-hidden="true" class="mt-8 pb-10 sm:mt-10 sm:pb-12">
              <div class="relative left-1/2 flex w-max -translate-x-1/2 gap-4 sm:gap-6">
                {
                  shelf.map((icon) => (
                    <Image
                      src={icon}
                      alt=""
                      width={136}
                      height={136}
                      densities={[1, 2]}
                      class="size-24 drop-shadow-[0_12px_18px_rgba(0,0,0,0.14)] sm:size-34"
                    />
                  ))
                }
              </div>
            </div>
          </div>
      </Bento>
      </div>
    </section>

    <section id="ai" class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">Made with AI&nbsp;inside.</h2>
      <p class="mx-auto mt-4 max-w-[50rem] text-center text-xl leading-[1.4] font-semibold text-muted">
        {together("AI doesn't just make your software.")}<br />{together("It can be part of what it does.")}
      </p>
      <div class="mt-10"><Bento points={smarts} /></div>
      </div>
    </section>

    <section>
      <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Use the AI you already&nbsp;have.</h2>
      <p class="mx-auto mt-4 max-w-[50rem] text-xl leading-[1.4] font-semibold text-muted">
        {together("Lamp is free. It builds with your Claude or ChatGPT subscription, a key from more than a dozen AI providers, or a model that runs right on your Mac.")}
      </p>
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        {
          providers.map((provider) => (
            <li class="flex items-center gap-2.5 text-muted">
              {
                provider.logo ? (
                  <Image src={provider.logo} alt="" width={24} height={24} densities={[1, 2]} class="size-6 opacity-70" />
                ) : (
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current stroke-[1.6] opacity-90">
                    <rect x="6" y="6" width="12" height="12" rx="2.5" />
                    <rect x="9.5" y="9.5" width="5" height="5" rx="1" />
                    <path d="M9 2.5v3.5M12 2.5v3.5M15 2.5v3.5M9 18v3.5M12 18v3.5M15 18v3.5M2.5 9H6M2.5 12H6M2.5 15H6M18 9h3.5M18 12h3.5M18 15h3.5" stroke-linecap="round" />
                  </svg>
                )
              }
              <span class="font-medium">{provider.name}</span>
            </li>
          ))
        }
      </ul>
      </div>
    </section>

    <section class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 py-24 text-center sm:px-6 sm:py-28">
      <Image src={icon} alt="" width={96} height={96} densities={[1, 2]} class="mx-auto size-24 drop-shadow-[0_12px_24px_rgba(217,122,6,0.25)]" />
      <h2 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">Go on, be&nbsp;selfish.</h2>
      <div class="mt-9"><DownloadButton place="footer" /></div>
      </div>
    </section>
  </main>

  <QuickLook />

</Base>

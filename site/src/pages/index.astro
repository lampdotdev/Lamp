---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Carousel from "../components/Carousel.astro";
import DownloadButton from "../components/DownloadButton.astro";
import QuickLook from "../components/QuickLook.astro";
import { together } from "../lib/text";
import UsesYourMac from "../components/visuals/UsesYourMac.astro";
import BeautifulByDefault from "../components/visuals/BeautifulByDefault.astro";
import WorksWithYourMac from "../components/visuals/WorksWithYourMac.astro";
import ChangeItAnyTime from "../components/visuals/ChangeItAnyTime.astro";
import AppleSilicon from "../components/visuals/AppleSilicon.astro";
import ShareWithAnyone from "../components/visuals/ShareWithAnyone.astro";
import icon from "../assets/AppIcon.png";
import anthropic from "../assets/logos/anthropic.png";
import openai from "../assets/logos/openai.png";
import openrouter from "../assets/logos/openrouter.png";
import ollama from "../assets/logos/ollama.png";
import lmstudio from "../assets/logos/lmstudio.png";

// Lamp's window just after building an app, and windows of apps it built, all taken from Lamp Dev with
// made-up data (see RELEASING.md). The iPhone and iPad apps are the simulator's screens in a drawn frame.
import lampWindow from "../assets/lamp.png";
import readingQueue from "../assets/apps/reading-queue.png";
import neonBricks from "../assets/apps/neon-bricks.png";
import habitStreaks from "../assets/apps/habit-streaks.png";
import paletteStudio from "../assets/apps/palette-studio.png";
import trailLog from "../assets/apps/trail-log.png";
import tripTab from "../assets/apps/trip-tab.png";
import mealPlanner from "../assets/apps/meal-planner.png";

const lampWindowLarge = await getImage({ src: lampWindow, width: lampWindow.width, format: "webp" });

const apps = [
  {
    image: readingQueue,
    name: "Reading Queue",
    request: "A reading queue. I drop in PDFs and web links, tell it what I'm working on, and it ranks them by what matters most, with a one-line summary and a reason for each.",
    alt: "Reading Queue: articles ranked against what you're working on, with why each one matters",
  },
  {
    image: trailLog,
    name: "Trail Log",
    request: "Trail Log: a hiking journal. Each hike has its route drawn on a map, the distance, the climb, how long it took and a few notes, and the list shows this year's totals at the top.",
    alt: "Trail Log on two iPhones: this year's hikes with their totals, and Helvellyn's route on a map with its distance, climb and notes",
  },
  {
    image: neonBricks,
    name: "Neon Bricks",
    request: "A brick breaker arcade game with a glowing neon look: a paddle I move with the mouse or arrow keys, colourful bricks, a few levels, power-ups and a high score table.",
    alt: "Neon Bricks: a glowing brick breaker game mid-play",
  },
  {
    image: mealPlanner,
    name: "Meal Planner",
    request: "Meal Planner: the week laid out side by side, each day with breakfast, lunch and dinner cards I can drag between days, and a shopping list on the side built from the week's meals, grouped by aisle, that I can tick off.",
    alt: "Meal Planner on an iPad: a week of family meals and the shopping list for it",
  },
  {
    image: habitStreaks,
    name: "Habit Streaks",
    request: "A habit tracker: a handful of daily habits with streaks, a heat map of the last three months and a chart of each week.",
    alt: "Habit Streaks: daily habits with streaks, a three-month heat map and a weekly chart",
  },
  {
    image: tripTab,
    name: "Trip Tab",
    request: "Trip Tab: splits what a group spends on a trip. I add who paid for what and who it was for, and it shows everyone's balance, who's up and who's behind, and the fewest payments to settle up.",
    alt: "Trip Tab on two iPhones: four friends' balances after a weekend in Lisbon, and the three payments that settle up",
  },
  {
    image: paletteStudio,
    name: "Palette Studio",
    request: "A colour palette studio: describe a mood or drop in a photo and it makes a five-colour palette with names, hex codes and a contrast check for text.",
    alt: "Palette Studio: a five-colour palette called Lisbon Afternoon with names, hex codes and contrast scores",
  },
];

// Icons Lamp made for apps it built, in one row under "Real apps", all the same size. The row is centred
// on the tile and wider than it, so it runs off both edges; at the tile's full width (1104px) the 136px icons
// and 24px gaps put each edge through the middle of an icon. The order mixes the colours, as several are
// purple. A name missing from src/assets/icons/ is skipped.
const icons = import.meta.glob<ImageMetadata>("../assets/icons/*.png", { eager: true, import: "default" });
const shelf = [
  "mine-1", "mine-6", "trip-tab", "mine-3", "mine-8", "habit-streaks", "mine-2", "palette-studio", "trail-log",
  "mine-4", "neon-bricks", "mine-10", "meal-planner", "mine-9", "mine-5", "reading-queue",
].flatMap((name) => icons[`../assets/icons/${name}.png`] ?? []);

// The rest of the features as a bento box on ten columns: rows split 4/6 or 5/5, a few tiles in colour. A tile
// with a `visual` shows that illustration across its top, running off its edges, with the words beneath; with
// `below`, the words come first and the illustration sits at the bottom, for variety.
const points: { title: string; text: string; tile: string; visual?: (props: object) => unknown; below?: boolean }[] = [
  {
    title: "Change it any time",
    text: "Always finding ways to improve? No worries, continue making changes to your apps. Saved versions let you try new things and roll back if it doesn't work out.",
    tile: "bento:col-span-4 bg-panel",
    visual: ChangeItAnyTime,
  },
  {
    title: "Apps that use your Mac",
    text: "An app can use your other apps to get things done, browser included, with whatever you're already signed in to.",
    tile: "bento:col-span-6 bg-night text-white",
    visual: UsesYourMac,
  },
  {
    title: "Works with what's on your Mac",
    text: "Apps can read and add to your calendar, reminders and contacts, find and send mail, and send you notifications. Through your other apps, they can reach Notes, Messages and more.",
    tile: "bento:col-span-5 bg-panel",
    visual: WorksWithYourMac,
    below: true,
  },
  {
    title: "Always gorgeous",
    text: "By default, every app looks and feels made in Cupertino: native controls, proper menus and keyboard shortcuts, and an icon of its own. But make it your own if you want. Never a vibe-coded look.",
    tile: "bento:col-span-5 bg-glow",
    visual: BeautifulByDefault,
  },
  {
    title: "Made for Apple silicon",
    text: "Apps use what's built into your Mac, like reading text in pictures, understanding speech and translating, instantly and privately. Lamp can also run AI models on your Mac's own chip, both to build your apps and inside them.",
    tile: "bento:col-span-4 bg-graphite text-white",
    visual: AppleSilicon,
  },
  {
    title: "Share with anyone",
    text: "Send a Mac app to a friend by AirDrop, Messages or Mail. They get their own copy to make their own, and Lamp shows them what it does before it opens.",
    tile: "bento:col-span-6 bg-panel",
    visual: ShareWithAnyone,
  },
];

// Signed-in subscriptions first, then a key, then the models that run on the Mac itself, in the app's own
// order. Lamp's built-in models (Native Mac AI) run on Metal; they get a chip, like the app's Providers tab,
// since Apple's logo isn't ours to use.
const providers = [
  { logo: anthropic, name: "Claude" },
  { logo: openai, name: "ChatGPT" },
  { logo: openrouter, name: "OpenRouter" },
  { name: "Apple Metal" },
  { logo: ollama, name: "Ollama" },
  { logo: lmstudio, name: "LM Studio" },
];

// On the page the last sentence gets a line of its own; elsewhere (search results, link previews) it's one run.
const pitch = "Describe what you want, and Lamp builds a real app for your Mac, iPhone or iPad, with AI inside when it helps. Keep using it, and change it whenever you like.";
const noCode = "No need to know how to code or deploy anything.";
const description = `${pitch} ${noCode}`;
---

<Base title="Lamp: wish Mac, iPhone and iPad apps into existence" description={description} image="/og.jpg">
  <!--
    Full-width bands that alternate white and light grey, in the manner of Apple's product pages, each with the
    content in the same centred column. Tiles take the other shade from the band they sit on.
  -->
  <main>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <section class="flex flex-col items-center pt-20 pb-10 text-center sm:pt-28">
      <Image
        src={icon}
        alt="Lamp"
        width={176}
        height={176}
        densities={[1, 2]}
        loading="eager"
        class="size-36 drop-shadow-[0_14px_30px_rgba(217,122,6,0.28)] sm:size-44"
      />
      <h1 class="mt-6 font-display text-5xl font-bold tracking-tight sm:text-6xl">Lamp</h1>
      <p class="mt-4 font-display text-3xl leading-tight font-bold tracking-tight sm:text-4xl sm:whitespace-nowrap">
        Wish apps into existence.
      </p>
      <p class="mt-5 max-w-[50rem] text-xl leading-[1.4] font-semibold text-muted">{together(pitch)}<br />{together(noCode)}</p>
      <div class="mt-9"><DownloadButton /></div>
    </section>

    <section class="pb-12">
      <Image
        src={lampWindow}
        alt="Lamp having just built a Reading Queue app: the request, the plan and a picture of the finished app"
        widths={[640, 1024, 1600, 2048]}
        sizes="(min-width: 1152px) 1104px, 100vw"
        loading="eager"
        data-quicklook={lampWindowLarge.src}
        class="mx-auto h-auto w-full"
      />
    </section>

    </div>

    <section class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 pt-20 sm:px-6 sm:pt-24">
        <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">Make a tool for the task that bugs you.</h2>
        <p class="mx-auto mt-4 max-w-[50rem] text-center text-xl leading-[1.4] font-semibold text-muted">
          {together("Or a game for when you're done. Here are a few single-prompt examples:")}
        </p>
        <Carousel slides={apps} />
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
      <div class="grid gap-4 bento:grid-cols-10">
        <div class="overflow-hidden rounded-[28px] bg-panel pt-12 text-center bento:col-span-10 sm:pt-16">
          <h3 class="px-8 font-display text-3xl font-bold tracking-tight sm:text-5xl">Real apps</h3>
          <p class="mx-auto mt-4 max-w-[50rem] px-8 text-xl leading-[1.4] text-muted">
            {together("Each one is an app of its own: on your Mac, in your Applications folder and in Spotlight, or on your own iPhone and iPad. No browser tab, no subscription to someone else's tool. No server or security to worry about.")}
          </p>
          <div aria-hidden="true" class="mt-8 pb-10 sm:mt-10 sm:pb-12">
            <div class="relative left-1/2 flex w-max -translate-x-1/2 gap-4 sm:gap-6">
              {
                shelf.map((icon) => (
                  <Image
                    src={icon}
                    alt=""
                    width={136}
                    height={136}
                    densities={[1, 2]}
                    class="size-24 drop-shadow-[0_12px_18px_rgba(0,0,0,0.14)] sm:size-34"
                  />
                ))
              }
            </div>
          </div>
        </div>
        {
          points.map((point) => (
            <div class:list={["flex min-h-56 flex-col overflow-hidden rounded-[28px]", point.below ? "justify-between" : "justify-end", point.tile]}>
              {point.visual && !point.below && <point.visual />}
              <div class:list={["p-8 sm:p-10", point.below && "pb-2 sm:pb-4"]}>
                <h3 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">{point.title}</h3>
                <p class="mt-3 text-xl leading-[1.4] opacity-75">{together(point.text)}</p>
              </div>
              {point.visual && point.below && <point.visual />}
            </div>
          ))
        }
      </div>
    </section>

    <section class="bg-panel">
      <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6 sm:py-24">
      <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Use the AI you already have.</h2>
      <p class="mx-auto mt-4 max-w-[50rem] text-xl leading-[1.4] font-semibold text-muted">
        {together("Lamp is free. It builds with your Claude or ChatGPT subscription, a key from more than a dozen AI providers, or a model that runs right on your Mac.")}
      </p>
      <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
        {
          providers.map((provider) => (
            <li class="flex items-center gap-2.5 text-muted">
              {
                provider.logo ? (
                  <Image src={provider.logo} alt="" width={24} height={24} densities={[1, 2]} class="size-6 opacity-70" />
                ) : (
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current stroke-[1.6] opacity-90">
                    <rect x="6" y="6" width="12" height="12" rx="2.5" />
                    <rect x="9.5" y="9.5" width="5" height="5" rx="1" />
                    <path d="M9 2.5v3.5M12 2.5v3.5M15 2.5v3.5M9 18v3.5M12 18v3.5M15 18v3.5M2.5 9H6M2.5 12H6M2.5 15H6M18 9h3.5M18 12h3.5M18 15h3.5" stroke-linecap="round" />
                  </svg>
                )
              }
              <span class="font-medium">{provider.name}</span>
            </li>
          ))
        }
      </ul>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-24 text-center sm:px-6 sm:py-28">
      <Image src={icon} alt="" width={96} height={96} densities={[1, 2]} class="mx-auto size-24 drop-shadow-[0_12px_24px_rgba(217,122,6,0.25)]" />
      <h2 class="mt-6 font-display text-4xl font-bold tracking-tight sm:text-5xl">Let your genie out.</h2>
      <div class="mt-9"><DownloadButton /></div>
    </section>
  </main>

  <QuickLook />

  <footer class="bg-panel py-10 text-center text-sm text-muted">
    <p>Made by <a href="https://roocode.com" class="text-ink hover:underline">Roo Code</a> · © {new Date().getFullYear()}</p>
  </footer>
</Base>

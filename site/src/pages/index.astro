---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { together } from "../lib/text";
import { DOWNLOAD_URL } from "../lib/download";
import newYork from "../assets/starters/newyork.png";
import homeHQ from "../assets/starters/homehq.png";
import remote from "../assets/starters/universalremote.png";

// The page sells remixing: start from something someone made, change it while it runs, put it on what's in the
// house, and share it with your name on it. It's dressed as home video: tape labels, the stripes on their sleeves,
// cream paper. Apps and games get the same weight, so it never reads as a site for games only. Every example is a
// real starter (Resources/Starters), with its own pictures and the changes it suggests.
const pitch = "Start from an app or a game someone made. Say what to change and watch it change while it runs. Then put it on your TV.";
const description = `Remixable software. ${pitch} No code.`;

// What Lamp can put something on today, as people name their things. Only what a kind of app or a shipped
// device integration really reaches (Sources/Lamp/Places, Resources/Devices); a device Lamp only reaches in a
// simulator isn't listed. Each gets one of the sleeve's colors, in order.
const devices = [
  "Samsung TVs", "LG TVs", "Roku", "Xbox", "Fire TV & Google TV", "Android phones & tablets", "iPhone & iPad",
  "Photo frames", "Your Mac",
];

// The shelf: three starters, one of each kind, each with the change its starter suggests first.
const shelf = [
  { image: homeHQ, kind: "App · Lamp", name: "Home HQ", tweak: "put it on the photo frame", stripe: "stripe-cool", tone: "text-[#156f64]", ink: "text-[#2a6fb0]" },
  { image: newYork, kind: "Game · Mr.doob", name: "New York", tweak: "move it to the Moon", stripe: "stripe-warm", tone: "text-[#a8361f]", ink: "text-[#b8264f]" },
  { image: remote, kind: "TV & Sonos · Lamp", name: "Universal Remote", tweak: "add a bedtime button", stripe: "stripe-warm", tone: "text-[#a8361f]", ink: "text-[#b8264f]", tall: true },
];
---

<Base title="Lamp: remixable software" description={description} image="/og.jpg">
  <main class="tape-page overflow-x-clip bg-paper text-tape">
    <!-- Hero: plain white type on the sleeve's stripes, run diagonally across the whole window like a film
         maker's box. The pale bands are kept to the corners, so the words only ever sit on ones they read on. -->
    <section id="top" class="technicolor">
    <div class="mx-auto flex max-w-[80rem] flex-wrap items-center gap-16 px-4 pt-32 pb-24 text-white sm:px-6 sm:pt-40 sm:pb-28">
      <div class="flex min-w-0 flex-[1_1_32rem] flex-col items-start gap-7">
        <p class="bg-tape px-2.5 py-1 font-mono text-sm font-bold tracking-wider text-paper">NO CODE · T‑120 · SIDE B</p>
        <h1 class="mb-2 text-[clamp(3.25rem,8.4vw,8rem)] leading-[0.9] font-black tracking-[-0.05em]">Remixable software.</h1>
        <p class="max-w-[30ch] text-2xl leading-[1.4] font-semibold">{together(pitch)}</p>
        <div class="flex flex-wrap gap-3.5">
          <a href={DOWNLOAD_URL} data-download-place="hero" class="tape-button tape-button-paper">Download for Mac</a>
          <a href="#shelf" class="tape-button tape-button-outline-white">See what's on the shelf</a>
        </div>
      </div>

      <!-- New York's sleeve: who made it, the game itself, and the sleeve's stripes with the tape's window cut in. -->
      <div class="flex min-w-0 flex-[1_1_26rem] justify-center">
        <figure class="flex w-full max-w-[32.5rem] -rotate-2 flex-col overflow-hidden border-2 border-tape bg-[#f7f2e3] text-tape shadow-[10px_10px_0_var(--color-tape)]">
          <figcaption class="flex items-start justify-between gap-4 px-7 pt-6 pb-4">
            <span class="flex flex-col gap-1">
              <span class="text-[1.375rem] font-extrabold italic">Made by Mr.doob</span>
              <span class="text-[clamp(2.75rem,6vw,4rem)] leading-[0.9] font-black tracking-[-0.04em]">New York</span>
            </span>
            <span class="text-right font-mono text-[13px] leading-snug font-bold text-[#a8361f]">GAME<br />3D</span>
          </figcaption>
          <Image src={newYork} alt="New York: a yellow taxi on a Manhattan avenue at golden hour" widths={[520, 1040]} sizes="(min-width: 640px) 520px, 100vw" loading="eager" class="block h-auto w-full border-y-2 border-tape" />
          <div class="stripe-warm relative h-[7.5rem]" aria-hidden="true">
            <span class="absolute -top-5 -right-0.5 h-40 w-[9.5rem] bg-tape [clip-path:polygon(100%_0,100%_100%,0_50%)]"></span>
          </div>
          <div class="flex flex-wrap items-baseline justify-between gap-3 px-7 pt-4 pb-5">
            <span class="text-xl font-extrabold italic">Walk, drive, bike or fly</span>
            <span class="-rotate-3 font-marker text-[1.375rem] text-[#b8264f]">remix me!</span>
          </div>
        </figure>
      </div>
    </div>
    </section>

    <!-- Side B: a stack of tapes running off the left edge. The originals have printed sleeves; the remixes are
         written on in marker, and the last is blank. -->
    <section id="remix" class="mx-auto flex max-w-[80rem] flex-wrap items-center gap-14 px-4 py-24 sm:px-6">
      <div class="order-last flex min-w-0 flex-[1_1_37.5rem] flex-col gap-2 [margin-left:calc(-1*var(--edge))] lg:order-none">
        <div class="flex min-h-21 items-stretch border-2 border-l-0 border-tape bg-[#f7f2e3]">
          <span class="stripe-warm-across w-[calc(var(--edge)+30%)] min-w-24" aria-hidden="true"></span>
          <span class="flex flex-1 flex-col justify-center px-5 py-3">
            <span class="text-[2.125rem] leading-none font-black tracking-[-0.03em]">Home HQ</span>
            <span class="text-[13px] font-bold tracking-[0.15em]">THE ORIGINAL · AN APP FOR THE FAMILY</span>
          </span>
        </div>
        <div class="spine">
          <span class="spine-code" aria-hidden="true">T‑120</span>
          <span class="spine-label">
            <span class="font-marker text-[1.375rem] sm:text-[1.875rem] leading-tight text-[#b8264f]">On the kitchen frame</span>
            <span class="text-[13px] font-bold tracking-wider">REMIXED BY YOU</span>
          </span>
          <span class="spine-side">B1</span>
        </div>
        <div class="spine gap-5 text-paper">
          <span class="stripe-cool h-12 w-[6.875rem] shrink-0" aria-hidden="true"></span>
          <span class="flex flex-1 flex-col">
            <span class="text-[1.75rem] leading-none font-black tracking-[0.02em] uppercase">New York</span>
            <span class="text-xs font-bold tracking-[0.15em] text-[#cfc8b2]">THE ORIGINAL · A GAME BY MR.DOOB</span>
          </span>
          <span class="spine-side">A1</span>
        </div>
        <div class="spine">
          <span class="spine-code" aria-hidden="true">E‑180</span>
          <span class="spine-label">
            <span class="font-marker text-[1.375rem] sm:text-[1.875rem] leading-tight text-[#2a6fb0]">Snowy winter night</span>
            <span class="text-[13px] font-bold tracking-wider">REMIXED BY YOUR FRIEND</span>
          </span>
          <span class="spine-side">B2</span>
        </div>
        <div class="spine">
          <span class="spine-code" aria-hidden="true">T‑120</span>
          <span class="spine-label spine-lined">
            <span class="font-marker text-[1.375rem] sm:text-[1.875rem] leading-tight text-[#6f6857]">your idea here…</span>
            <span class="text-[13px]" aria-hidden="true">&nbsp;</span>
          </span>
          <span class="rounded-[3px] bg-[#c23a20] px-2.5 py-1.5 text-[15px] font-black text-paper">● REC</span>
        </div>
      </div>
      <div class="flex min-w-0 flex-[1_1_22.5rem] flex-col gap-5">
        <h2 class="chip-heading text-[clamp(3rem,6vw,5.5rem)] leading-[0.92] font-black tracking-[-0.04em]">Record over it. Keep the original.</h2>
        <p class="max-w-[36ch] text-xl leading-normal">{together("Everything opens running. Ask for a change in the chat beside it, and it changes in front of you. The first version stays on the shelf.")}</p>
      </div>
    </section>

    <div class="rule" aria-hidden="true"></div>

    <!-- What it runs on, like the back of a box. -->
    <section id="devices" class="mx-auto flex max-w-[80rem] flex-col gap-8 px-4 py-26 sm:px-6">
      <div class="flex flex-col gap-2">
        <p class="font-mono text-sm font-bold tracking-wider text-[#a8361f]">COMPATIBLE WITH</p>
        <h2 class="chip-heading max-w-[16ch] text-[clamp(3rem,6vw,5.5rem)] leading-[0.92] font-black tracking-[-0.04em]">Runs on what's already in the house.</h2>
      </div>
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(15rem,1fr))] gap-x-8 border-t-2 border-tape">
        {
          devices.map((device, i) => (
            <li class="flex items-center gap-3.5 border-b border-tape py-3.5 text-[1.375rem] font-extrabold">
              <span class="h-6.5 w-2.5 shrink-0" style={`background: var(--stripe-${i})`} aria-hidden="true"></span>
              {device}
            </li>
          ))
        }
        <li class="flex items-center gap-3.5 border-b border-tape py-3.5 text-xl font-bold italic">
          <span class="box-border h-6.5 w-2.5 shrink-0 border-2 border-tape" aria-hidden="true"></span>
          and it works the Sonos
        </li>
      </ul>
      <p class="mt-2 max-w-[52ch] text-xl leading-normal">{together("Developer mode on the TV, the maker's sign-in and certificates, finding the box on your Wi‑Fi: Lamp walks you through the part where people usually give up.")}</p>
    </section>

    <div class="rule" aria-hidden="true"></div>

    <!-- On the shelf: real starters, each with the change it suggests. -->
    <section id="shelf" class="mx-auto flex max-w-[80rem] flex-col gap-10 px-4 py-24 sm:px-6">
      <h2 class="chip-heading text-[clamp(3rem,6vw,5.5rem)] leading-[0.92] font-black tracking-[-0.04em]">On the shelf</h2>
      <ul class="grid grid-cols-[repeat(auto-fit,minmax(18.75rem,1fr))] gap-9">
        {
          shelf.map((item) => (
            <li class="flex flex-col gap-1.5">
              {item.tall ? (
                <div class="flex aspect-[16/10] justify-center overflow-hidden bg-tape">
                  <Image src={item.image} alt="" widths={[300, 600]} sizes="300px" class="mt-3.5 h-[130%] w-auto" />
                </div>
              ) : (
                <Image src={item.image} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 400px, 100vw" class="aspect-[16/10] w-full object-cover" />
              )}
              <span class:list={[item.stripe, "mb-3 h-3"]} aria-hidden="true"></span>
              <span class:list={["font-mono text-xs font-bold uppercase", item.tone]}>{item.kind}</span>
              <h3 class="text-3xl leading-none font-black tracking-[-0.03em]">{item.name}</h3>
              <span class:list={["font-marker text-xl", item.ink]}>{item.tweak}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="rule" aria-hidden="true"></div>

    <!-- Sharing keeps the names of everyone who made a thing: what makes it worth sharing for people with an
         audience. -->
    <section id="sharing" class="mx-auto flex max-w-[80rem] flex-col items-center gap-7 px-4 py-26 text-center sm:px-6">
      <h2 class="chip-heading text-[clamp(3rem,6vw,5.5rem)] leading-[0.92] font-black tracking-[-0.04em]">Share it. Your name stays on it.</h2>
      <p class="max-w-[44ch] text-xl leading-normal">{together("Share a link to your version. Whoever remixes it next starts from yours, and it still says who made it.")}</p>
      <dl class="mt-3 flex flex-col gap-1.5">
        <dt class="credit">MADE BY</dt>
        <dd class="text-3xl font-black tracking-[-0.02em]">Mr.doob</dd>
        <dt class="credit mt-3.5">SNOWY WINTER NIGHT</dt>
        <dd class="text-3xl font-black tracking-[-0.02em]">your friend</dd>
        <dt class="credit mt-3.5">TAXI FARES</dt>
        <dd class="text-3xl font-black tracking-[-0.02em]">you</dd>
      </dl>
    </section>

    <!-- The lamp's light falls across the last section, in the sleeve's stripes. -->
    <section id="download" class="relative overflow-hidden bg-tape text-paper">
      <span class="beam absolute top-0 right-0 h-full w-[46%] opacity-95 [clip-path:polygon(62%_0,82%_0,100%_100%,20%_100%)]" aria-hidden="true"></span>
      <div class="relative mx-auto flex max-w-[80rem] flex-col items-start gap-6 px-4 py-28 sm:px-6">
        <h2 class="max-w-[11ch] text-[clamp(3rem,6vw,5.5rem)] leading-[0.92] font-black tracking-[-0.04em]">Lamp runs on your Mac.</h2>
        <p class="max-w-[30ch] text-[1.375rem] text-[#e6dfca]">What you make runs on everything else. Free.</p>
        <a href={DOWNLOAD_URL} data-download-place="footer" class="tape-button tape-button-lit">Download for Mac</a>
        <p class="text-sm text-[#cfc8b2]">{together("For Macs with Apple Silicon and macOS 14 Sonoma or later")}</p>
      </div>
    </section>
  </main>
</Base>

<style>
  /* The sleeve's colors, warm to cool, and the bands they're printed in. */
  .tape-page {
    --stripe-0: #f6b81c; --stripe-1: #f08a1c; --stripe-2: #e2402a; --stripe-3: #d23778; --stripe-4: #5a2d8c;
    --stripe-5: #2c3592; --stripe-6: #1f6fc4; --stripe-7: #1f8a4a; --stripe-8: var(--color-tape);
    /* How far it is from the content's edge to the window's, so the tapes can run off the page. */
    --edge: calc(max(0px, (100vw - 80rem) / 2) + 1rem);
    background-image: radial-gradient(rgb(60 40 10 / 0.07) 1px, transparent 1.4px), radial-gradient(rgb(60 40 10 / 0.05) 1px, transparent 1.4px);
    background-size: 5px 5px, 9px 9px;
    background-position: 0 0, 3px 4px;
  }
  @media (width >= 40rem) {
    .tape-page { --edge: calc(max(0px, (100vw - 80rem) / 2) + 1.5rem); }
  }
  .stripe-warm { background: linear-gradient(180deg, var(--stripe-0) 0 20%, var(--stripe-1) 0 40%, var(--stripe-2) 0 60%, var(--stripe-3) 0 80%, var(--stripe-4) 0); }
  .stripe-warm-across { background: linear-gradient(90deg, var(--stripe-0) 0 20%, var(--stripe-1) 0 40%, var(--stripe-2) 0 60%, var(--stripe-3) 0 80%, var(--stripe-4) 0); }
  .stripe-cool { background: linear-gradient(180deg, var(--stripe-7) 0 33.3%, var(--stripe-6) 0 66.6%, var(--stripe-2) 0); }
  .beam { background: linear-gradient(90deg, var(--stripe-6) 0 16.6%, var(--stripe-7) 0 33.3%, var(--stripe-0) 0 50%, var(--stripe-1) 0 66.6%, var(--stripe-2) 0 83.3%, var(--stripe-3) 0); }
  /* Between sections, the stripes run the full width of the window. */
  .rule { height: 30px; background: linear-gradient(180deg, var(--stripe-7) 0 16.6%, var(--stripe-6) 0 33.3%, var(--stripe-0) 0 50%, var(--stripe-1) 0 66.6%, var(--stripe-2) 0 83.3%, var(--stripe-3) 0); }

  /* The hero's field: the stripes on the slant, from the yellow corner at the top left to the lime at the bottom
     right. Yellow, orange and lime fail white words, so they stay in the corners (a phone's hero is tall, so its
     slant reaches the words sooner and the corners are smaller); every band in between holds them at 3:1 or more,
     the words over them all being large. */
  .technicolor {
    --corner: 5%; --corner-edge: 11%;
    background: linear-gradient(150deg,
      var(--stripe-0) 0 var(--corner), var(--stripe-1) 0 var(--corner-edge), var(--stripe-2) 0 24%, var(--stripe-3) 0 35%,
      var(--stripe-4) 0 47%, var(--stripe-5) 0 59%, var(--stripe-6) 0 70%, #1e8fd6 0 80%, var(--stripe-7) 0 91%, #7cbf3a 0);
  }
  @media (width < 40rem) {
    .technicolor { --corner: 2%; --corner-edge: 5%; }
  }

  /* Headings keep plain ink; the stripes sit above them, as a tab cut from the sleeve. */
  .chip-heading::before {
    content: ""; display: block; width: 5.5rem; height: 1.25rem; margin-bottom: 1.5rem;
    background: linear-gradient(150deg, var(--stripe-0) 0 12%, var(--stripe-1) 0 24%, var(--stripe-2) 0 36%, var(--stripe-3) 0 48%,
      var(--stripe-4) 0 60%, var(--stripe-5) 0 72%, var(--stripe-6) 0 84%, var(--stripe-7) 0);
  }
  #sharing .chip-heading::before { margin-inline: auto; }

  .tape-button {
    display: inline-flex; align-items: center; min-height: 3.25rem; padding: 0 1.625rem; border-radius: 6px;
    background: var(--color-tape); color: var(--color-paper); font-size: 1.125rem; font-weight: 800;
    transition: translate 0.2s ease;
  }
  .tape-button:hover { translate: 0 -2px; }
  .tape-button:focus-visible { outline: 3px solid var(--stripe-6); outline-offset: 3px; }
  .tape-button-paper { background: var(--color-paper); color: var(--color-tape); }
  .tape-button-outline-white { background: transparent; color: #fff; box-shadow: inset 0 0 0 2px #fff; }
  /* On the dark last section, in the yellow of the lamp's light. */
  .tape-button-lit { background: var(--stripe-0); color: var(--color-tape); }

  .spine {
    display: flex; align-items: center; gap: 1rem; min-height: 5.25rem;
    padding: 0.5rem 1.125rem 0.5rem calc(var(--edge) + 1.125rem); background: #26241f;
  }
  .spine-code { writing-mode: vertical-rl; rotate: 180deg; font-family: var(--font-mono); font-size: 11px; color: #a39c88; }
  .spine-label {
    flex: 1; display: flex; flex-direction: column; align-items: center; padding: 0.5rem 1.125rem;
    background: #f7f2e3; color: var(--color-tape); border-radius: 2px; text-align: center;
  }
  .spine-lined { background-image: repeating-linear-gradient(180deg, transparent 0 22px, rgb(42 111 176 / 0.35) 22px 23px); }
  .spine-side { font-family: var(--font-mono); font-weight: 700; font-size: 1.125rem; color: var(--color-paper); border: 1.5px solid #a39c88; padding: 2px 6px; }
  .credit { font-family: var(--font-mono); font-weight: 700; font-size: 13px; letter-spacing: 0.15em; color: #a8361f; }
</style>

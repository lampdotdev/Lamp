---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import FirstIdea from "../components/FirstIdea.astro";
import WishDialog from "../components/WishDialog.astro";
import { CATEGORIES, IDEAS, platform, slug } from "../lib/ideas";
import { together } from "../lib/text";
import { platformIcon } from "../lib/platform-icons";

// Each idea's icon, on Lamp's own tile as Lamp makes them, and a picture of it in use, both drawn by an image
// model from a short brief (see scripts/idea-art/README.md). An idea without one shows without it.
const icons = import.meta.glob<ImageMetadata>("../assets/ideas/icons/*.png", { eager: true, import: "default" });
const thumbs = import.meta.glob<ImageMetadata>("../assets/ideas/thumbs/*.jpg", { eager: true, import: "default" });
const iconOf = (name: string) => icons[`../assets/ideas/icons/${slug(name)}.png`];
const thumbOf = (name: string) => thumbs[`../assets/ideas/thumbs/${slug(name)}.jpg`];
// The larger picture for an opened wish.
const large = Object.fromEntries(await Promise.all(IDEAS.map(async (idea) => {
  const thumb = thumbOf(idea.name);
  return [idea.name, thumb ? (await getImage({ src: thumb, width: 1200, format: "webp" })).src : ""];
})));
const iconURL = Object.fromEntries(await Promise.all(IDEAS.map(async (idea) => {
  const icon = iconOf(idea.name);
  return [idea.name, icon ? (await getImage({ src: icon, width: 128, format: "webp" })).src : ""];
})));

// In the categories' order, so "All" reads as the categories one after another.
const ideas = CATEGORIES.flatMap((category) => IDEAS.filter((idea) => idea.category === category.id));
const description = "Software nobody else would make: for the office, your Mac, your family and your weekends. Find one that's nearly yours, and Lamp makes it yours.";
---

<Base title="Ideas · Lamp" description={description} image="/og.jpg">
  <main>
    <section class="mx-auto max-w-6xl px-4 pt-[calc(var(--menu-height)+3rem)] sm:px-6">
      <h1 class="text-[clamp(2.25rem,5vw,3.25rem)] leading-[1] font-black tracking-[-0.04em]">Ideas</h1>
      <p class="mt-4 max-w-[40rem] text-lg">{together("Things people have wished for, from the office to the weekend. Open one to see what it does, and Lamp makes it for you.")}</p>
    </section>

    <!-- The categories as plain tabs, the one chosen underlined. The one chosen is kept in the address (#office), so a
         link can open on it. -->
    <nav aria-label="Kinds of idea" class="mx-auto mt-8 max-w-6xl px-4 pb-8 sm:px-6">
      <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm">
        {
          [{ id: "", title: "All" }, ...CATEGORIES].map((category) => (
            <button
              type="button"
              data-filter={category.id}
              aria-pressed={category.id === "" ? "true" : "false"}
              class="cursor-pointer py-1 text-muted underline-offset-[6px] hover:text-ink aria-pressed:text-ink aria-pressed:underline focus-visible:outline-2 focus-visible:outline-ink"
            >
              {category.title}
            </button>
          ))
        }
      </div>
    </nav>

    <section class="border-t border-tape/20">
      <div class="mx-auto max-w-6xl px-4 pt-8 pb-20 sm:px-6 sm:pb-24">
        <ul data-ideas class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            ideas.map((idea) => (
              <li data-category={idea.category} class="flex">
                <button
                  type="button"
                  data-idea={JSON.stringify({ ...idea, platform: platform(idea), picture: large[idea.name], icon: iconURL[idea.name] })}
                  class="group flex w-full cursor-pointer flex-col overflow-hidden rounded-[8px] bg-page text-left ring-1 ring-tape/15 transition hover:ring-tape/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
                >
                  {thumbOf(idea.name) ? (
                    <Image
                      src={thumbOf(idea.name)}
                      alt=""
                      widths={[400, 700, 1000]}
                      sizes="(min-width: 1152px) 352px, (min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw"
                      loading="lazy"
                      class="aspect-[3/2] w-full object-cover"
                    />
                  ) : (
                    <span aria-hidden="true" class="aspect-[3/2] w-full bg-panel" />
                  )}
                  <span class="flex flex-1 flex-col items-start border-t border-tape/10 px-5 pt-4 pb-5">
                    <span class="flex w-full items-baseline justify-between gap-3">
                      <span class="text-xl font-extrabold tracking-[-0.01em]">{idea.name}</span>
                      <span class="shrink-0 text-muted" set:html={platformIcon(platform(idea))} />
                    </span>
                    <span class="mt-1 text-[15px] leading-snug text-muted">{together(idea.about)}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>

        <!-- For whoever found nothing quite theirs: a few questions, so nobody has to leave. -->
        <FirstIdea
          heading="Not quite yours?"
          lead="Answer a couple of questions and you'll see it in a minute."
          explore={false}
          class="pt-16 sm:pt-20"
        />
      </div>
    </section>
  </main>

  <WishDialog place="ideas" />
</Base>

<script>
  import { track } from "../lib/analytics";

  // ---------- The filters, and the wishes coming and going ----------
  const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const items = [...document.querySelectorAll<HTMLElement>("[data-ideas] > li")];
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ease = "cubic-bezier(.22,.8,.2,1)";

  // A wish appearing, fading and growing into place: the first time it scrolls into view, and when a filter
  // brings it back. Until then
  // it's see-through (global.css), and it's marked as shown so it stays put afterwards.
  const rise = (item: HTMLElement, delay: number) => {
    item.dataset.shown = "";
    reveal.unobserve(item);
    if (still) return;
    item.animate(
      [{ opacity: 0, transform: "scale(0.96)" }, { opacity: 1, transform: "none" }],
      { duration: 500, delay, easing: ease, fill: "backwards" },
    );
  };
  const reveal = new IntersectionObserver((entries) => {
    entries.filter((entry) => entry.isIntersecting).forEach((entry, index) => {
      reveal.unobserve(entry.target);
      rise(entry.target as HTMLElement, index * 70);
    });
  }, { rootMargin: "0px 0px -40px 0px" });

  const select = (id: string) => {
    filters.forEach((filter) => filter.setAttribute("aria-pressed", String(filter.dataset.filter === id)));
  };
  const belongs = (item: HTMLElement, id: string) => !id || item.dataset.category === id;

  // A change of filter: the wishes that go fade and shrink away, then those that stay glide to their new places
  // while the ones that come appear, a moment apart. A second change before the first is done takes over from
  // wherever it got to.
  let change = 0;
  const show = async (id: string) => {
    const mine = ++change;
    select(id);
    items.forEach((item) => item.getAnimations().forEach((animation) => animation.cancel()));
    const leaving = items.filter((item) => !item.hidden && !belongs(item, id));
    const coming = items.filter((item) => item.hidden && belongs(item, id));
    if (still) {
      items.forEach((item) => { item.hidden = !belongs(item, id); item.dataset.shown = ""; });
      return;
    }
    if (leaving.length) {
      await Promise.all(leaving.map((item) => item.animate(
        [{ opacity: 1, transform: "none" }, { opacity: 0, transform: "scale(0.96)" }],
        { duration: 220, easing: "ease-in", fill: "forwards" },
      ).finished.catch(() => {})));
      if (mine !== change) return;
    }
    const staying = items.filter((item) => !item.hidden && belongs(item, id));
    const before = new Map(staying.map((item) => [item, item.getBoundingClientRect()]));
    items.forEach((item) => (item.hidden = !belongs(item, id)));
    leaving.forEach((item) => item.getAnimations().forEach((animation) => animation.cancel()));
    staying.forEach((item) => {
      const from = before.get(item)!, to = item.getBoundingClientRect();
      const dx = from.left - to.left, dy = from.top - to.top;
      if (dx || dy) item.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "none" }], { duration: 500, easing: ease });
    });
    // Only those in or near the window are worth waiting for; the rest appear when scrolled to, as the first time.
    let shown = 0;
    coming.forEach((item) => {
      const box = item.getBoundingClientRect();
      if (box.top < innerHeight + 200) rise(item, 30 + Math.min(shown++, 8) * 60);
      else { delete item.dataset.shown; reveal.observe(item); }
    });
  };

  filters.forEach((filter) =>
    filter.addEventListener("click", () => {
      const id = filter.dataset.filter ?? "";
      if (filter.getAttribute("aria-pressed") === "true") return;
      // The row of categories goes to just under the menu bar, so it's clear what changed and the wishes have
      // the rest of the window.
      const row = document.querySelector<HTMLElement>('[aria-label="Kinds of idea"]')!;
      const bar = document.querySelector<HTMLElement>("header nav")!.getBoundingClientRect().bottom;
      scrollTo({ top: row.getBoundingClientRect().top + scrollY - bar - 12, behavior: still ? "auto" : "smooth" });
      show(id);
      history.replaceState(null, "", id ? `#${id}` : location.pathname);
      if (id) track("ideas_filtered", { category: id });
    }),
  );

  // As the page opens: the filter in the address, if any, then each wish appears as it comes into view.
  const opening = location.hash.slice(1);
  const first = filters.some((filter) => filter.dataset.filter === opening) ? opening : "";
  select(first);
  items.forEach((item) => (item.hidden = !belongs(item, first)));
  if (still) items.forEach((item) => (item.dataset.shown = ""));
  else items.forEach((item) => reveal.observe(item));

</script>

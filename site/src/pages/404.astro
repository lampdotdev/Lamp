---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import icon from "../assets/AppIcon.png";
---

<Base title="Not found · Lamp" description="This page isn't here.">
  <main class="flex min-h-dvh flex-col items-center justify-center px-4 text-center">
    <Image src={icon} alt="" width={96} height={96} densities={[1, 2]} class="size-24 opacity-90" />
    <h1 class="mt-6 font-display text-4xl font-bold tracking-tight">Poof! It's a 404.</h1>
    <p class="mt-3 text-lg text-muted">This page isn't here.</p>
    <a href="/" class="mt-8 font-medium text-ink underline decoration-black/20 underline-offset-4 hover:decoration-black/60">Go to Lamp</a>
  </main>
</Base>

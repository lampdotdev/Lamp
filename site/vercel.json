{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "cleanUrls": true,
  "functions": {
    "api/bug-report.js": { "maxDuration": 15 },
    "api/first-idea.js": { "maxDuration": 30 },
    "api/idea-event.js": { "maxDuration": 5 },
    "api/wishes.js": { "maxDuration": 15 },
    "api/wish-page.js": { "maxDuration": 10 },
    "api/wish-card.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/w/:id/card.png", "destination": "/api/wish-card?id=:id" },
    { "source": "/w/:id", "destination": "/api/wish-page?id=:id" }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}

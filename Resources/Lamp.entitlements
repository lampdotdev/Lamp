<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Forge (Developer ID releases).
  Not sandboxed: Forge builds apps with the user's Swift toolchain, runs the bundled agent and model
  servers, and installs apps into ~/Applications, which the App Sandbox would block.
-->
<plist version="1.0">
<dict>
  <!-- Dictation (macOS still asks the user first) -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Listing and switching browser tabs for apps that read web pages (macOS asks the user first) -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
